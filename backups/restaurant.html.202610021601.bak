const ls = {
  get(k, d){ try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
};
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num = n => Number(n || 0);
const money = n => 'Rs ' + Math.round(num(n)).toLocaleString('en-PK');
const when = ts => new Date(ts).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
const hhmm = v => v ? String(v).slice(0, 5) : '';
function pkNow(){ try { return new Intl.DateTimeFormat('en-GB', { timeZone:'Asia/Karachi', hour:'2-digit', minute:'2-digit', hour12:false }).format(new Date()).replace(/^24/, '00'); } catch (e) { return new Date().toTimeString().slice(0, 5); } }
function withinHours(r){ const o = hhmm(r.open_time), c = hhmm(r.close_time), n = pkNow(); if (!o || !c || o === c) return true; return o < c ? (n >= o && n < c) : (n >= o || n < c); }
function time12(v){ const x = hhmm(v); if (!x) return ''; const [h, m] = x.split(':').map(Number); return ((h % 12) || 12) + ':' + String(m).padStart(2, '0') + ' ' + (h < 12 ? 'AM' : 'PM'); }
function hoursText(r){ return t('outside_hours').replace(/\{o\}/g, time12(r.open_time)).replace(/\{c\}/g, time12(r.close_time)); }
function timeAgo(ts){
  const m = Math.round((Date.now() - new Date(ts).getTime()) / 60000);
  if (m < 1) return '0 min'; if (m < 60) return m + ' min';
  const h = Math.round(m / 60); return h < 24 ? h + ' h' : new Date(ts).toLocaleDateString('en-GB', { day:'numeric', month:'short' });
}
function logErr(e){ try { console.error(e && e.message ? e.message : JSON.stringify(e)); } catch (x) { console.error('error'); } }
function range(p){
  const now = new Date(); const s = new Date(now); s.setHours(0, 0, 0, 0);
  if (p === '7d'){ const f = new Date(s); f.setDate(f.getDate() - 6); return f; }
  if (p === 'month') return new Date(now.getFullYear(), now.getMonth(), 1);
  if (p === '30d'){ const f = new Date(s); f.setDate(f.getDate() - 29); return f; }
  return s;
}

