const state = {
  lang: ls.get('kh_lang', 'en'), user:null, restaurant:null, orders:[], issues:{}, seenIssues:new Set(), acceptedAt:{}, cats:[], items:[], tab:'orders',
  sound: ls.get('kh_r_sound', true), authMode:'login', prep:20, period:'today', earn:null, productFilter:'all', productQ:'', alerted:new Set()
};
const t = (k, v) => { let x = (I18N[state.lang] && I18N[state.lang][k]) || I18N.en[k] || k; if (v) for (const n in v) x = x.split('{' + n + '}').join(v[n]); return x; };
function applyLang(){ document.documentElement.lang = state.lang; document.documentElement.dir = state.lang === 'ur' ? 'rtl' : 'ltr'; }
function toast(msg, isErr){
  const el = document.createElement('div'); el.className = 'toast' + (isErr ? ' err' : ''); el.textContent = msg;
  document.body.appendChild(el); setTimeout(() => el.remove(), 3400);
}
async function run(fn){ try { return await fn(); } catch (e) { logErr(e); toast((e && e.message) || t('error'), true); } }
function need(res){ if (res.error) throw res.error; return res.data; }

// ---- Bottom sheet ----
function openSheet(title, html, cls){
  closeSheet();
  const back = document.createElement('div'); back.className = 'sheet-back'; back.id = 'sheet';
  back.innerHTML = `<div class="sheet ${cls || ''}" role="dialog" aria-modal="true"><div class="sheet-head"><h3>${esc(title)}</h3><button class="x" aria-label="Close" onclick="closeSheet()">&times;</button></div>${html}</div>`;
  back.addEventListener('click', e => { if (e.target === back) closeSheet(); });
  document.body.appendChild(back);
}
function closeSheet(){ const s = $('sheet'); if (s) s.remove(); }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSheet(); });

// ---- Alert sound, vibration, screen wake ----
let actx = null;
function unlockAudio(){ try { if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)(); if (actx.state === 'suspended') actx.resume(); } catch (e) {} }
document.addEventListener('pointerdown', unlockAudio);
const audioReady = () => !!actx && actx.state === 'running';
function beep(){
  if (state.sound && audioReady()){
    try {
      const o = actx.createOscillator(), g = actx.createGain();
      o.type = 'square'; o.frequency.value = 880; g.gain.value = 0.18; o.connect(g); g.connect(actx.destination); o.start();
      setTimeout(() => { o.frequency.value = 1175; }, 160); setTimeout(() => { o.frequency.value = 880; }, 320); setTimeout(() => o.stop(), 520);
    } catch (e) {}
  }
  try { if (navigator.vibrate) navigator.vibrate([300, 120, 300]); } catch (e) {}
}
const newOrders = () => state.orders.filter(o => o.status === 'placed');
let alertTimer = null;
function startAlertLoop(){ if (!alertTimer) alertTimer = setInterval(() => { if (newOrders().length) beep(); }, 4000); }
let wakeLock = null;
async function keepAwake(){ try { if ('wakeLock' in navigator && !wakeLock){ wakeLock = await navigator.wakeLock.request('screen'); wakeLock.addEventListener('release', () => { wakeLock = null; }); } } catch (e) {} }
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && state.restaurant){ keepAwake(); refreshOrders(); } });
function updateTitle(){ const n = newOrders().length; document.title = n ? `(${n}) ${t('new_order')} Wanhar Mart` : 'Wanhar Mart Shop'; }

// ================= AUTH =================
function showAuth(msg, ok){
  const signup = state.authMode === 'signup';
  $('app').innerHTML = `
  <div class="auth">
    <div style="display:flex;justify-content:flex-end"><button class="pillbtn" onclick="A.toggleLang(true)">${state.lang === 'ur' ? 'English' : 'اردو'}</button></div>
    <div class="brand">Wanhar Mart<b>.</b></div>
    <p class="muted" style="margin:0 0 6px">Shop</p>
    <h1 style="font-size:22px">${signup ? t('signup') : t('login')}</h1>
    <form onsubmit="A.submitAuth(event)">
      ${signup ? `<label class="f" for="a_name">${t('name')}</label><input id="a_name" type="text" autocomplete="name">
      <label class="f" for="a_phone">${t('phone')}</label><input id="a_phone" type="tel" inputmode="tel" autocomplete="tel">` : ''}
      <label class="f" for="a_email">${t('email')}</label><input id="a_email" type="email" autocomplete="username" autocapitalize="off">
      <label class="f" for="a_pw">${t('password')}</label><input id="a_pw" type="password" autocomplete="${signup ? 'new-password' : 'current-password'}">
      <div style="margin-top:20px"><button class="btn" id="authBtn" type="submit">${signup ? t('signup') : t('login')}</button></div>
      <div class="err-text" id="authMsg" style="${ok ? 'color:var(--green)' : ''}">${esc(msg || '')}</div>
    </form>
    ${signup ? Legal.agree(state.lang) : ''}
    ${signup ? '' : `<button class="link" onclick="A.forgotPw()">${t('forgot_pw')}</button><br>`}
    <button class="link" onclick="A.switchAuth()">${signup ? t('have_account') : t('no_account')}</button>
    <div class="ver">v${APP_VERSION}</div>
  </div>`;
}
function showUnlinked(){
  $('app').innerHTML = `<div class="auth">
    <div class="brand">Wanhar Mart<b>.</b></div>
    <h1 style="font-size:22px;margin-top:14px">${t('not_linked')}</h1>
    <p class="muted">${t('not_linked_msg')}</p>
    <div class="card" style="font-weight:800;word-break:break-all">${esc(state.user.email)}</div>
    <div class="actions"><button class="btn" onclick="A.recheck()">${t('check_again')}</button>
    <button class="btn ghost" onclick="A.logout()">${t('logout')}</button></div>
    <div class="ver" style="margin-top:12px">v${APP_VERSION}</div></div>`;
}

// ================= SHELL =================
function renderShell(){
  const r = state.restaurant;
  $('app').innerHTML = `
    <header class="top">
      <div class="brand">${esc(r.name)}<small>Wanhar Mart Shop</small></div>
      <div style="display:flex;gap:8px;align-items:center">${Chat.button()}<button class="openbtn ${r.is_open ? 'on' : ''}" id="openBtn" onclick="A.toggleOpen(${!r.is_open})"><i></i>${r.is_open ? t('open_now') : t('closed_now')}</button></div>
    </header>
    <main id="view"></main>
    <nav class="nav"><div class="nav-in">
      <button id="t_orders" onclick="go('orders')">${t('orders')}</button>
      <button id="t_menu" onclick="go('menu')">${t('products')}</button>
      <button id="t_earn" onclick="go('earn')">${t('earnings')}</button>
      <button id="t_shop" onclick="go('shop')">${t('shop')}</button>
    </div></nav>`;
}
function updateOpenBtn(){ const b = $('openBtn'), r = state.restaurant; if (!b) return; b.className = 'openbtn ' + (r.is_open ? 'on' : ''); b.innerHTML = `<i></i>${r.is_open ? t('open_now') : t('closed_now')}`; b.setAttribute('onclick', `A.toggleOpen(${!r.is_open})`); }
function markTab(){
  ['orders','menu','earn','shop'].forEach(k => { const b = $('t_' + k); if (b) b.classList.toggle('on', state.tab === k); });
  const o = $('t_orders'); if (o){ const n = newOrders().length; o.innerHTML = t('orders') + (n ? `<span class="dot">${n}</span>` : ''); }
}
async function go(tab){
  state.tab = tab; markTab();
  const v = $('view'); if (!v) return;
  v.innerHTML = `<div class="empty">${t('loading')}</div>`;
  await run(async () => {
    if (tab === 'orders') await loadOrders();
    if (tab === 'menu') await loadMenu();
    if (tab === 'earn') await loadEarn();
    if (tab === 'shop') await loadReviews();
  });
  renderTab(); window.scrollTo(0, 0);
}
function renderTab(){
  const v = $('view'); if (!v) return;
  if (state.tab === 'orders') v.innerHTML = viewOrders();
  if (state.tab === 'menu') v.innerHTML = viewMenu();
  if (state.tab === 'earn') v.innerHTML = viewEarn();
  if (state.tab === 'shop') v.innerHTML = viewShop();
  markTab(); updateTitle();
}

// ================= ORDERS =================
async function loadOrders(){
  const data = need(await sb.from('orders')
    .select('*, customer:profiles!customer_id(full_name,phone), order_items(name,quantity,price,note)')
    .eq('restaurant_id', state.restaurant.id).order('created_at', { ascending:false }).limit(120));
  const active = data.filter(o => ['accepted','preparing'].includes(o.status)).map(o => o.id);
  if (active.length){
    const logs = need(await sb.from('order_status_log').select('order_id,changed_at').in('order_id', active).eq('status', 'accepted'));
    logs.forEach(l => { state.acceptedAt[l.order_id] = l.changed_at; });
  }
  await Promise.all(data.filter(o => ['rider_assigned', 'picked_up'].includes(o.status)).map(async o => {
    const r = await sb.rpc('order_rider_info', { p_order_id:o.id }); o.rider = (r.data && r.data[0]) || null;
  }));
  state.issues = {};
  const recent = data.filter(o => !['delivered','rejected'].includes(o.status) && (o.status !== 'cancelled' || o.return_status === 'returning')).map(o => o.id);
  if (recent.length){
    const rows = need(await sb.from('order_issues').select('*').in('order_id', recent).in('status', ['open','returning']).order('created_at', { ascending:false }));
    rows.forEach(i => { (state.issues[i.order_id] = state.issues[i.order_id] || []).push(i); });
    const newIss = rows.filter(i => !state.seenIssues.has(i.id));
    newIss.forEach(i => state.seenIssues.add(i.id));
    if (newIss.length && state.loadedOnce){ beep(); toast(t('new_problem') + ': ' + t('k_' + newIss[0].kind), true); }
  }
  state.orders = data;
  const fresh = data.filter(o => o.status === 'placed' && !state.alerted.has(o.id));
  fresh.forEach(o => state.alerted.add(o.id));
  if (fresh.length && state.loadedOnce && !$('sheet')) showNewOrder(fresh[0]);
  state.loadedOnce = true;
  updateTitle(); markTab();
}
let refreshing = false;
async function refreshOrders(){
  if (refreshing || !state.restaurant) return; refreshing = true;
  try { await loadOrders(); if (state.tab === 'orders') renderTab(); } catch (e) { logErr(e); } finally { refreshing = false; }
}
setInterval(() => { if (state.tab === 'orders' && document.querySelector('.countdown')) renderTab(); }, 30000);
function itemsHtml(o){ return `<div class="items">${(o.order_items || []).map(i => `<div><b>${i.quantity}×</b> ${esc(i.name)}${i.note ? ` <span class="muted">(${esc(i.note)})</span>` : ''}</div>`).join('')}</div>`; }
const schedTxt = iso => new Date(iso).toLocaleString(state.lang === 'ur' ? 'ur-PK' : 'en-GB', { weekday:'short', hour:'numeric', minute:'2-digit', hour12:true, timeZone:'Asia/Karachi' });
const isFuture = o => o.scheduled_for && new Date(o.scheduled_for).getTime() - (num(o.prep_minutes) || num(state.restaurant && state.restaurant.prep_time_minutes) || 25) * 60000 > Date.now();
function schedBox(o){
  if (!o.scheduled_for || ['delivered','cancelled','rejected'].includes(o.status)) return '';
  const start = new Date(new Date(o.scheduled_for).getTime() - ((num(o.prep_minutes) || num(state.restaurant.prep_time_minutes) || 25) + 10) * 60000);
  return `<div class="schedbox"><span>🗓️ ${t('sched_deliver')}</span><span>${esc(schedTxt(o.scheduled_for))}</span></div>${start > Date.now() ? `<div class="muted" style="font-size:14px">${t('sched_start', { t:esc(schedTxt(start.toISOString())) })}</div>` : ''}`;
}
function countdown(o){
  if (isFuture(o)) return '';
  if (!['accepted','preparing'].includes(o.status) || !o.prep_minutes) return '';
  const acc = state.acceptedAt[o.id]; if (!acc) return '';
  const left = Math.round((new Date(acc).getTime() + o.prep_minutes * 60000 - Date.now()) / 60000);
  return left >= 0 ? `<div class="countdown"><span>${t('ready_in')}</span><span>${left} ${t('min')}</span></div>`
                   : `<div class="countdown late"><span>${t('late_by')}</span><span>${-left} ${t('min')}</span></div>`;
}
function isLate(o){ if (isFuture(o)) return false; const acc = state.acceptedAt[o.id]; return acc && o.prep_minutes && ['accepted','preparing'].includes(o.status) && Date.now() > new Date(acc).getTime() + o.prep_minutes * 60000; }
function orderCard(o){
  const cust = o.customer || {};
  const riderLine = o.rider ? `<div class="muted" style="margin-top:8px">${t('rider_label')}: <b>${esc(o.rider.full_name || '')}</b> ${o.rider.phone ? `<a href="tel:${esc(o.rider.phone)}">${esc(o.rider.phone)}</a>` : ''}</div>` : '';
  let actions = '';
  if (o.status === 'placed') actions = `<div class="two"><button class="btn warn" onclick="A.openReject('${o.id}')">${t('reject')}</button><button class="btn" onclick="A.openAccept('${o.id}')">${t('accept')}</button></div>`;
  else if (o.status === 'accepted') actions = `<div class="two"><button class="btn ghost" onclick="A.setStatus('${o.id}','preparing')">${t('start_prep')}</button><button class="btn" onclick="A.setStatus('${o.id}','ready')">${t('mark_ready')}</button></div>`;
  else if (o.status === 'preparing') actions = `<button class="btn" onclick="A.setStatus('${o.id}','ready')">${t('mark_ready')}</button>`;
  else if (o.status === 'ready') actions = `<div class="muted" style="margin-top:8px">${t('waiting_rider')}</div>`;
  else if (o.status === 'rider_assigned') actions = `<div class="muted" style="margin-top:8px">${t('rider_coming')}</div>${riderLine}`;
  else if (o.status === 'picked_up') actions = `<div class="muted" style="margin-top:8px">${t('picked')}</div>${riderLine}`;
  const cid = JSON.stringify(o.id);
  actions += `<div style="display:grid;grid-template-columns:${o.rider_id ? '1fr 1fr 1fr' : '1fr 1fr'};gap:8px;margin-top:10px">
    <button class="btn ghost small" style="width:auto;display:block" onclick='Chat.open(${cid}, "cs", null)'>💬 ${t('customer')}</button>
    ${o.rider_id ? `<button class="btn ghost small" style="width:auto;display:block" onclick='Chat.open(${cid}, "rs", null)'>💬 ${t('rider_label')}</button>` : ''}
    <button class="btn ghost small" style="width:auto;display:block" onclick='Chat.open(${cid}, "sup_s", null)'>💬 ${t('help_word')}</button></div>`;
  if (['accepted','preparing','ready','rider_assigned','picked_up'].includes(o.status)) actions += `<button class="link" style="color:var(--danger)" onclick="A.reportForm('${o.id}')">${t('report')}</button>`;
  return `<div class="card ${o.status === 'placed' ? 'new' : ''} ${isLate(o) ? 'late' : ''}">
    <div class="ch"><span class="oid">#${esc(o.id.slice(-4).toUpperCase())}</span>
      <span><span class="pill" style="background:var(--s-${o.status})">${t('st_' + o.status)}</span> <span class="muted">${timeAgo(o.created_at)}</span></span></div>
    ${schedBox(o)}
    ${itemsHtml(o)}
    ${o.customer_note ? `<div class="note"><b>${t('cust_note')}:</b> ${esc(o.customer_note)}</div>` : ''}
    ${countdown(o)}
    ${(state.issues[o.id] || []).map(i => `<div class="issuebox"><b>${t('problem')}:</b> ${t('k_' + i.kind)}${i.note ? ' · ' + esc(i.note) : ''}${i.wait_until && i.status === 'open' ? `<br><span class="muted">${t('waiting_until', { t:new Date(i.wait_until).toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' }) })}</span>` : ''}</div>`).join('')}
    <div class="cust"><b>${esc(cust.full_name || t('customer'))}</b> ${cust.phone ? `<a href="tel:${esc(cust.phone)}">${esc(cust.phone)}</a>` : `<span class="muted">${t('no_phone')}</span>`}</div>
    <div class="line" style="font-weight:800"><span>${t('order_value')}</span><span>${money(o.subtotal)}</span></div>
    <div class="actions">${actions}</div></div>`;
}
function pastRow(o){
  return `<div class="row"><div class="row-main" style="cursor:default"><b>#${esc(o.id.slice(-4).toUpperCase())}</b> <span class="pill" style="background:var(--s-${o.status})">${t('st_' + o.status)}</span>
    <div class="muted" style="font-size:13px">${when(o.created_at)} · ${(o.order_items || []).reduce((n, i) => n + i.quantity, 0)} ${t('products').toLowerCase()}</div></div><b>${money(o.subtotal)}</b></div>`;
}
function viewOrders(){
  const r = state.restaurant;
  const by = fn => state.orders.filter(fn);
  const fresh = by(o => o.status === 'placed');
  const kitchen = by(o => ['accepted','preparing'].includes(o.status));
  const ready = by(o => ['ready','rider_assigned','picked_up'].includes(o.status));
  const back = by(o => o.return_status === 'returning');
  const past = by(o => ['delivered','cancelled','rejected'].includes(o.status) && o.return_status !== 'returning').slice(0, 30);
  const sect = (title, list) => list.length ? `<h2>${title} <span class="count">${list.length}</span></h2>${list.map(orderCard).join('')}` : '';
  const sound = (!audioReady() && state.sound) ? `<button class="soundbar" onclick="A.enableSound()">${t('enable_sound')}</button>` : '';
  const closed = r.is_open ? (withinHours(r) ? '' : `<div class="closedbar"><span>${esc(hoursText(r))}</span></div>`) : `<div class="closedbar"><span>${t('closed_bar')}</span><button class="btn small" onclick="A.toggleOpen(true)">${t('open_it')}</button></div>`;
  const live = fresh.length || kitchen.length || ready.length || back.length;
  const backHtml = back.length ? `<h2>${t('coming_back')} <span class="count">${back.length}</span></h2>${back.map(o => `<div class="card back">
      <div class="ch"><span class="oid">#${esc(o.id.slice(-4).toUpperCase())}</span><span class="pill r">${t('coming_back')}</span></div>
      ${itemsHtml(o)}<div class="muted">${t('coming_back_note')}</div>
      ${(state.issues[o.id] || []).map(i => `<div class="issuebox"><b>${t('problem')}:</b> ${t('k_' + i.kind)}${i.note ? ' · ' + esc(i.note) : ''}</div>`).join('') || (o.reject_reason ? `<div class="issuebox">${esc(o.reject_reason)}</div>` : '')}
      <button class="btn" onclick="A.receivedBack('${o.id}')">${t('received_back')}</button></div>`).join('')}` : '';
  return `${sound}${closed}${backHtml}${sect(t('new_orders'), fresh)}${sect(t('in_kitchen'), kitchen)}${sect(t('ready_pickup'), ready)}
    ${live ? '' : `<div class="empty">${t('no_orders')}<br><br><span style="font-size:14px">${t('keep_open')}</span></div>`}
    ${past.length ? `<h2>${t('past')}</h2>${past.map(pastRow).join('')}` : ''}`;
}
function showNewOrder(o){
  beep();
  const opts = prepOptions();
  openSheet(t('new_order'), `
    <div class="ch"><span class="oid">#${esc(o.id.slice(-4).toUpperCase())}</span><b style="font-size:20px">${money(o.subtotal)}</b></div>
    ${schedBox(o)}
    ${itemsHtml(o)}
    ${o.customer_note ? `<div class="note"><b>${t('cust_note')}:</b> ${esc(o.customer_note)}</div>` : ''}
    <div class="muted">${t('prep_q')}</div>
    <div class="chips" id="prepChips">${opts.map(m => `<button class="chip ${m === state.prep ? 'on' : ''}" onclick="A.pickPrep(${m})">${m} ${t('min')}</button>`).join('')}</div>
    <div class="two"><button class="btn warn" onclick="A.openReject('${o.id}')">${t('reject')}</button><button class="btn" onclick="A.doAccept('${o.id}')">${t('accept')}</button></div>`, 'alert');
}
function prepOptions(){
  state.prep = state.restaurant.prep_time_minutes || 20;
  const opts = [10, 15, 20, 30, 45, 60]; if (!opts.includes(state.prep)) opts.push(state.prep);
  return opts.sort((a, b) => a - b);
}

// ================= PRODUCTS =================
async function loadMenu(){
  const id = state.restaurant.id;
  const [c, i] = await Promise.all([
    sb.from('menu_categories').select('*').eq('restaurant_id', id).order('sort_order'),
    sb.from('menu_items').select('*').eq('restaurant_id', id).order('sort_order').order('name')
  ]);
  state.cats = need(c); state.items = need(i);
}
function itemRow(i){
  return `<div class="row">
    <div class="thumb">${i.photo_url ? `<img src="${esc(i.photo_url)}" alt="" loading="lazy">` : esc((i.name || '?')[0])}</div>
    <button class="row-main" onclick="A.editItem('${i.id}')"><div style="font-weight:700">${esc(i.name)}</div>
      <div>${money(i.price)}${num(i.compare_price) > num(i.price) ? `<span class="strike">${money(i.compare_price)}</span>` : ''}</div>
      ${i.is_approved === false ? `<span class="pill y">${t('pending')}</span>` : ''}</button>
    <div style="text-align:center;flex:none"><label class="switch"><input type="checkbox" ${i.is_available ? 'checked' : ''} onchange="A.toggleItem('${i.id}', this.checked)" aria-label="${t('in_stock')}"><span></span></label><small class="muted">${i.is_available ? t('in_stock') : t('out_stock')}</small></div>
  </div>`;
}
function viewMenu(){
  const q = state.productQ.trim().toLowerCase(); const f = state.productFilter;
  const list = state.items.filter(i => (!q || (i.name || '').toLowerCase().includes(q)) && (f === 'all' || (f === 'out' && !i.is_available) || (f === 'pending' && i.is_approved === false)));
  const pending = state.items.filter(i => i.is_approved === false).length, out = state.items.filter(i => !i.is_available).length;
  const chips = [['all', t('all')], ['out', t('out_filter') + (out ? ' ' + out : '')], ['pending', t('pending_filter') + (pending ? ' ' + pending : '')]]
    .map(([k, l]) => `<button class="chip ${f === k ? 'on' : ''}" onclick="A.productFilter('${k}')">${l}</button>`).join('');
  let body;
  if (q || f !== 'all') body = list.map(itemRow).join('') || `<div class="empty">—</div>`;
  else {
    body = state.cats.map(c => {
      const items = list.filter(i => i.category_id === c.id);
      return `<div class="cat"><h3>${esc(c.name)}</h3><button class="link" style="padding:4px 0" onclick="A.editCategory('${c.id}')">${t('edit_section')}</button></div>${items.map(itemRow).join('')}`;
    }).join('');
    const loose = list.filter(i => !state.cats.some(c => c.id === i.category_id));
    if (loose.length) body += loose.map(itemRow).join('');
    if (!state.cats.length && !list.length) body = `<div class="empty">${t('menu_empty')}</div>`;
  }
  return `<h1>${t('products')}</h1>
    <input type="search" id="pq" placeholder="${t('search')}" value="${esc(state.productQ)}" oninput="A.productSearch(this.value)">
    <div class="chips">${chips}</div>
    <div class="two"><button class="btn ghost" onclick="A.editCategory()">${t('add_section')}</button><button class="btn" onclick="A.editItem()">${t('add_product')}</button></div>
    ${pending ? `<div class="note" style="margin-top:12px">${t('pending_note')}</div>` : ''}
    <div id="menuBody">${body}</div>`;
}
function itemForm(i){
  i = i || { is_available:true };
  const catOpts = state.cats.map(c => `<option value="${c.id}" ${i.category_id === c.id ? 'selected' : ''}>${esc(c.name)}</option>`).join('');
  return `
    ${i.id && i.is_approved === false ? `<div class="note">${t('pending')}</div>` : ''}
    <label class="f" for="i_name" style="margin-top:0">${t('product_name')}</label><input id="i_name" type="text" value="${esc(i.name)}">
    <label class="f" for="i_desc">${t('description')}</label><textarea id="i_desc">${esc(i.description)}</textarea>
    <div class="two">
      <div><label class="f" for="i_price">${t('price')}</label><input id="i_price" type="number" inputmode="decimal" min="0" value="${i.price ?? ''}"></div>
      <div><label class="f" for="i_cmp">${t('compare')}</label><input id="i_cmp" type="number" inputmode="decimal" min="0" value="${i.compare_price ?? ''}"></div>
    </div>
    <label class="f" for="i_cat">${t('section')}</label><select id="i_cat">${catOpts}</select>
    <label class="f" for="i_photo">${t('photo')}</label>
    <input id="i_photo" type="file" accept="image/*" onchange="previewFile(this,'i_prev')">
    <img id="i_prev" class="preview" alt="" style="display:${i.photo_url ? 'block' : 'none'}" src="${esc(i.photo_url || '')}">
    <label class="check"><input id="i_avail" type="checkbox" ${i.is_available ? 'checked' : ''}> ${t('in_stock')}</label>
    ${OE.html()}
    ${i.id ? '' : `<div class="muted" style="font-size:14px">${t('pending_note')}</div>`}
    <div class="actions"><button class="btn" id="saveBtn" onclick="A.saveItem('${i.id || ''}')">${t('save')}</button>
    ${i.id ? `<button class="btn warn" onclick="A.deleteItem('${i.id}')">${t('remove')}</button>` : ''}</div>`;
}

// ================= EARNINGS =================
async function loadEarn(){
  const from = range(state.period); const id = state.restaurant.id;
  const [o, un, pay] = await Promise.all([
    sb.from('orders').select('id,status,subtotal,commission_amount,restaurant_earning,created_at,order_items(name,quantity,price)').eq('restaurant_id', id).gte('created_at', from.toISOString()).limit(3000),
    sb.from('orders').select('restaurant_earning').eq('restaurant_id', id).eq('status', 'delivered').eq('restaurant_settled', false),
    sb.from('payouts').select('*').eq('party_type', 'restaurant').eq('party_id', id).order('created_at', { ascending:false }).limit(20)
  ]);
  const orders = need(o); const del = orders.filter(x => x.status === 'delivered');
  state.earnOrders = orders;
  const sum = (l, f) => l.reduce((n, x) => n + num(f(x)), 0);
  const by = {};
  del.forEach(x => (x.order_items || []).forEach(i => { const p = by[i.name] || (by[i.name] = { qty:0, rev:0 }); p.qty += i.quantity; p.rev += num(i.price) * i.quantity; }));
  state.earn = {
    orders:orders.length, delivered:del.length, cancelled:orders.filter(x => ['cancelled','rejected'].includes(x.status)).length,
    sales:sum(del, x => x.subtotal), commission:sum(del, x => x.commission_amount), earning:sum(del, x => x.restaurant_earning),
    unpaid:sum(need(un), x => x.restaurant_earning), payouts:need(pay),
    top:Object.entries(by).map(([name, v]) => ({ name, ...v })).sort((a, b) => b.qty - a.qty).slice(0, 8)
  };
}
function viewEarn(){
  const e = state.earn || {};
  const chips = [['today', t('today')], ['7d', t('d7')], ['month', t('month')], ['30d', t('d30')]].map(([k, l]) => `<button class="chip ${state.period === k ? 'on' : ''}" onclick="A.setPeriod('${k}')">${l}</button>`).join('');
  const top = (e.top || []).map(p => `<div class="row"><div class="row-main" style="cursor:default"><b>${esc(p.name)}</b><div class="muted" style="font-size:13px">${p.qty} ×</div></div><b>${money(p.rev)}</b></div>`).join('');
  const pays = (e.payouts || []).map(p => `<div class="row"><div class="row-main" style="cursor:default"><b>${money(p.amount)}</b><div class="muted" style="font-size:13px">${esc(p.note || '')}</div></div><span class="muted" style="font-size:13px">${when(p.created_at)}</span></div>`).join('');
  return `<h1>${t('earnings')}</h1>
    <div class="card" style="background:var(--green);border-color:var(--green);color:#fff">
      <div style="opacity:.85">${t('to_receive')}</div><div style="font-size:30px;font-weight:800">${money(e.unpaid)}</div>
      <div style="opacity:.85;font-size:13px">${t('to_receive_note')}</div></div>
    <div class="chips">${chips}</div>
    <div class="tiles">
      <div class="tile"><b>${num(e.orders)}</b><span>${t('orders_n')}</span></div>
      <div class="tile"><b>${num(e.delivered)}</b><span>${t('delivered_n')}</span></div>
    </div>
    <div class="card" style="margin-top:12px">
      <div class="line"><span class="muted">${t('sales')}</span><span>${money(e.sales)}</span></div>
      <div class="line"><span class="muted">${t('commission')} (${num(state.restaurant.commission_percent)}%)</span><span class="red">−${money(e.commission)}</span></div>
      <div class="line total"><span>${t('your_earning')}</span><span>${money(e.earning)}</span></div>
      <div class="line"><span class="muted">${t('cancelled_n')}</span><span>${num(e.cancelled)}</span></div>
    </div>
    <div class="two" style="margin-top:10px"><button class="btn ghost" onclick="A.statement('xlsx')">⬇️ Excel</button><button class="btn ghost" onclick="A.statement('pdf')">🧾 PDF</button></div>
    <div class="muted" style="font-size:13px;text-align:center">${t('statement_note')}</div>
    <h2>${t('top_items')}</h2>${top || `<div class="empty">${t('no_sales')}</div>`}
    <h2>${t('payments')}</h2>${pays || `<div class="empty">${t('no_payments')}</div>`}`;
}

// ================= SHOP =================
async function loadReviews(){
  state.reviews = need(await sb.from('reviews').select('restaurant_rating,comment,created_at,shop_tags').eq('restaurant_id', state.restaurant.id).order('created_at', { ascending:false }).limit(50));
}
function viewShop(){
  const r = state.restaurant; const rv = state.reviews || [];
  const avg = rv.length ? (rv.reduce((n, x) => n + num(x.restaurant_rating), 0) / rv.length).toFixed(1) : null;
  const revs = rv.slice(0, 15).map(x => `<div class="review"><span class="stars">${'★'.repeat(num(x.restaurant_rating))}${'☆'.repeat(5 - num(x.restaurant_rating))}</span> <span class="muted" style="font-size:13px">${when(x.created_at)}</span>${(x.shop_tags || []).length ? `<div class="muted" style="font-size:13px">${esc(x.shop_tags.join(' · '))}</div>` : ''}${x.comment ? `<div>${esc(x.comment)}</div>` : ''}</div>`).join('');
  return `<h1>${t('shop')}</h1>
    <div class="card" style="display:flex;justify-content:space-between;align-items:center;gap:12px">
      <div><b>${r.is_open ? t('open_now') : t('closed_now')}</b><div class="muted" style="font-size:14px">${r.is_open ? (withinHours(r) ? t('is_open_msg') : esc(hoursText(r))) : t('is_closed_msg')}</div></div>
      <label class="switch" style="margin:0"><input type="checkbox" ${r.is_open ? 'checked' : ''} onchange="A.toggleOpen(this.checked)" aria-label="${t('open_now')}"><span></span></label>
    </div>
    <div class="tiles" style="margin-bottom:12px">
      <div class="tile hi"><b>${avg ? '★ ' + avg : '—'}</b><span>${t('rating')} (${rv.length})</span></div>
      <div class="tile"><b>${num(r.commission_percent)}%</b><span>${t('commission_rate')}</span></div>
    </div>
    <h2>${t('shop_details')}</h2>
    <div class="card">
      <label class="f" for="s_desc" style="margin-top:0">${t('description')}</label><input id="s_desc" type="text" value="${esc(r.description)}">
      <label class="f" for="s_addr">${t('address')}</label><input id="s_addr" type="text" value="${esc(r.address)}">
      <label class="f" for="s_phone">${t('phone')}</label><input id="s_phone" type="tel" value="${esc(r.phone)}">
      <div class="two">
        <div><label class="f" for="s_open">${t('opens')}</label><input id="s_open" type="time" value="${hhmm(r.open_time)}"></div>
        <div><label class="f" for="s_close">${t('closes')}</label><input id="s_close" type="time" value="${hhmm(r.close_time)}"></div>
      </div>
      <label class="f">${t('shop_loc')}</label>
      <div class="muted" style="font-size:14px">${r.lat != null && r.lng != null ? `✅ ${t('loc_set')} <a href="https://maps.google.com/?q=${r.lat},${r.lng}" target="_blank" rel="noopener">${Number(r.lat).toFixed(5)}, ${Number(r.lng).toFixed(5)}</a>` : `⚠️ ${t('loc_missing')}`}</div>
      <button class="btn ghost" type="button" id="locBtn" style="margin-top:8px" onclick="A.setShopLoc()">${t('set_loc')}</button>
      <label class="f" for="s_prep">${t('prep_default')}</label><input id="s_prep" type="number" min="5" step="5" value="${r.prep_time_minutes || 25}">
      <label class="f" for="s_logo">${t('logo')}</label><input id="s_logo" type="file" accept="image/*" onchange="previewFile(this,'s_prev')">
      <img id="s_prev" class="preview" alt="" style="display:${r.logo_url ? 'block' : 'none'}" src="${esc(r.logo_url || '')}">
      <div class="actions"><button class="btn" id="shopSave" onclick="A.saveShop()">${t('save')}</button></div>
    </div>
    <h2>${t('reviews')}</h2>${revs || `<div class="empty">${t('no_reviews')}</div>`}
    <div class="card" style="display:flex;justify-content:space-between;align-items:center;margin-top:16px"><b>${t('sound')}</b>
      <label class="switch" style="margin:0"><input type="checkbox" ${state.sound ? 'checked' : ''} onchange="A.setSound(this.checked)" aria-label="${t('sound')}"><span></span></label></div>
    <div class="actions">
      <button class="btn ghost" onclick='Chat.open(null, "sup", state.user.id)'>💬 ${t('chat_support')}</button>
      ${Legal.links(state.lang)}
      <button class="btn ghost" onclick="A.toggleLang()">${t('language')}: ${state.lang === 'ur' ? 'English' : 'اردو'}</button>
      <button class="btn warn" onclick="A.logout()">${t('logout')}</button>
    </div>
    <p class="ver" style="margin-top:14px">Wanhar Mart Shop v${APP_VERSION}</p>`;
}

// ---- Photos ----
function resizeImage(file, max){
  return new Promise((res, rej) => {
    const img = new Image(); const url = URL.createObjectURL(file);
    img.onload = () => {
      const s = Math.min(1, max / Math.max(img.width, img.height));
      const c = document.createElement('canvas'); c.width = Math.round(img.width * s); c.height = Math.round(img.height * s);
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(url);
      c.toBlob(b => b ? res(b) : rej(new Error('Could not read this image')), 'image/jpeg', 0.82);
    };
    img.onerror = () => rej(new Error('Could not read this image')); img.src = url;
  });
}
async function uploadImage(file, folder){
  const blob = await resizeImage(file, 900); const path = `${folder}/${Date.now()}.jpg`;
  need(await sb.storage.from('food-images').upload(path, blob, { contentType:'image/jpeg' }));
  return sb.storage.from('food-images').getPublicUrl(path).data.publicUrl;
}
function previewFile(input, id){ const f = input.files && input.files[0]; if (!f) return; const el = $(id); el.src = URL.createObjectURL(f); el.style.display = 'block'; }

// ================= ACTIONS =================
const A = {
  toggleLang(onAuth){
    state.lang = state.lang === 'ur' ? 'en' : 'ur'; ls.set('kh_lang', state.lang); applyLang();
    if (onAuth || !state.restaurant) showAuth(); else { renderShell(); renderTab(); }
  },
  async forgotPw(){
    const email = ($('a_email') && $('a_email').value.trim()) || '';
    const msg = $('authMsg');
    if (!email){ msg.style.color = ''; msg.textContent = t('enter_email_first'); $('a_email').focus(); return; }
    msg.textContent = t('loading');
    const { error } = await sb.auth.resetPasswordForEmail(email, { redirectTo:new URL('reset.html?app=shop', location.href).href });
    if (error){ msg.style.color = ''; msg.textContent = error.message; return; }
    msg.style.color = 'var(--green)'; msg.textContent = t('reset_sent');
  },
  switchAuth(){ state.authMode = state.authMode === 'signup' ? 'login' : 'signup'; showAuth(); },
  async submitAuth(e){
    e.preventDefault(); unlockAudio();
    const signup = state.authMode === 'signup';
    const email = $('a_email').value.trim(), pw = $('a_pw').value; const msg = $('authMsg'); msg.style.color = ''; msg.textContent = '';
    if (!email || !pw){ msg.textContent = t('enter_all'); return; }
    if (pw.length < 6){ msg.textContent = t('short_pw'); return; }
    let name = '', phone = '';
    if (signup){ name = $('a_name').value.trim(); phone = $('a_phone').value.trim(); if (!name || !phone){ msg.textContent = t('enter_all'); return; } }
    const btn = $('authBtn'); btn.disabled = true; btn.textContent = t('loading');
    try {
      if (signup){
        const { data, error } = await sb.auth.signUp({ email, password:pw, options:{ data:{ full_name:name }, emailRedirectTo:new URL('verified.html?app=shop', location.href).href } });
        if (error) throw error;
        if (!data.session){ state.authMode = 'login'; showAuth(t('confirm_email'), true); return; }
        await sb.from('profiles').update({ full_name:name, phone }).eq('id', data.user.id);
        await afterLogin(data.user);
      } else {
        const { data, error } = await sb.auth.signInWithPassword({ email, password:pw });
        if (error) throw error; await afterLogin(data.user);
      }
    } catch (err) {
      logErr(err);
      const m = /invalid login/i.test((err && err.message) || '') ? t('bad_login') : ((err && err.message) || t('error'));
      const el = $('authMsg'); if (el) el.textContent = m;
      const b = $('authBtn'); if (b){ b.disabled = false; b.textContent = signup ? t('signup') : t('login'); }
    }
  },
  async logout(){
    await Push.logout(); Chat.stop(); Chat.close(); await sb.auth.signOut();
    if (alertTimer){ clearInterval(alertTimer); alertTimer = null; }
    if (pollTimer){ clearInterval(pollTimer); pollTimer = null; }
    if (channel){ sb.removeChannel(channel); channel = null; }
    closeSheet(); state.user = null; state.restaurant = null; state.orders = []; state.authMode = 'login'; document.title = 'Wanhar Mart Shop'; showAuth();
  },
  async recheck(){ await run(async () => { await loadRestaurant(); if (state.restaurant) await startApp(); else toast(t('not_linked'), true); }); },
  enableSound(){ unlockAudio(); setTimeout(() => { beep(); renderTab(); }, 200); },
  statement(kind){
    const e = state.earn || {}; const r = state.restaurant; const list = (state.earnOrders || []).slice().sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
    const periodName = { today:t('today'), '7d':t('d7'), month:t('month'), '30d':t('d30') }[state.period] || '';
    const d = x => new Date(x).toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
    const items = x => (x.order_items || []).map(i => i.quantity + '× ' + i.name).join(', ');
    const file = 'Wanhar-Mart-' + (r.name || 'shop').replace(/[^a-z0-9]+/gi, '-') + '-' + new Date().toISOString().slice(0, 10);
    if (kind === 'xlsx'){
      const rows = [['Order', 'Date', 'Status', 'Items', 'Sales (Rs)', 'Commission (Rs)', 'Your earning (Rs)']];
      list.forEach(x => rows.push(['#' + x.id.slice(-4).toUpperCase(), d(x.created_at), x.status, items(x), num(x.subtotal), num(x.commission_amount), num(x.restaurant_earning)]));
      rows.push([]); rows.push(['Total delivered', '', '', '', num(e.sales), num(e.commission), num(e.earning)]);
      return Report.excel(file, [{ name:'Statement', rows }, { name:'Top items', rows:[['Item', 'Qty', 'Sales (Rs)'], ...(e.top || []).map(p => [p.name, p.qty, p.rev])] }]);
    }
    Report.pdf({ title:t('statement') + ' · ' + r.name, subtitle:periodName + ' · ' + t('commission') + ' ' + num(r.commission_percent) + '%', printLabel:t('print_pdf'), closeLabel:t('close_word'),
      blocks:[{ heading:t('earnings'), rows:[[t('orders_n'), num(e.orders)], [t('delivered_n'), num(e.delivered)], [t('cancelled_n'), num(e.cancelled)], [t('sales'), money(e.sales)], [t('commission'), '−' + money(e.commission)], [t('your_earning'), money(e.earning), true], [t('to_receive'), money(e.unpaid)]] }],
      table:{ heading:t('orders_n'), head:['#', 'Date', 'Status', 'Items', 'Sales', 'Commission', 'Earning'], numFrom:4,
        rows:list.map(x => ['#' + x.id.slice(-4).toUpperCase(), d(x.created_at), x.status, items(x), money(x.subtotal), money(x.commission_amount), money(x.restaurant_earning)]) } });
  },
  setSound(v){ state.sound = v; ls.set('kh_r_sound', v); if (v){ unlockAudio(); setTimeout(beep, 200); } },
  setPeriod(p){ state.period = p; go('earn'); },

  // ---- Orders ----
  openAccept(id){
    const o = state.orders.find(x => x.id === id); if (o) return showNewOrder(o);
  },
  pickPrep(m){ state.prep = m; document.querySelectorAll('#prepChips .chip').forEach(c => c.classList.toggle('on', parseInt(c.textContent, 10) === m)); },
  async doAccept(id){
    await run(async () => {
      need(await sb.rpc('update_order_status', { p_order_id:id, p_status:'accepted', p_prep_minutes:state.prep }));
      state.acceptedAt[id] = new Date().toISOString();
      closeSheet(); await loadOrders(); renderTab(); toast(t('saved'));
      const next = newOrders()[0]; if (next) showNewOrder(next);
    });
  },
  openReject(id){
    openSheet(t('reject'), `<div class="muted">${t('reject_q')}</div>
      <div class="actions">${['r1','r2','r3','r4'].map(k => `<button class="btn warn" onclick="A.doReject('${id}','${k}')">${t(k)}</button>`).join('')}</div>`);
  },
  async doReject(id, key){
    await run(async () => {
      need(await sb.rpc('update_order_status', { p_order_id:id, p_status:'rejected', p_reason:I18N.en[key] }));
      closeSheet(); await loadOrders(); renderTab(); toast(t('saved'));
    });
  },
  async setStatus(id, status){
    await run(async () => { need(await sb.rpc('update_order_status', { p_order_id:id, p_status:status })); await loadOrders(); renderTab(); toast(t('saved')); });
  },

  async receivedBack(id){
    if (!confirm(t('received_q'))) return;
    await run(async () => { need(await sb.rpc('confirm_return', { p_order_id:id })); await loadOrders(); renderTab(); toast(t('saved')); });
  },
  reportForm(id){
    state.pickKind = null;
    const kinds = ['k_rider_delay','k_order_damaged','k_other'].map(k => k.slice(2));
    openSheet(t('report_title'), `<div class="actions" id="probs">${kinds.map(k => `<button class="btn ghost" onclick="A.pickKind('${k}', this)">${t('k_' + k)}</button>`).join('')}</div>
      <label class="f" for="pnote">${t('note_opt')}</label><textarea id="pnote"></textarea>
      <div class="actions"><button class="btn" onclick="A.sendReport('${id}')">${t('send_report')}</button></div>`);
  },
  pickKind(k, btn){ state.pickKind = k; document.querySelectorAll('#probs button').forEach(b => { b.className = 'btn ' + (b === btn ? '' : 'ghost'); }); },
  async sendReport(id){
    if (!state.pickKind) return toast(t('pick_problem'), true);
    await run(async () => { need(await sb.rpc('report_issue', { p_order_id:id, p_kind:state.pickKind, p_note:($('pnote').value || '').trim() || null })); closeSheet(); await loadOrders(); renderTab(); toast(t('reported')); });
  },

  // ---- Shop ----
  async toggleOpen(v){
    if (!v && !confirm(t('close_q'))){ renderTab(); return; }
    await run(async () => {
      need(await sb.from('restaurants').update({ is_open:v }).eq('id', state.restaurant.id));
      state.restaurant.is_open = v; updateOpenBtn(); renderTab(); toast(t('saved'));
    });
  },
  setShopLoc(){
    if (!navigator.geolocation) return toast(t('loc_denied'), true);
    const b = $('locBtn'); if (b){ b.disabled = true; b.textContent = t('loading'); }
    navigator.geolocation.getCurrentPosition(async pos => {
      await run(async () => {
        const row = { lat:pos.coords.latitude, lng:pos.coords.longitude };
        need(await sb.from('restaurants').update(row).eq('id', state.restaurant.id));
        Object.assign(state.restaurant, row); toast(t('loc_saved')); renderTab();
      });
      const x = $('locBtn'); if (x){ x.disabled = false; x.textContent = t('set_loc'); }
    }, () => { const x = $('locBtn'); if (x){ x.disabled = false; x.textContent = t('set_loc'); } toast(t('loc_denied'), true); }, { enableHighAccuracy:true, timeout:15000 });
  },
  async saveShop(){
    const prep = num($('s_prep').value); if (prep < 5) return toast(t('enter_all'), true);
    const btn = $('shopSave'); btn.disabled = true; btn.textContent = t('loading');
    await run(async () => {
      const row = { description:$('s_desc').value.trim() || null, address:$('s_addr').value.trim() || null, phone:$('s_phone').value.trim() || null,
        open_time:$('s_open').value || null, close_time:$('s_close').value || null, prep_time_minutes:prep };
      const f = $('s_logo').files[0]; if (f) row.logo_url = await uploadImage(f, 'restaurants');
      need(await sb.from('restaurants').update(row).eq('id', state.restaurant.id));
      Object.assign(state.restaurant, row); toast(t('saved'));
    });
    const b = $('shopSave'); if (b){ b.disabled = false; b.textContent = t('save'); }
  },

  // ---- Products ----
  productFilter(f){ state.productFilter = f; renderTab(); },
  productSearch(v){ state.productQ = v; renderTab(); const inp = $('pq'); if (inp){ inp.focus(); inp.setSelectionRange(v.length, v.length); } },
  async toggleItem(id, v){ await run(async () => { need(await sb.from('menu_items').update({ is_available:v }).eq('id', id)); await loadMenu(); renderTab(); }); },
  editCategory(id){
    const c = state.cats.find(x => x.id === id);
    openSheet(c ? t('edit_section') : t('add_section'), `
      <label class="f" for="c_name" style="margin-top:0">${t('section_name')}</label><input id="c_name" type="text" value="${esc(c ? c.name : '')}" placeholder="Burgers">
      <div class="actions"><button class="btn" onclick="A.saveCategory('${id || ''}')">${t('save')}</button></div>`);
  },
  async saveCategory(id){
    const name = $('c_name').value.trim(); if (!name) return toast(t('enter_all'), true);
    await run(async () => {
      need(await (id ? sb.from('menu_categories').update({ name }).eq('id', id)
        : sb.from('menu_categories').insert({ name, restaurant_id:state.restaurant.id, sort_order:state.cats.length + 1 })));
      await loadMenu(); closeSheet(); renderTab(); toast(t('saved'));
    });
  },
  editItem(id){
    if (!state.cats.length) return toast(t('no_sections'), true);
    const i = state.items.find(x => x.id === id);
    openSheet(i ? i.name : t('add_product'), itemForm(i));
    OE.init({ sb, lang:() => state.lang }); OE.load(i ? i.id : null).catch(e => toast(e.message || t('error'), true));
  },
  async saveItem(id){
    const name = $('i_name').value.trim(), price = $('i_price').value, cmp = $('i_cmp').value;
    if (!name || price === '' || num(price) < 0 || !$('i_cat').value) return toast(t('enter_all'), true);
    const btn = $('saveBtn'); btn.disabled = true; btn.textContent = t('loading');
    await run(async () => {
      const row = { name, description:$('i_desc').value.trim() || null, price:num(price), compare_price:cmp === '' ? null : num(cmp),
        category_id:$('i_cat').value, is_available:$('i_avail').checked };
      const f = $('i_photo').files[0]; if (f) row.photo_url = await uploadImage(f, 'items');
      let itemId = id;
      if (id) need(await sb.from('menu_items').update(row).eq('id', id));
      else itemId = need(await sb.from('menu_items').insert(Object.assign(row, { restaurant_id:state.restaurant.id, sort_order:state.items.length + 1 })).select('id').single()).id;
      await OE.save(itemId);
      await loadMenu(); closeSheet(); renderTab(); toast(t('saved'));
    });
    const b = $('saveBtn'); if (b){ b.disabled = false; b.textContent = t('save'); }
  },
  async deleteItem(id){
    if (!confirm(t('remove_q'))) return;
    await run(async () => { need(await sb.from('menu_items').delete().eq('id', id)); await loadMenu(); closeSheet(); renderTab(); toast(t('saved')); });
  }
};

// ================= LIVE =================
let channel = null, pollTimer = null;
function subscribeOrders(){
  try {
    if (channel) sb.removeChannel(channel);
    channel = sb.channel('rest-orders').on('postgres_changes',
      { event:'*', schema:'public', table:'orders', filter:'restaurant_id=eq.' + state.restaurant.id },
      async payload => { if (payload.eventType === 'INSERT'){ unlockAudio(); beep(); } await refreshOrders(); }
    ).on('postgres_changes', { event:'INSERT', schema:'public', table:'order_issues', filter:'restaurant_id=eq.' + state.restaurant.id },
      async () => { unlockAudio(); await refreshOrders(); }
    ).subscribe();
  } catch (e) { console.warn('Live updates are off', e); }
  if (!pollTimer) pollTimer = setInterval(() => { if (state.user) refreshOrders(); }, 15000);
}

// ================= START =================
async function loadRestaurant(){
  const data = need(await sb.from('restaurants').select('*').eq('owner_id', state.user.id).order('created_at').limit(1));
  state.restaurant = data[0] || null;
}
async function startApp(){
  renderShell(); subscribeOrders(); startAlertLoop(); keepAwake();
  Chat.init({ me:() => state.user && state.user.id, lang:() => state.lang, role:'shop', ding:() => beep(), toast:(m, err) => toast(m, err) });
  Legal.init({ sb, lang:() => state.lang, toast:(m, err) => toast(m, err) });
  Push.init({ sb, app:'shop', me:() => state.user && state.user.id, lang:() => state.lang, toast:(m, err) => toast(m, err) });
  BackNav.init({ toast:m => toast(m), exitMsg:() => state.lang === 'ur' ? 'باہر نکلنے کے لیے دوبارہ واپس دبائیں' : 'Press back again to exit',
    overlays:[['#chatWrap', () => Chat.close()], ['#sheet', () => closeSheet()], ['#rptWrap', null], ['#receiptWrap', null], ['#slipWrap', null]],
    back:() => { if (state.tab !== 'orders'){ go('orders'); return true; } return false; } });
  await go('orders');
}
async function afterLogin(user){
  state.user = user; await loadRestaurant();
  if (!state.restaurant) return showUnlinked();
  await startApp();
}
// ================= CHAT (same code in all four apps) =================
const Chat = (() => {
  const L = {
    en: {
      messages:'Messages', support:'Wanhar Mart support', support_sub:'Ask us anything', no_chats:'No messages yet.', write:'Write a message…', send:'Send',
      new_msg:'New message', you:'You', customer:'Customer', rider:'Rider', shop:'Shop', admin:'Wanhar Mart', order:'Order',
      'as_customer.cr':'Rider', 'as_customer.cs':'Shop', 'as_customer.sup_c':'Wanhar Mart support',
      'as_rider.cr':'Customer', 'as_rider.rs':'Shop', 'as_rider.sup_r':'Wanhar Mart support',
      'as_shop.cs':'Customer', 'as_shop.rs':'Rider', 'as_shop.sup_s':'Wanhar Mart support',
      'as_admin.cr':'Customer and rider', 'as_admin.cs':'Customer and shop', 'as_admin.rs':'Rider and shop',
      'as_admin.sup_c':'Support: customer', 'as_admin.sup_r':'Support: rider', 'as_admin.sup_s':'Support: shop', sup:'Support',
      q_customer_cr:['Please call me','I am coming down','Please leave it at the door','Where are you now?'],
      q_customer_cs:['How long will my order take?','Please make it less spicy','Please add extra sauce','Please pack it well'],
      q_customer_sup:['My order is late','I have a problem with my order','Wrong or missing items','I want to cancel my order','Please call me'],
      q_rider_cr:['I am on my way','I have arrived, please come outside','I cannot find your address, please call me','Please keep the cash ready'],
      q_rider_rs:['I am at the shop, is the order ready?','I will reach in 5 minutes','Please pack the order properly','I am waiting outside'],
      q_rider_sup:['Customer is not answering','I need help with an order','My vehicle has a problem','Question about my pay','Please call me'],
      q_shop_cs:['Your order is being prepared','Your order is ready','Sorry, one item is not available','It will take 10 more minutes'],
      q_shop_rs:['The order is ready, please come','Ready in 10 minutes','Where are you?','Please come soon, I am waiting'],
      q_shop_sup:['I have a problem with an order','When will I receive my payment?','The rider is late','Please call me'],
      q_admin_cr:['Wanhar Mart here. How can we help?','Please share what happened','Thank you, we are solving it'],
      q_admin_cs:['Wanhar Mart here. How can we help?','Please share what happened','Thank you, we are solving it'],
      q_admin_rs:['Wanhar Mart here. How can we help?','Please share what happened','Thank you, we are solving it'],
      q_admin_sup:['Hello, how can we help you?','We are looking into it','Thank you for waiting','Please call us'],
      q_admin:['We are looking into it','Thank you for waiting','Please call us'],
      ask_join:'Call Wanhar Mart', ask_reason:'Tell Wanhar Mart what the problem is (for example: customer paid less cash):', ask_sent:'Wanhar Mart has been asked to join this chat',
      sys_req:'{w} asked Wanhar Mart to join this chat', sys_joined:'Wanhar Mart joined the chat. Please explain the problem.'
    },
    ur: {
      messages:'پیغامات', support:'Wanhar Mart سپورٹ', support_sub:'ہم سے کچھ بھی پوچھیں', no_chats:'ابھی کوئی پیغام نہیں۔', write:'پیغام لکھیں…', send:'بھیجیں',
      new_msg:'نیا پیغام', you:'آپ', customer:'گاہک', rider:'رائیڈر', shop:'دکان', admin:'Wanhar Mart', order:'آرڈر',
      'as_customer.cr':'رائیڈر', 'as_customer.cs':'دکان', 'as_customer.sup_c':'Wanhar Mart سپورٹ',
      'as_rider.cr':'گاہک', 'as_rider.rs':'دکان', 'as_rider.sup_r':'Wanhar Mart سپورٹ',
      'as_shop.cs':'گاہک', 'as_shop.rs':'رائیڈر', 'as_shop.sup_s':'Wanhar Mart سپورٹ',
      sup:'سپورٹ',
      q_customer_cr:['مجھے کال کریں','میں نیچے آ رہا ہوں','دروازے پر رکھ دیں','آپ ابھی کہاں ہیں؟'],
      q_customer_cs:['میرا آرڈر کتنی دیر میں تیار ہوگا؟','مرچ کم رکھیں','ساس زیادہ ڈال دیں','اچھی طرح پیک کریں'],
      q_customer_sup:['میرا آرڈر لیٹ ہے','میرے آرڈر میں مسئلہ ہے','غلط یا کم چیزیں آئیں','میں آرڈر منسوخ کرنا چاہتا ہوں','مجھے کال کریں'],
      q_rider_cr:['میں راستے میں ہوں','میں پہنچ گیا ہوں، براہ کرم باہر آئیں','آپ کا پتہ نہیں مل رہا، مجھے کال کریں','براہ کرم نقد رقم تیار رکھیں'],
      q_rider_rs:['میں دکان پر ہوں، آرڈر تیار ہے؟','میں 5 منٹ میں پہنچ رہا ہوں','آرڈر اچھی طرح پیک کریں','میں باہر انتظار کر رہا ہوں'],
      q_rider_sup:['گاہک فون نہیں اٹھا رہا','ایک آرڈر میں مدد چاہیے','میری گاڑی میں مسئلہ ہے','میری اجرت کے بارے میں سوال','مجھے کال کریں'],
      q_shop_cs:['آپ کا آرڈر تیار ہو رہا ہے','آپ کا آرڈر تیار ہے','معذرت، ایک چیز دستیاب نہیں','10 منٹ مزید لگیں گے'],
      q_shop_rs:['آرڈر تیار ہے، آ جائیں','10 منٹ میں تیار ہوگا','آپ کہاں ہیں؟','جلدی آئیں، میں انتظار کر رہا ہوں'],
      q_shop_sup:['ایک آرڈر میں مسئلہ ہے','میری ادائیگی کب ملے گی؟','رائیڈر لیٹ ہے','مجھے کال کریں'],
      q_admin:['ہم دیکھ رہے ہیں','انتظار کا شکریہ','براہ کرم ہمیں کال کریں'],
      ask_join:'Wanhar Mart کو بلائیں', ask_reason:'Wanhar Mart کو مسئلہ بتائیں (مثلاً: گاہک نے کم رقم دی):', ask_sent:'Wanhar Mart کو اس چیٹ میں بلا لیا گیا',
      sys_req:'{w} نے Wanhar Mart کو چیٹ میں بلایا', sys_joined:'Wanhar Mart چیٹ میں شامل ہو گیا۔ براہ کرم مسئلہ بتائیں۔'
    }
  };
  let cfg = null, cur = null, chan = null, seenIds = new Set(), unread = {};
  const lang = () => (cfg && cfg.lang && cfg.lang()) === 'ur' ? 'ur' : 'en';
  const tr = k => (L[lang()][k] !== undefined ? L[lang()][k] : L.en[k] !== undefined ? L.en[k] : k);
  const e = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const me = () => cfg && cfg.me && cfg.me();
  const keyOf = m => (m.order_id || '') + '|' + m.thread + '|' + (m.user_id || '');
  const seenTs = k => { try { return localStorage.getItem('wm_chat_' + k) || ''; } catch (x) { return ''; } };
  const setSeen = (k, ts) => { try { if (ts > seenTs(k)) localStorage.setItem('wm_chat_' + k, ts); } catch (x) {} };
  const hm = ts => new Date(ts).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
  function label(thread, orderId, name){
    const base = thread === 'sup' ? (cfg.role === 'admin' ? tr('sup') + (name ? ': ' + name : '') : tr('support')) : tr('as_' + cfg.role + '.' + thread);
    return base + (orderId ? ' · #' + String(orderId).slice(-4).toUpperCase() : '');
  }
  if (!document.getElementById('chatCss')){
    const st = document.createElement('style'); st.id = 'chatCss';
    st.textContent = `.cbtn{position:relative;display:grid;place-items:center;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;flex:none;font-size:19px}
.cbtn .cn{position:absolute;top:-4px;inset-inline-end:-4px;background:#B3261E;color:#fff;font-size:11px;font-weight:800;min-width:19px;height:19px;border-radius:10px;display:none;place-items:center;padding:0 4px}
.chatwrap{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center}
.chatbox{background:var(--paper);width:100%;max-width:640px;height:92%;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden}
.chathead{display:flex;align-items:center;gap:10px;padding:14px 14px 12px;background:var(--surface);border-bottom:1px solid var(--line)}
.chathead b{flex:1;font-size:18px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chathead button{background:none;border:0;font-size:26px;cursor:pointer;color:var(--muted);padding:2px 8px}
.chatlist{flex:1;overflow:auto;padding:12px}
.chatrow{display:flex;gap:12px;align-items:center;width:100%;text-align:start;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:8px;cursor:pointer;color:inherit}
.chatrow .av{width:42px;height:42px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-weight:800;flex:none}
.chatrow .tx{flex:1;min-width:0}.chatrow .tx div{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chatrow .ub{background:#B3261E;color:#fff;border-radius:10px;font-size:12px;font-weight:800;padding:1px 8px}
.msgs{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:6px}
.bub{max-width:80%;padding:8px 12px;border-radius:14px;background:var(--surface);border:1px solid var(--line);align-self:flex-start;word-wrap:break-word;white-space:pre-wrap}
.sysmsg{align-self:center;max-width:90%;text-align:center;background:rgba(242,169,0,.18);border-radius:12px;padding:8px 12px;font-size:14px;font-weight:700}
.sysmsg small{display:block;font-weight:400;opacity:.7;font-size:11px}
.askbtn{border:1px solid #B3261E !important;color:#B3261E !important;background:transparent;border-radius:999px;font-size:13px !important;font-weight:800;padding:6px 10px !important;white-space:nowrap}
.bub.mine{align-self:flex-end;background:var(--green);color:#fff;border-color:var(--green)}
.bub small{display:block;font-size:11px;opacity:.7;margin-top:2px}
.bub .who{font-size:12px;font-weight:800;color:var(--green);display:block}
.quick{display:flex;gap:6px;overflow-x:auto;padding:8px 12px 0}
.quick button{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 12px;font-size:13px;cursor:pointer;color:inherit}
.chatin{display:flex;gap:8px;padding:10px 12px calc(12px + env(safe-area-inset-bottom,0px));background:var(--surface);border-top:1px solid var(--line)}
.chatin textarea{flex:1;min-height:44px;max-height:120px;resize:none;border:1px solid var(--line);border-radius:12px;padding:10px;font:inherit;background:var(--paper);color:var(--ink)}
.chatin button{border:0;background:var(--green);color:#fff;border-radius:12px;padding:0 18px;font-weight:800;cursor:pointer}`;
    document.head.appendChild(st);
  }
  function button(){ return `<button class="cbtn" onclick="Chat.inbox()" aria-label="${e(tr('messages'))}">💬<span class="cn" id="chatN"></span></button>`; }
  function paintBadge(){
    const n = Object.values(unread).reduce((a, b) => a + b, 0);
    document.querySelectorAll('#chatN').forEach(el => { el.textContent = n; el.style.display = n ? 'grid' : 'none'; });
    if (cfg && cfg.onUnread) cfg.onUnread(n);
  }
  function init(c){
    cfg = c; stop();
    chan = sb.channel('chat-' + me()).on('postgres_changes', { event:'INSERT', schema:'public', table:'messages' }, p => onMsg(p.new)).subscribe();
    refresh();
  }
  function stop(){ if (chan){ try { sb.removeChannel(chan); } catch (x) {} chan = null; } }
  async function refresh(){
    if (!me()) return;
    const since = new Date(Date.now() - 7 * 864e5).toISOString();
    const { data } = await sb.from('messages').select('id,order_id,thread,user_id,sender_id,created_at').gte('created_at', since).neq('sender_id', me()).order('created_at', { ascending:false }).limit(400);
    unread = {};
    (data || []).forEach(m => { seenIds.add(m.id); const k = keyOf(m); if (m.created_at > seenTs(k) && (!cur || cur.k !== k)) unread[k] = (unread[k] || 0) + 1; });
    paintBadge();
  }
  function onMsg(m){
    if (!m || seenIds.has(m.id)) return; seenIds.add(m.id);
    const k = keyOf(m);
    if (cur && cur.k === k){ if (!cur.msgs.some(x => x.id === m.id)) cur.msgs.push(m); draw(); setSeen(k, m.created_at); return; }
    if (m.sender_id !== me()){
      unread[k] = (unread[k] || 0) + 1; paintBadge();
      if (cfg.ding) cfg.ding();
      if (cfg.toast) cfg.toast('💬 ' + tr('new_msg') + ': ' + fmt(m).slice(0, 70));
      if ($('inboxList')) inbox();
    }
  }
  function shell(title, inner, extra){
    close();
    const w = document.createElement('div'); w.className = 'chatwrap'; w.id = 'chatWrap';
    w.addEventListener('click', ev => { if (ev.target === w) close(); });
    w.innerHTML = `<div class="chatbox" role="dialog" aria-modal="true"><div class="chathead"><b>${e(title)}</b>${extra || ''}<button onclick="Chat.close()" aria-label="Close">&times;</button></div>${inner}</div>`;
    document.body.appendChild(w);
  }
  function close(){ cur = null; const w = document.getElementById('chatWrap'); if (w) w.remove(); }
  async function inbox(){
    const since = new Date(Date.now() - 14 * 864e5).toISOString();
    const { data } = await sb.from('messages').select('*').gte('created_at', since).order('created_at', { ascending:false }).limit(cfg.role === 'admin' ? 800 : 300);
    const groups = {};
    (data || []).forEach(m => { const k = keyOf(m); if (!groups[k]) groups[k] = { k, last:m, order_id:m.order_id, thread:m.thread, user_id:m.user_id }; });
    let names = {};
    const uids = [...new Set(Object.values(groups).filter(g => g.user_id).map(g => g.user_id))];
    if (cfg.role === 'admin' && uids.length){ const p = await sb.from('profiles').select('id,full_name,role').in('id', uids); (p.data || []).forEach(x => { names[x.id] = (x.full_name || '') + ' (' + x.role + ')'; }); }
    const rows = Object.values(groups).map(g => {
      const n = unread[g.k] || 0; const title = label(g.thread, g.order_id, names[g.user_id]);
      return `<button class="chatrow" onclick='Chat.open(${e(JSON.stringify(g.order_id))}, ${e(JSON.stringify(g.thread))}, ${e(JSON.stringify(g.user_id))}, ${e(JSON.stringify(title))})'>
        <span class="av">${g.thread.startsWith('sup') ? '★' : e(title[0])}</span>
        <span class="tx"><div><b>${e(title)}</b></div><div class="muted" style="font-size:14px">${g.last.sender_id === me() && g.last.sender_role !== 'system' ? e(tr('you')) + ': ' : ''}${e(fmt(g.last))}</div><div class="muted" style="font-size:12px">${hm(g.last.created_at)}</div></span>
        ${n ? `<span class="ub">${n}</span>` : ''}</button>`;
    }).join('');
    const sup = cfg.role === 'admin' ? '' : `<button class="chatrow" onclick='Chat.open(null, "sup", ${e(JSON.stringify(me()))}, ${e(JSON.stringify(tr('support')))})'><span class="av">★</span><span class="tx"><div><b>${e(tr('support'))}</b></div><div class="muted" style="font-size:14px">${e(tr('support_sub'))}</div></span></button>`;
    if (document.getElementById('inboxList')) document.getElementById('inboxList').innerHTML = sup + (rows || `<div class="muted" style="text-align:center;padding:30px">${e(tr('no_chats'))}</div>`);
    else shell(tr('messages'), `<div class="chatlist" id="inboxList">${sup}${rows || `<div class="muted" style="text-align:center;padding:30px">${e(tr('no_chats'))}</div>`}</div>`);
  }
  async function open(orderId, thread, userId, title){
    const k = (orderId || '') + '|' + thread + '|' + (userId || '');
    cur = { orderId, thread, userId, k, msgs:[] };
    const qk = 'q_' + cfg.role + '_' + (thread.startsWith('sup') ? 'sup' : thread);
    const quick = (L[lang()][qk] || L.en[qk] || []);
    shell(title || label(thread, orderId), `<div class="msgs" id="msgs"><div class="muted" style="text-align:center">…</div></div>
      ${quick.length ? `<div class="quick">${quick.map(q => `<button onclick='Chat.send(${e(JSON.stringify(q))})'>${e(q)}</button>`).join('')}</div>` : ''}
      <div class="chatin"><textarea id="chatText" rows="1" placeholder="${e(tr('write'))}" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();Chat.send();}"></textarea><button onclick="Chat.send()">${e(tr('send'))}</button></div>`,
      (cfg.role !== 'admin' && orderId && ['cr','cs','rs'].includes(thread)) ? `<button class="askbtn" onclick="Chat.askJoin()">🛟 ${e(tr('ask_join'))}</button>` : '');
    cur = { orderId, thread, userId, k, msgs:[] };
    let q = sb.from('messages').select('*').eq('thread', thread).order('created_at').limit(300);
    q = orderId ? q.eq('order_id', orderId) : q.is('order_id', null);
    if (!orderId) q = q.eq('user_id', userId);
    const { data } = await q;
    if (!cur || cur.k !== k) return;
    cur.msgs = data || []; cur.msgs.forEach(m => seenIds.add(m.id));
    draw();
    if (cur.msgs.length) setSeen(k, cur.msgs[cur.msgs.length - 1].created_at);
    delete unread[k]; paintBadge();
  }
  function fmt(m){
    if (m.sender_role !== 'system') return String(m.body);
    const parts = String(m.body).split('|');
    if (parts[0] === 'join_request') return tr('sys_req').replace('{w}', tr(parts[1] || '')) + (parts.slice(2).join('|') ? ': ' + parts.slice(2).join('|') : '');
    if (parts[0] === 'joined') return tr('sys_joined');
    return String(m.body);
  }
  async function askJoin(){
    if (!cur || !cur.orderId) return;
    const reason = prompt(tr('ask_reason'), ''); if (reason === null) return;
    const { error } = await sb.rpc('request_support', { p_order_id:cur.orderId, p_thread:cur.thread, p_reason:reason });
    if (error){ if (cfg.toast) cfg.toast(error.message, true); return; }
    if (cfg.toast) cfg.toast(tr('ask_sent'));
    const k = cur.k; let q = sb.from('messages').select('*').eq('thread', cur.thread).eq('order_id', cur.orderId).order('created_at').limit(300);
    const { data } = await q; if (cur && cur.k === k){ cur.msgs = data || []; cur.msgs.forEach(x => seenIds.add(x.id)); draw(); }
  }
  function draw(){
    const box = document.getElementById('msgs'); if (!box || !cur) return;
    box.innerHTML = cur.msgs.map(m => {
      if (m.sender_role === 'system') return `<div class="sysmsg">🛟 ${e(fmt(m))}<small>${hm(m.created_at)}</small></div>`;
      const mine = m.sender_id === me();
      return `<div class="bub ${mine ? 'mine' : ''}">${mine ? '' : `<span class="who">${e(tr(m.sender_role))}</span>`}${e(m.body)}<small>${hm(m.created_at)}</small></div>`;
    }).join('') || `<div class="muted" style="text-align:center;padding:30px">${e(tr('no_chats'))}</div>`;
    box.scrollTop = box.scrollHeight;
  }
  async function send(text){
    if (!cur) return;
    const ta = document.getElementById('chatText');
    const body = (text || (ta && ta.value) || '').trim(); if (!body) return;
    if (ta && !text) ta.value = '';
    const { data:id, error } = await sb.rpc('send_message', { p_order_id:cur.orderId, p_thread:cur.thread, p_body:body, p_user_id:cur.userId });
    if (error){ if (cfg.toast) cfg.toast(error.message, true); if (ta && !text) ta.value = body; return; }
    const m = { id, order_id:cur.orderId, thread:cur.thread, user_id:cur.userId, sender_id:me(), sender_role:cfg.role, body, created_at:new Date().toISOString() };
    seenIds.add(id); cur.msgs.push(m); draw(); setSeen(cur.k, m.created_at);
  }
  return { init, stop, refresh, button, inbox, open, close, send, label, askJoin };
})();

// ================= PUSH + INSTALL (same code in all four apps) =================
const Push = (() => {
  const VAPID = 'BB7DLfT-2lWO5GdEBRw40xpz0jVcRYmXrjlzn84Z__HZODNrLJueYsar3rEAMUqSOCSVEOHApgJzEDrxLM2z6-E';
  const L = {
    en:{ title:'Turn on notifications', text:'Get new orders, messages and updates even when the app is closed.', on:'Turn on', later:'Later',
         install:'Install app', install_t:'Add to home screen', ios:'On iPhone: tap Share ⬆️ then “Add to Home Screen”, open the app from there, then turn on notifications.',
         done:'Notifications are on', blocked:'Notifications are blocked. Allow them in your browser settings for this site.', fail:'Could not turn on notifications' },
    ur:{ title:'نوٹیفکیشن آن کریں', text:'ایپ بند ہو تب بھی نئے آرڈر، میسج اور اپڈیٹس ملیں گے۔', on:'آن کریں', later:'بعد میں',
         install:'ایپ انسٹال کریں', install_t:'ہوم اسکرین پر لگائیں', ios:'آئی فون پر: Share ⬆️ دبائیں پھر “Add to Home Screen”، وہاں سے ایپ کھولیں، پھر نوٹیفکیشن آن کریں۔',
         done:'نوٹیفکیشن آن ہو گئے', blocked:'نوٹیفکیشن بند ہیں۔ براؤزر کی سیٹنگ میں اس سائٹ کے لیے اجازت دیں۔', fail:'نوٹیفکیشن آن نہیں ہو سکے' }
  };
  let cfg = null, deferred = null;
  const tt = k => (L[(cfg && cfg.lang && cfg.lang()) === 'ur' ? 'ur' : 'en'][k]);
  const supported = () => 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
  const standalone = () => window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
  const isIOS = () => /iphone|ipad|ipod/i.test(navigator.userAgent);
  const b64 = s => { const p = '='.repeat((4 - s.length % 4) % 4); const r = atob((s + p).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from([...r].map(c => c.charCodeAt(0))); };
  const snoozed = () => { try { return Number(localStorage.getItem('kh_push_later') || 0) > Date.now(); } catch (e) { return false; } };

  window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferred = e; show(); });
  window.addEventListener('appinstalled', () => { deferred = null; show(); });

  async function reg(){ return navigator.serviceWorker.register('sw.js'); }
  async function subscribe(){
    const r = await reg(); await navigator.serviceWorker.ready;
    let s = await r.pushManager.getSubscription();
    if (!s) s = await r.pushManager.subscribe({ userVisibleOnly:true, applicationServerKey:b64(VAPID) });
    const j = s.toJSON();
    const { error } = await cfg.sb.rpc('save_push_subscription', { p_endpoint:j.endpoint, p_p256dh:j.keys.p256dh, p_auth:j.keys.auth, p_app:cfg.app });
    if (error) throw error;
  }
  async function turnOn(){
    try {
      const p = await Notification.requestPermission();
      if (p !== 'granted'){ cfg.toast(tt('blocked'), true); hide(); return; }
      await subscribe(); cfg.toast(tt('done')); hide();
    } catch (e) { cfg.toast(tt('fail') + ': ' + (e.message || e), true); }
  }
  async function install(){ if (!deferred) return; deferred.prompt(); try { await deferred.userChoice; } catch (e) {} deferred = null; show(); }
  function later(){ try { localStorage.setItem('kh_push_later', String(Date.now() + 3 * 864e5)); } catch (e) {} hide(); }
  function hide(){ const el = document.getElementById('pushCard'); if (el) el.remove(); }
  function show(){
    hide();
    if (!cfg || !cfg.me() || snoozed()) return;
    const needPush = supported() && Notification.permission === 'default';
    const iosHint = isIOS() && !standalone();
    if (!needPush && !deferred && !iosHint) return;
    const el = document.createElement('div'); el.id = 'pushCard';
    el.setAttribute('role', 'dialog');
    el.style.cssText = 'position:fixed;left:12px;right:12px;bottom:calc(84px + env(safe-area-inset-bottom));z-index:9000;max-width:460px;margin:0 auto;background:var(--surface,#fff);color:var(--ink,#1E2B25);border:1px solid var(--line,#DDE3DB);border-radius:18px;padding:14px 14px 12px;box-shadow:0 12px 32px rgba(0,0,0,.22);font-size:15px';
    const btn = 'border:0;border-radius:12px;padding:11px 14px;font:inherit;font-weight:800;cursor:pointer';
    el.innerHTML = `<div style="display:flex;gap:10px;align-items:flex-start"><div style="font-size:26px;line-height:1">🔔</div><div style="flex:1">
      <b style="font-size:16px">${needPush ? tt('title') : tt('install_t')}</b>
      <div style="color:var(--muted,#66746C);margin-top:2px">${iosHint ? tt('ios') : tt('text')}</div></div></div>
      <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
        ${needPush && !iosHint ? `<button data-a="on" style="${btn};background:var(--green,#1F6F4A);color:#fff;flex:1">${tt('on')}</button>` : ''}
        ${deferred ? `<button data-a="inst" style="${btn};background:var(--marigold,#F2A900);color:#1E2B25;flex:1">${tt('install')}</button>` : ''}
        <button data-a="later" style="${btn};background:transparent;color:var(--muted,#66746C)">${tt('later')}</button></div>`;
    el.addEventListener('click', ev => { const a = ev.target.closest('button') && ev.target.closest('button').dataset.a; if (a === 'on') turnOn(); else if (a === 'inst') install(); else if (a === 'later') later(); });
    document.body.appendChild(el);
  }
  async function init(c){
    cfg = c;
    if (!('serviceWorker' in navigator)) return;
    try { await reg(); } catch (e) { return; }
    // Already allowed before: refresh the saved subscription quietly for this account
    if (supported() && Notification.permission === 'granted'){ try { await subscribe(); } catch (e) {} }
    setTimeout(show, 2500);
  }
  async function logout(){
    try {
      const r = await navigator.serviceWorker.getRegistration(); const sub = r && await r.pushManager.getSubscription();
      if (sub && cfg) await cfg.sb.from('push_subscriptions').delete().eq('endpoint', sub.endpoint);
    } catch (e) {}
    hide();
  }
  return { init, logout, turnOn, show, enabled:() => supported() && Notification.permission === 'granted' };
})();

// ================= PRODUCT OPTIONS EDITOR (Shop app and Admin) =================
const OE = (() => {
  const L = {
    en:{ title:'Options (size, colour, weight, extras)', hint:'Let customers choose things like size, colour, weight or extras. The price you add is on top of the product price.',
         add:'+ Add option group', group:'Group name', group_ph:'Size', required:'Customer must choose', choose:'How many can they pick?', one:'Only 1', upto:'Up to {n}',
         choice:'Choice', choice_ph:'Large', price:'+ Rs', add_choice:'+ Add choice', remove_group:'Remove group', off:'Off', presets:'Quick add:',
         p_size:'Size', p_small:'Small', p_medium:'Medium', p_large:'Large', p_color:'Colour', p_black:'Black', p_white:'White', p_weight:'Weight', p_half:'Half kg', p_one:'1 kg', p_extras:'Extras', p_gift:'Gift wrap',
         need_name:'Write a name for every option group', need_choice:'Every option group needs at least one choice', loading:'Loading options…' },
    ur:{ title:'آپشنز (سائز، رنگ، وزن، اضافی)', hint:'گاہک سائز، رنگ، وزن یا اضافی چیز چن سکیں گے۔ جو قیمت لکھیں گے وہ پروڈکٹ کی قیمت کے اوپر لگے گی۔',
         add:'+ آپشن گروپ شامل کریں', group:'گروپ کا نام', group_ph:'سائز', required:'گاہک کو لازمی چننا ہے', choose:'کتنے چن سکتے ہیں؟', one:'صرف 1', upto:'زیادہ سے زیادہ {n}',
         choice:'چوائس', choice_ph:'بڑا', price:'+ روپے', add_choice:'+ چوائس شامل کریں', remove_group:'گروپ ہٹائیں', off:'بند', presets:'جلدی شامل کریں:',
         p_size:'سائز', p_small:'چھوٹا', p_medium:'درمیانہ', p_large:'بڑا', p_color:'رنگ', p_black:'کالا', p_white:'سفید', p_weight:'وزن', p_half:'آدھا کلو', p_one:'1 کلو', p_extras:'اضافی', p_gift:'گفٹ پیکنگ',
         need_name:'ہر آپشن گروپ کا نام لکھیں', need_choice:'ہر آپشن گروپ میں کم از کم ایک چوائس ہو', loading:'آپشنز لوڈ ہو رہے ہیں…' }
  };
  let sbc = null, lang = () => 'en', groups = [], itemId = null, removed = { groups:[], options:[] };
  const tt = (k, v) => { let s = L[lang() === 'ur' ? 'ur' : 'en'][k] || k; if (v) for (const x in v) s = s.replace('{' + x + '}', v[x]); return s; };
  const e = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  const uid = () => (crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 3 | 8)).toString(16); }));
  function init(c){ sbc = c.sb; lang = c.lang || lang; }
  function html(){ return `<div class="oe"><label class="f" style="margin-bottom:2px">${tt('title')}</label><div class="muted" style="font-size:13px">${tt('hint')}</div><div id="oeBody"><div class="muted">${tt('loading')}</div></div></div>`; }
  async function load(id){
    itemId = id || null; groups = []; removed = { groups:[], options:[] };
    if (id){
      const { data, error } = await sbc.from('menu_option_groups').select('id,name,min_select,max_select,sort_order,created_at,menu_options(id,name,price,is_available,sort_order)').eq('menu_item_id', id).order('sort_order').order('created_at');
      if (error) throw error;
      groups = (data || []).map(g => ({ id:g.id, name:g.name, min:g.min_select, max:g.max_select, options:(g.menu_options || []).sort((a, b) => a.sort_order - b.sort_order).map(o => ({ id:o.id, name:o.name, price:Number(o.price) || 0, on:o.is_available !== false })) }));
    }
    draw();
  }
  function draw(){
    const el = document.getElementById('oeBody'); if (!el) return;
    const maxOpts = [1, 2, 3, 4, 5, 10];
    el.innerHTML = groups.map((g, gi) => `<div class="oeg" style="border:1px solid var(--line);border-radius:14px;padding:12px;margin-top:10px;background:var(--paper)">
        <div style="display:flex;gap:8px;align-items:end"><div style="flex:1"><label class="f" style="margin-top:0">${tt('group')}</label><input type="text" value="${e(g.name)}" placeholder="${tt('group_ph')}" oninput="OE.set(${gi},'name',this.value)"></div>
          <button type="button" class="linkbtn" style="color:var(--danger);flex:none" onclick="OE.delGroup(${gi})">✕</button></div>
        <label class="check" style="margin-top:8px"><input type="checkbox" ${g.min ? 'checked' : ''} onchange="OE.set(${gi},'min',this.checked ? 1 : 0)"> ${tt('required')}</label>
        <label class="f">${tt('choose')}</label><select onchange="OE.set(${gi},'max',Number(this.value))">${maxOpts.map(n => `<option value="${n}" ${g.max === n ? 'selected' : ''}>${n === 1 ? tt('one') : tt('upto', { n })}</option>`).join('')}</select>
        ${g.options.map((o, oi) => `<div style="display:grid;grid-template-columns:1fr 90px auto auto;gap:6px;align-items:center;margin-top:8px">
            <input type="text" value="${e(o.name)}" placeholder="${tt('choice_ph')}" aria-label="${tt('choice')}" oninput="OE.setO(${gi},${oi},'name',this.value)">
            <input type="number" min="0" inputmode="decimal" value="${o.price || ''}" placeholder="${tt('price')}" aria-label="${tt('price')}" oninput="OE.setO(${gi},${oi},'price',Number(this.value)||0)">
            <label style="font-size:12px;display:flex;align-items:center;gap:3px;white-space:nowrap" title="${tt('off')}"><input type="checkbox" ${o.on ? '' : 'checked'} onchange="OE.setO(${gi},${oi},'on',!this.checked)">${tt('off')}</label>
            <button type="button" class="linkbtn" style="color:var(--danger)" onclick="OE.delO(${gi},${oi})">✕</button></div>`).join('')}
        <button type="button" class="linkbtn" style="margin-top:6px" onclick="OE.addO(${gi})">${tt('add_choice')}</button></div>`).join('')
      + `<div style="margin-top:10px"><button type="button" class="btn ghost" onclick="OE.addGroup()">${tt('add')}</button></div>
         <div class="muted" style="font-size:13px;margin-top:8px">${tt('presets')}
           <button type="button" class="linkbtn" onclick="OE.preset('size')">${tt('p_size')}</button>
           <button type="button" class="linkbtn" onclick="OE.preset('color')">${tt('p_color')}</button>
           <button type="button" class="linkbtn" onclick="OE.preset('weight')">${tt('p_weight')}</button>
           <button type="button" class="linkbtn" onclick="OE.preset('extras')">${tt('p_extras')}</button></div>`;
  }
  const opt = (name, price) => ({ id:uid(), name, price:price || 0, on:true });
  function addGroup(){ groups.push({ id:uid(), name:'', min:0, max:1, options:[opt('', 0)] }); draw(); }
  function preset(k){
    if (k === 'size') groups.push({ id:uid(), name:tt('p_size'), min:1, max:1, options:[opt(tt('p_small'), 0), opt(tt('p_medium'), 0), opt(tt('p_large'), 0)] });
    if (k === 'color') groups.push({ id:uid(), name:tt('p_color'), min:1, max:1, options:[opt(tt('p_black'), 0), opt(tt('p_white'), 0)] });
    if (k === 'weight') groups.push({ id:uid(), name:tt('p_weight'), min:1, max:1, options:[opt(tt('p_half'), 0), opt(tt('p_one'), 0)] });
    if (k === 'extras') groups.push({ id:uid(), name:tt('p_extras'), min:0, max:3, options:[opt(tt('p_gift'), 0)] });
    draw();
  }
  function delGroup(gi){ const g = groups[gi]; if (!g) return; removed.groups.push(g.id); groups.splice(gi, 1); draw(); }
  function addO(gi){ groups[gi].options.push(opt('', 0)); draw(); }
  function delO(gi, oi){ const o = groups[gi].options[oi]; removed.options.push(o.id); groups[gi].options.splice(oi, 1); draw(); }
  function set(gi, k, v){ groups[gi][k] = v; }
  function setO(gi, oi, k, v){ groups[gi].options[oi][k] = v; }
  function check(){
    for (const g of groups){
      g.name = (g.name || '').trim(); g.options = g.options.filter(o => (o.name || '').trim());
      if (!g.name) throw new Error(tt('need_name'));
      if (!g.options.length) throw new Error(tt('need_choice'));
    }
  }
  async function save(id){
    const need = r => { if (r.error) throw r.error; return r.data; };
    check();
    if (removed.groups.length) need(await sbc.from('menu_option_groups').delete().in('id', removed.groups));
    if (removed.options.length) need(await sbc.from('menu_options').delete().in('id', removed.options));
    if (!groups.length) return;
    need(await sbc.from('menu_option_groups').upsert(groups.map((g, i) => ({ id:g.id, menu_item_id:id, name:g.name, min_select:Math.min(g.min, g.max), max_select:g.max, sort_order:i }))));
    const rows = []; groups.forEach(g => g.options.forEach((o, i) => rows.push({ id:o.id, group_id:g.id, name:o.name.trim(), price:Math.max(0, Number(o.price) || 0), is_available:o.on, sort_order:i })));
    if (rows.length) need(await sbc.from('menu_options').upsert(rows));
    removed = { groups:[], options:[] };
  }
  return { init, html, load, save, addGroup, delGroup, addO, delO, set, setO, preset };
})();

// ================= LEGAL + DELETE ACCOUNT (Customer, Rider, Shop) =================
const Legal = (() => {
  const L = {
    en:{ agree:'By creating an account you agree to our {t} and {p}.', terms:'Terms', privacy:'Privacy Policy', links:'Privacy Policy and Terms',
         del:'Delete my account', del_q:'Delete your account? We will remove your personal data. Your past orders stay in our records without your name. This cannot be undone.',
         del_reason:'Why are you leaving? (optional)', del_done:'Request sent. Wanhar Mart will delete your account within 7 days.' },
    ur:{ agree:'اکاؤنٹ بنا کر آپ ہماری {t} اور {p} سے اتفاق کرتے ہیں۔', terms:'شرائط', privacy:'پرائیویسی پالیسی', links:'پرائیویسی پالیسی اور شرائط',
         del:'میرا اکاؤنٹ ختم کریں', del_q:'اکاؤنٹ ختم کریں؟ آپ کی ذاتی معلومات مٹا دی جائیں گی۔ پرانے آرڈر آپ کے نام کے بغیر ریکارڈ میں رہیں گے۔ یہ واپس نہیں ہو سکتا۔',
         del_reason:'آپ کیوں جا رہے ہیں؟ (اختیاری)', del_done:'درخواست بھیج دی گئی۔ Wanhar Mart سات دن میں اکاؤنٹ ختم کر دے گا۔' }
  };
  const tt = (lang, k) => L[lang === 'ur' ? 'ur' : 'en'][k];
  const url = (lang, part) => 'legal.html?lang=' + (lang === 'ur' ? 'ur' : 'en') + '#' + part;
  function agree(lang){
    return `<div class="muted" style="font-size:13px;margin-top:10px;text-align:center">${tt(lang, 'agree').replace('{t}', `<a href="${url(lang, 'terms')}" target="_blank" rel="noopener">${tt(lang, 'terms')}</a>`).replace('{p}', `<a href="${url(lang, 'privacy')}" target="_blank" rel="noopener">${tt(lang, 'privacy')}</a>`)}</div>`;
  }
  function links(lang){
    return `<a class="btn ghost" style="margin-bottom:10px;display:block;text-align:center;text-decoration:none" href="${url(lang, 'privacy')}" target="_blank" rel="noopener">📄 ${tt(lang, 'links')}</a>
      <button class="btn ghost" style="margin-bottom:10px;color:var(--danger);border-color:var(--danger)" onclick="Legal.del()">🗑️ ${tt(lang, 'del')}</button>`;
  }
  let cfg = null;
  function init(c){ cfg = c; }
  async function del(){
    const lang = cfg.lang();
    if (!confirm(tt(lang, 'del_q'))) return;
    const why = prompt(tt(lang, 'del_reason'), ''); if (why === null) return;
    const { error } = await cfg.sb.rpc('request_account_deletion', { p_note:why || null });
    if (error) return cfg.toast(error.message, true);
    cfg.toast(tt(lang, 'del_done'));
  }
  return { init, agree, links, del };
})();

// ================= REPORTS: Excel and PDF (Shop app and Admin) =================
const Report = (() => {
  let xlsxP = null;
  function loadXlsx(){
    if (window.XLSX) return Promise.resolve(window.XLSX);
    if (!xlsxP) xlsxP = new Promise((res, rej) => { const s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js'; s.onload = () => res(window.XLSX); s.onerror = () => { xlsxP = null; rej(new Error('xlsx')); }; document.head.appendChild(s); });
    return xlsxP;
  }
  function download(blob, name){ const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500); }
  // sheets: [{ name, rows:[[header...], [cells...]] }]
  async function excel(file, sheets){
    try {
      const X = await loadXlsx(); const wb = X.utils.book_new();
      sheets.forEach(sh => { const ws = X.utils.aoa_to_sheet(sh.rows); ws['!cols'] = (sh.rows[0] || []).map((_, i) => ({ wch:Math.min(40, Math.max(10, ...sh.rows.map(r => String(r[i] ?? '').length + 2))) })); X.utils.book_append_sheet(wb, ws, sh.name.slice(0, 31)); });
      X.writeFile(wb, file + '.xlsx');
    } catch (e) {
      // Fallback: CSV opens in Excel too
      const sh = sheets[0]; const csv = sh.rows.map(r => r.map(c => { const v = String(c ?? ''); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }).join(',')).join('\n');
      download(new Blob(['﻿' + csv], { type:'text/csv;charset=utf-8' }), file + '.csv');
    }
  }
  const esc2 = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  // Printable page: title, subtitle, blocks of { heading, rows:[[label, value]] } and optional table { head:[], rows:[[]] }
  function pdf(o){
    const old = document.getElementById('rptWrap'); if (old) old.remove();
    const w = document.createElement('div'); w.id = 'rptWrap';
    w.style.cssText = 'position:fixed;inset:0;z-index:9500;background:rgba(0,0,0,.5);overflow:auto;padding:16px';
    const kv = rows => rows.map(([a, b, bold]) => `<tr${bold ? ' style="font-weight:800;border-top:2px solid #111"' : ''}><td>${esc2(a)}</td><td style="text-align:right">${esc2(b)}</td></tr>`).join('');
    const tbl = t => `<table class="rt"><thead><tr>${t.head.map(h => `<th>${esc2(h)}</th>`).join('')}</tr></thead><tbody>${t.rows.map(r => `<tr>${r.map((c, i) => `<td${i >= (t.numFrom ?? 99) ? ' style="text-align:right"' : ''}>${esc2(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
    w.innerHTML = `<style>
      #rptWrap .pg{max-width:800px;margin:0 auto;background:#fff;color:#111;border-radius:12px;padding:24px;font:14px/1.5 system-ui,sans-serif}
      #rptWrap h1{margin:0;font-size:22px} #rptWrap h2{font-size:16px;margin:18px 0 6px}
      #rptWrap table{width:100%;border-collapse:collapse} #rptWrap td,#rptWrap th{padding:5px 6px;border-bottom:1px solid #ddd;text-align:left;vertical-align:top}
      #rptWrap .rt{font-size:12px} #rptWrap .rt th{background:#f0f3ee}
      #rptWrap .nb{max-width:800px;margin:12px auto 0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
      @media print{body>*:not(#rptWrap){display:none!important}#rptWrap{position:static!important;background:#fff!important;padding:0!important;overflow:visible!important}#rptWrap .nb{display:none!important}#rptWrap .pg{border-radius:0;padding:0}}
    </style>
    <div class="pg"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px"><div><h1>${esc2(o.title)}</h1><div style="color:#555">${esc2(o.subtitle || '')}</div></div>
      <div style="text-align:right"><b style="font-size:18px">Wanhar Mart<span style="color:#F2A900">.</span></b><div style="color:#555;font-size:12px">Kallar Kahar · ${esc2(new Date().toLocaleString('en-GB', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }))}</div></div></div>
      ${(o.blocks || []).map(b => `<h2>${esc2(b.heading)}</h2><table>${kv(b.rows)}</table>`).join('')}
      ${o.table ? `<h2>${esc2(o.table.heading || '')}</h2>${tbl(o.table)}` : ''}
      ${o.note ? `<p style="color:#555;font-size:12px;margin-top:16px">${esc2(o.note)}</p>` : ''}</div>
    <div class="nb"><button class="btn" onclick="window.print()">${esc2(o.printLabel || 'Print or save as PDF')}</button><button class="btn ghost" style="background:#fff" onclick="document.getElementById('rptWrap').remove()">${esc2(o.closeLabel || 'Close')}</button></div>`;
    document.body.appendChild(w);
  }
  return { excel, pdf };
})();

// ================= BACK BUTTON (same code in all four apps) =================
// Phone back button: closes the open popup first, then goes to the main tab, then asks "press back again to exit".
const BackNav = (() => {
  let cfg = null, pushed = 0, internal = 0, armed = false, armTimer = null, pushHash = [];
  const present = () => cfg.overlays.filter(([sel]) => document.querySelector(sel));
  function onMutate(){
    const n = present().length;
    while (pushed < n){ pushHash.push(location.hash); history.pushState({ wmov:pushed + 1 }, '', location.href); pushed++; }
    if (pushed > n){
      const extra = pushed - n; pushed = n;
      const h = pushHash.splice(n).pop();
      // Closed by a button (same page): remove our extra history steps. Closed because the page changed: leave history alone.
      if (h === location.hash && history.state && history.state.wmov){ internal++; history.go(-extra); }
    }
  }
  function guard(){ history.pushState({ wmg:1 }, '', location.href); }
  function onPop(ev){
    if (internal > 0){ internal--; return; }
    const st = ev.state || {};
    const open = present();
    if (open.length){
      // user pressed back while a popup is open: close the top one
      pushed = Math.max(0, pushed - 1); pushHash.pop();
      const [sel, close] = open[open.length - 1];
      try { close ? close() : document.querySelector(sel).remove(); } catch (e) { const el = document.querySelector(sel); if (el) el.remove(); }
      return;
    }
    if (st.wmov){ internal++; history.back(); return; }         // leftover popup step: skip it
    if (!st.wmb) return;                                          // normal page change (hash links) is handled by the app
    if (cfg.back && cfg.back()){ guard(); return; }               // went to main tab / home
    if (armed){ return; }                                         // second press: nothing left, phone closes the app
    armed = true; cfg.toast(cfg.exitMsg());
    clearTimeout(armTimer); armTimer = setTimeout(() => { armed = false; if (history.state && history.state.wmb) guard(); }, 2200);
  }
  function init(c){
    if (cfg) return; cfg = c;
    history.replaceState({ wmb:1 }, '', location.href); guard();
    window.addEventListener('popstate', onPop);
    new MutationObserver(onMutate).observe(document.body, { childList:true });
  }
  return { init };
})();

(async function boot(){
  applyLang();
  try {
    const { data:{ session } } = await sb.auth.getSession();
    if (session) await afterLogin(session.user); else showAuth();
  } catch (e) { logErr(e); showAuth(t('error')); }
})();
</script>
</body>
</html>
