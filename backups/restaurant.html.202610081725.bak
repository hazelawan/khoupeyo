  const base = f => norm(String(f || '').replace(/\.[a-z0-9]{2,5}$/i, ''));

  // ---------- tiny zip + xlsx reader ----------
  async function unzip(buf){
    const dv = new DataView(buf), u8 = new Uint8Array(buf); let e = -1;
    for (let i = buf.byteLength - 22; i >= Math.max(0, buf.byteLength - 70000); i--) if (dv.getUint32(i, true) === 0x06054b50){ e = i; break; }
    if (e < 0) throw new Error('zip');
    const n = dv.getUint16(e + 10, true); let p = dv.getUint32(e + 16, true); const files = {}; const td = new TextDecoder();
    for (let k = 0; k < n && dv.getUint32(p, true) === 0x02014b50; k++){
      const nl = dv.getUint16(p + 28, true), xl = dv.getUint16(p + 30, true), cl = dv.getUint16(p + 32, true);
      files[td.decode(u8.subarray(p + 46, p + 46 + nl))] = { m:dv.getUint16(p + 10, true), size:dv.getUint32(p + 20, true), off:dv.getUint32(p + 42, true) };
      p += 46 + nl + xl + cl;
    }
    const read = async name => {
      const f = files[name]; if (!f) return null;
      const st = f.off + 30 + dv.getUint16(f.off + 26, true) + dv.getUint16(f.off + 28, true); const data = u8.subarray(st, st + f.size);
      if (f.m === 0) return td.decode(data);
      if (f.m !== 8) throw new Error('zip');
      const out = await new Response(new Blob([data]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).arrayBuffer();
      return td.decode(out);
    };
    return { names:Object.keys(files), read };
  }
  const xml = s => new DOMParser().parseFromString(s, 'application/xml');
  const tags = (el, n) => [...el.getElementsByTagNameNS('*', n)];
  const colNo = ref => { const m = /^([A-Z]+)/.exec(ref || ''); if (!m) return -1; let n = 0; for (const ch of m[1]) n = n * 26 + ch.charCodeAt(0) - 64; return n - 1; };
  async function readXlsx(buf){
    const z = await unzip(buf);
    const ssx = await z.read('xl/sharedStrings.xml');
    const shared = ssx ? tags(xml(ssx), 'si').map(si => tags(si, 't').map(x => x.textContent).join('')) : [];
    let path = null;
    try {
      const wb = xml(await z.read('xl/workbook.xml')), rels = xml(await z.read('xl/_rels/workbook.xml.rels'));
      const first = tags(wb, 'sheet')[0]; const rid = first && (first.getAttribute('r:id') || first.getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'id'));
      const rel = tags(rels, 'Relationship').find(r => r.getAttribute('Id') === rid);
      if (rel){ const tg = rel.getAttribute('Target'); path = tg.startsWith('/') ? tg.slice(1) : 'xl/' + tg.replace(/^\.\//, ''); }
    } catch (e) {}
