    note_opt:'مزید تفصیل (اختیاری)', pick_problem:'مسئلہ چنیں', reported:'Wanhar Mart کو اطلاع دے دی گئی', waiting_until:'رائیڈر {t} تک انتظار کرے گا',
    k_customer_unreachable:'گاہک کال نہیں اٹھا رہا', k_customer_absent:'گاہک پتے پر موجود نہیں',
