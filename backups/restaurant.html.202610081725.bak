  function download(blob, name){ const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 3000); }

  // ---------- columns ----------
  const HEAD = ['ID', 'Name', 'Price', 'Old price', 'Section', 'Stock', 'Weight', 'Description', 'Keywords', 'Barcode', 'Photo'];
  const ALIAS = { id:['id','productid'], name:['name','product','productname','item','itemname','naam'], price:['price','rate','saleprice','sellingprice','qeemat','priceRs'.toLowerCase()],
    old:['oldprice','mrp','compareprice','pricebeforediscount','originalprice','retailprice','cutprice'], section:['section','category','group','department'], stock:['stock','qty','quantity','stockqty'],
    weight:['weight','weightkg','wt'], desc:['description','detail','details','desc'], kw:['keywords','keyword','tags','tag','searchwords','search','otherwords'], bc:['barcode','ean','upc','barcodeno','sku'], photo:['photo','image','picture','pic','photofile','imagefile','img'] };
  const key = h => String(h ?? '').toLowerCase().replace(/[^a-z]/g, '');
  function headerMap(row){ const m = {}; row.forEach((h, i) => { const k = key(h); for (const f in ALIAS) if (m[f] === undefined && ALIAS[f].includes(k)) m[f] = i; }); return m.name !== undefined && m.price !== undefined ? m : null; }
  const numv = v => { const s = String(v ?? '').replace(/rs\.?|pkr|,|\s/gi, ''); if (s === '') return null; const n = Number(s); return isFinite(n) ? n : NaN; };
  function kgv(v){ const s = String(v ?? '').trim().toLowerCase().replace(/,/g, ''); if (!s) return null; const m = /^([\d.]+)\s*(kg|kgs|kilo|g|gm|gms|gram|grams|grm)?$/.exec(s); if (!m) return NaN; const n = Number(m[1]); if (!isFinite(n)) return NaN; return Math.round((m[2] && m[2][0] === 'g' ? n / 1000 : n) * 1000) / 1000; }
  const kgText = kg => !kg ? '' : kg < 1 ? Math.round(kg * 1000) + 'g' : (Math.round(kg * 1000) / 1000) + 'kg';

  async function loadShop(){
    const id = C.shopId(); if (!id || id === 'all') throw new Error(t('choose_shop'));
    const [c, i] = await Promise.all([C.sb.from('menu_categories').select('id,name,sort_order').eq('restaurant_id', id).order('sort_order'),
      C.sb.from('menu_items').select('id,name,price,compare_price,category_id,stock_qty,weight_kg,description,keywords,barcode,photo_url,sort_order').eq('restaurant_id', id).order('sort_order').order('name').limit(5000)]);
    if (c.error) throw c.error; if (i.error) throw i.error;
    return { id, cats:c.data || [], items:i.data || [] };
  }
  // ---------- open ----------
  function open(){
    if (!C.shopId() || C.shopId() === 'all') return C.toast(t('choose_shop'), true);
    S = { rows:null, files:[] };
    C.openSheet(t('title'), `<div class="bk">
      <div class="bkst"><b class="bkn">1</b><div><b>${t('s1')}</b><small>${t('s1d')}</small><button type="button" class="btn ghost small bkbtn" id="bkDl" onclick="Bulk.template()">${t('dl')}</button></div></div>
      <div class="bkst"><b class="bkn">2</b><div><b>${t('s2')}</b><small>${t('s2d')}</small></div></div>
      <div class="bkst"><b class="bkn">3</b><div><b>${t('s3')}</b>
        <label class="bkfile"><span id="bkSheetL">${t('pick')}</span><input type="file" accept=".xlsx,.csv,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" hidden onchange="Bulk.pickSheet(this)"></label>
        <label class="bkfile"><span id="bkPicsL">${t('pics')}</span><input type="file" accept="image/*" multiple hidden onchange="Bulk.pickPhotos(this)"></label>
        <small>${t('picsd')}</small></div></div>
      <div id="bkPrev"></div></div>`);
  }
  async function template(){
    const b = $('bkDl'); if (b) b.disabled = true;
    try {
      const sh = await loadShop(); const cat = id => (sh.cats.find(c => c.id === id) || {}).name || '';
      let rows = sh.items.map(i => [i.id, i.name, Number(i.price), i.compare_price != null ? Number(i.compare_price) : '', cat(i.category_id), i.stock_qty != null ? Number(i.stock_qty) : '', kgText(Number(i.weight_kg || 0)), i.description || '', i.keywords || '', i.barcode || '', '']);
      if (!rows.length) rows = [['', 'Dalda Ghee 1kg', 560, 590, 'Ghee & Oil', 40, '1kg', '', 'dalda.jpg'], ['', 'Tapal Danedar 450g', 720, '', 'Tea', 25, '450g', 'Strong tea', ''], ['', 'Chicken Karahi (Full)', 1800, '', 'Karahi', '', '', 'Serves 4', '']];
      const help = L() === 'ur' ? [['Wanhar Mart · شیٹ کیسے بھریں'], [''], ['ID — نہ بدلیں۔ نئی پروڈکٹ کے لیے خالی چھوڑ دیں۔'], ['Name — پروڈکٹ کا نام (ضروری)'], ['Price — بیچنے کی قیمت، صرف نمبر (ضروری)'], ['Old price — رعایت سے پہلے کی قیمت (اختیاری)'], ['Section — جیسے Tea، Ghee & Oil۔ نیا نام لکھیں تو نیا سیکشن بن جائے گا'], ['Stock — کتنے ہیں۔ خالی = کوئی حد نہیں۔ 0 = ختم ہے'], ['Weight — جیسے 500g یا 1kg (اختیاری)'], ['Description — تفصیل (اختیاری)'], ['Keywords — تلاش کے دوسرے نام، کومے سے الگ، جیسے: doodh, milk, دودھ (اختیاری)'], ['Barcode — پیکٹ پر لکھا بارکوڈ نمبر (اختیاری)'], ['Photo — تصویر کی فائل کا نام جیسے dalda.jpg، یا تصویر کا لنک (اختیاری)'], [''], ['ایک لائن = ایک پروڈکٹ۔ پہلی لائن نہ بدلیں۔ قیمت بدلنی ہو تو یہی شیٹ دوبارہ ڈاؤن لوڈ کریں، قیمت بدلیں اور اپ لوڈ کر دیں۔']]
        : [['Wanhar Mart · How to fill this sheet'], [''], ['ID — do not change. Leave empty for a new product.'], ['Name — product name (needed)'], ['Price — selling price, numbers only (needed)'], ['Old price — price before discount (optional)'], ['Section — like Tea, Ghee & Oil. A new name makes a new section'], ['Stock — how many you have. Empty = no limit. 0 = out of stock'], ['Weight — like 500g or 1kg (optional)'], ['Description — (optional)'], ['Keywords — other names people search, with commas, like: doodh, milk, دودھ (optional)'], ['Barcode — the barcode number on the pack (optional)'], ['Photo — photo file name like dalda.jpg, or a link to the photo (optional)'], [''], ['One line = one product. Do not change the first line. To change prices later, download this sheet again, change the prices and upload it.']];
      download(xlsxBlob([{ name:'Products', head:true, rows:[HEAD].concat(rows), widths:[10, 34, 10, 11, 18, 9, 10, 30, 18] }, { name:'Help', rows:help, widths:[110] }]),
        'wanhar-products-' + new Date().toISOString().slice(0, 10) + '.xlsx');
    } catch (e) { C.toast(e.message || 'Error', true); }
    if (b) b.disabled = false;
  }
  async function pickSheet(inp){
    const f = inp.files && inp.files[0]; if (!f) return;
    $('bkSheetL').textContent = '📊 ' + f.name; const pv = $('bkPrev'); pv.innerHTML = `<div class="muted" style="margin-top:12px">${t('reading')}</div>`;
    try {
      let rows;
      if (/\.xls$/i.test(f.name)) throw new Error(t('xls'));
      if (/\.csv$/i.test(f.name) || f.type === 'text/csv') rows = readCsv(await f.text());
      else rows = await readXlsx(await f.arrayBuffer());
      S.raw = rows; await build();
    } catch (e) { pv.innerHTML = `<div class="bkerr">${esc(e.message === 'zip' ? t('xls') : e.message)}</div>`; }
    inp.value = '';
  }
  async function pickPhotos(inp){
    S.files = [...(inp.files || [])]; $('bkPicsL').textContent = '🖼️ ' + S.files.length + ' ✓'; inp.value = '';
    if (S.raw) await build();
  }
  async function build(){
    const pv = $('bkPrev'); const rows = S.raw || [];
    let hi = -1, m = null; for (let i = 0; i < Math.min(6, rows.length); i++){ m = headerMap(rows[i] || []); if (m){ hi = i; break; } }
    if (!m) { pv.innerHTML = `<div class="bkerr">${t('nohead')}</div>`; return; }
    const sh = await loadShop(); S.shop = sh;
    const byId = new Map(sh.items.map(i => [i.id, i])), byName = new Map(sh.items.map(i => [norm(i.name), i]));
    const catByName = new Map(sh.cats.map(c => [norm(c.name), c])), catName = id => (sh.cats.find(c => c.id === id) || {}).name || '';
    const files = new Map(); S.files.forEach(f => { files.set(norm(f.name), f); files.set(base(f.name), f); });
    const seen = new Set(); const out = [];
    for (let r = hi + 1; r < rows.length && out.length < 5000; r++){
      const row = rows[r] || []; const g = k => m[k] === undefined ? undefined : String(row[m[k]] ?? '').trim();
      if (!row.some(x => String(x ?? '').trim())) continue;
      const it = { line:r + 1, name:g('name') || '', errs:[], warns:[] };
      const price = numv(g('price'));
      if (!it.name) it.errs.push(t('e_name'));
      if (price === null || isNaN(price) || price < 0) it.errs.push(t('e_price'));
      const nk = norm(it.name); if (it.name && seen.has(nk)) it.errs.push(t('e_dup')); seen.add(nk);
      const idv = g('id'); const ex = (idv && byId.get(idv)) || byName.get(nk) || null;
      it.ex = ex; it.price = price;
      const old = numv(g('old')); it.old = m.old === undefined ? undefined : (old === null || isNaN(old) || old <= 0 ? null : old);
      let st = numv(g('stock')); it.stock = m.stock === undefined ? undefined : (st === null || isNaN(st) ? null : Math.max(0, Math.round(st)));
      const kg = kgv(g('weight')); it.kg = m.weight === undefined ? undefined : (kg === null || isNaN(kg) ? 0 : kg);
      it.desc = m.desc === undefined ? undefined : (g('desc') || null);
      it.kw = m.kw === undefined ? undefined : (String(g('kw') || '').slice(0, 300) || null);
      it.bc = m.bc === undefined ? undefined : (String(g('bc') || '').replace(/\.0+$/, '').trim().slice(0, 64) || null);
      it.section = g('section') || (ex ? catName(ex.category_id) : '') || '';
      if (!it.section){ it.section = t('other'); it.warns.push(t('w_sec')); }
      it.cat = catByName.get(norm(it.section)) || null;
      const ph = g('photo') || '';
      if (/^https?:\/\//i.test(ph)) it.photoUrl = ph;
      else { const f = (ph && (files.get(norm(ph)) || files.get(base(ph)))) || files.get(nk); if (f) it.file = f; else if (ph && S.files.length) it.warns.push(t('w_photo', { f:ph })); }
      if (it.errs.length) it.status = 'bad';
      else if (!ex) it.status = 'new';
      else {
        const ch = Number(ex.price) !== price || (it.old !== undefined && (ex.compare_price == null ? null : Number(ex.compare_price)) !== it.old)
          || (it.stock !== undefined && (ex.stock_qty == null ? null : Number(ex.stock_qty)) !== it.stock) || (it.kg !== undefined && Number(ex.weight_kg || 0) !== it.kg)
          || (it.desc !== undefined && (ex.description || null) !== it.desc) || (it.kw !== undefined && (ex.keywords || null) !== it.kw) || (it.bc !== undefined && (ex.barcode || null) !== it.bc) || norm(catName(ex.category_id)) !== norm(it.section) || ex.name !== it.name || !!it.file || (it.photoUrl && it.photoUrl !== ex.photo_url);
        it.status = ch ? 'upd' : 'same';
      }
      out.push(it);
    }
    S.rows = out; drawPrev();
  }
  function drawPrev(){
    const pv = $('bkPrev'); const R = S.rows || [];
    if (!R.length){ pv.innerHTML = `<div class="bkerr">${t('empty')}</div>`; return; }
    const c = k => R.filter(r => r.status === k).length; const todo = c('new') + c('upd');
    const pics = R.filter(r => r.file || r.photoUrl).length;
    const badge = { new:'🆕', upd:'🔄', same:'➖', bad:'⚠️' };
    const line = r => `<div class="bkrow ${r.status}"><span class="bki">${badge[r.status]}</span><div><b>${esc(r.name || '—')}</b><small>${t('line', { n:r.line })}${r.price != null && !isNaN(r.price) ? ' · Rs ' + Math.round(r.price) : ''} · ${esc(r.section)}${r.stock != null ? ' · 📦 ' + r.stock : ''}${r.file || r.photoUrl ? ' · 🖼️' : ''}</small>${r.errs.concat(r.warns).map(x => `<small class="${r.errs.includes(x) ? 'e' : 'w'}">${esc(x)}</small>`).join('')}</div></div>`;
    const bad = R.filter(r => r.status === 'bad'), warn = R.filter(r => r.status !== 'bad' && r.warns.length), rest = R.filter(r => r.status !== 'bad' && !r.warns.length && r.status !== 'same');
    const shown = bad.concat(warn).concat(rest.slice(0, 40)); const hidden = bad.length + warn.length + rest.length - shown.length;
    pv.innerHTML = `<div class="bksum"><span>🆕 ${t('newp')} <b>${c('new')}</b></span><span>🔄 ${t('upd')} <b>${c('upd')}</b></span><span>➖ ${t('same')} <b>${c('same')}</b></span>${c('bad') ? `<span class="e">⚠️ ${t('bad')} <b>${c('bad')}</b></span>` : ''}${S.files.length ? `<span>🖼️ ${t('photos')} <b>${pics}</b></span>` : ''}</div>
      ${c('bad') ? `<div class="muted" style="font-size:13px">${t('skip')}</div>` : ''}
      <div class="bklist">${shown.map(line).join('')}${hidden > 0 ? `<div class="muted" style="padding:8px">${t('more', { n:hidden })}</div>` : ''}</div>
      ${todo ? `<button type="button" class="btn bkbtn" id="bkSave" onclick="Bulk.save()">${t('save', { n:todo })}</button>` : `<div class="note">${t('none')}</div>`}`;
  }
  async function save(){
    const R = (S.rows || []).filter(r => r.status === 'new' || r.status === 'upd'); if (!R.length) return;
    const pv = $('bkPrev'); const sh = S.shop; const fails = [];
    const prog = (a, b) => { pv.innerHTML = `<div class="bkprog"><div>${t('saving', { a, b })}</div><i><b style="width:${Math.round(a / Math.max(1, b) * 100)}%"></b></i></div>`; };
    const total = R.length; let done = 0; prog(0, total);
    try {
      // 1. sections
      const need = []; R.forEach(r => { if (!r.cat && !need.some(n => norm(n) === norm(r.section))) need.push(r.section); });
      if (need.length){
        let so = sh.cats.reduce((n, c) => Math.max(n, Number(c.sort_order) || 0), 0);
        const { data, error } = await C.sb.from('menu_categories').insert(need.map(n => ({ restaurant_id:sh.id, name:n.slice(0, 60), sort_order:++so }))).select('id,name');
        if (error) throw error;
        (data || []).forEach(c => sh.cats.push(c));
        R.forEach(r => { if (!r.cat) r.cat = sh.cats.find(c => norm(c.name) === norm(r.section)) || null; });
      }
      // 2. photos
      const up = new Map();
      for (const r of R){ if (r.file){ try { if (!up.has(r.file)) up.set(r.file, await C.uploadImage(r.file, 'items')); r.photoUrl = up.get(r.file); } catch (e) { r.warns.push(String(e.message || e)); } } }
      // 3. new products, 100 at a time
      let so = sh.items.reduce((n, i) => Math.max(n, Number(i.sort_order) || 0), 0);
      const news = R.filter(r => r.status === 'new');
      for (let i = 0; i < news.length; i += 100){
        const part = news.slice(i, i + 100);
        const rows = part.map(r => { const o = { restaurant_id:sh.id, category_id:r.cat ? r.cat.id : null, name:r.name.slice(0, 120), price:r.price, compare_price:r.old ?? null, stock_qty:r.stock ?? null, weight_kg:r.kg || 0, description:r.desc ?? null, keywords:r.kw ?? null, barcode:r.bc ?? null, photo_url:r.photoUrl || null, is_available:r.stock !== 0, sort_order:++so }; if (C.isAdmin) o.is_approved = true; return o; });
        const { error } = await C.sb.from('menu_items').insert(rows);
        if (error){ for (const r of part){ const one = rows[part.indexOf(r)]; const x = await C.sb.from('menu_items').insert(one); if (x.error) fails.push([r, x.error.message]); } }
        done += part.length; prog(done, total);
      }
      // 4. updates
      for (const r of R.filter(x => x.status === 'upd')){
        const o = { name:r.name.slice(0, 120), price:r.price };
        if (r.cat) o.category_id = r.cat.id;
        if (r.old !== undefined) o.compare_price = r.old;
        if (r.stock !== undefined) o.stock_qty = r.stock;
        if (r.kg !== undefined) o.weight_kg = r.kg || 0;
        if (r.desc !== undefined) o.description = r.desc;
        if (r.kw !== undefined) o.keywords = r.kw;
        if (r.bc !== undefined) o.barcode = r.bc;
        if (r.photoUrl) o.photo_url = r.photoUrl;
        const { error } = await C.sb.from('menu_items').update(o).eq('id', r.ex.id);
        if (error) fails.push([r, error.message]);
        done++; if (done % 5 === 0 || done === total) prog(done, total);
      }
    } catch (e) { fails.push([{ line:'—', name:'' }, e.message || String(e)]); }
    const failed = new Set(fails.map(f => f[0])); const general = fails.some(f => !f[0].status);
    const nNew = general ? 0 : R.filter(r => r.status === 'new' && !failed.has(r)).length, nUpd = general ? 0 : R.filter(r => r.status === 'upd' && !failed.has(r)).length;
    pv.innerHTML = `<div class="bkdone">✅ ${t('done', { n:nNew, u:nUpd })}</div>${fails.length ? `<div class="bkerr">${t('donebad', { n:fails.length })}<br>${fails.slice(0, 20).map(f => esc(t('line', { n:f[0].line }) + ' ' + f[0].name + ': ' + f[1])).join('<br>')}</div>` : ''}
      <button type="button" class="btn ghost bkbtn" onclick="Bulk.close()">${t('close')}</button>`;
    S.rows = null; S.raw = null;
    try { await C.onDone(); } catch (e) {}
  }
  // ---------- photo mode ----------
  async function photoMode(){
    if (!C.shopId() || C.shopId() === 'all') return C.toast(t('choose_shop'), true);
    try {
      const sh = await loadShop();
      PM = { list:sh.items.filter(i => !i.photo_url), i:0, cats:sh.cats, done:0 };
      C.openSheet(t('pm'), '<div id="pmBody"></div>'); drawPM();
    } catch (e) { C.toast(e.message || 'Error', true); }
  }
  function drawPM(){
    const el = $('pmBody'); if (!el || !PM) return;
    const it = PM.list[PM.i];
    if (!it){ el.innerHTML = `<div class="bkdone" style="text-align:center;font-size:18px">${t('pmall')}</div><button type="button" class="btn bkbtn" onclick="Bulk.close()">${t('close')}</button>`; return; }
    const cat = (PM.cats.find(c => c.id === it.category_id) || {}).name || '';
    el.innerHTML = `<div class="pm">
      <div class="muted" style="font-size:13px">${t('pmt')} · ${t('of', { a:PM.i + 1, b:PM.list.length })}</div>
      <i class="pmbar"><b style="width:${Math.round(PM.i / PM.list.length * 100)}%"></b></i>
      <div class="pmname">${esc(it.name)}</div><div class="muted">Rs ${Math.round(Number(it.price) || 0)}${cat ? ' · ' + esc(cat) : ''}</div>
      <label class="btn bkbtn">${t('take')}<input type="file" accept="image/*" capture="environment" hidden onchange="Bulk.pmPick(this)"></label>
      <label class="btn ghost bkbtn">${t('gallery')}<input type="file" accept="image/*" hidden onchange="Bulk.pmPick(this)"></label>
      <button type="button" class="link" style="margin-top:10px" onclick="Bulk.pmNext()">${t('skipb')}</button>
      <div class="muted" style="font-size:13px;margin-top:8px">${t('pmtip')}</div></div>`;
  }
  async function pmPick(inp){
    const f = inp.files && inp.files[0]; if (!f || !PM) return; const it = PM.list[PM.i];
    const el = $('pmBody'); if (el) el.innerHTML = `<div class="pm"><div class="pmname">${esc(it.name)}</div><div class="muted">${t('uploading')}</div></div>`;
    try {
      const url = await C.uploadImage(f, 'items');
      const { error } = await C.sb.from('menu_items').update({ photo_url:url }).eq('id', it.id); if (error) throw error;
      PM.done++; C.toast('✓ ' + it.name); pmNext();
    } catch (e) { C.toast(e.message || 'Error', true); drawPM(); }
  }
  function pmNext(){ if (!PM) return; PM.i++; drawPM(); }
  async function close(){ const had = PM && PM.done; C.closeSheet(); PM = null; S = null; if (had) try { await C.onDone(); } catch (e) {} }
  function init(cfg){ C = cfg; }
  return { init, open, template, pickSheet, pickPhotos, save, photoMode, pmPick, pmNext, close, _readXlsx:readXlsx, _readCsv:readCsv, _xlsxBlob:xlsxBlob };
})();
Bulk.init({ get sb(){ return sb; }, shopId:() => state.restaurant && state.restaurant.id, isAdmin:false, lang:() => state.lang, uploadImage:(f, d) => uploadImage(f, d), openSheet:(a, b) => openSheet(a, b), closeSheet:() => closeSheet(), toast:(m, e) => toast(m, e), onDone:async () => { await loadMenu(); renderTab(); } });
// ================= PRODUCT OPTIONS EDITOR (Shop app and Admin) =================
// Sizes, colours, weights and extras. The customer picks them before adding the product to the cart.
const OE = (() => {
  const L = {
    en:{ title:'Sizes, colours and other choices', opt:'optional',
         hint:'Use this when one product comes in different sizes or colours. Example: a shirt in S, M, L, XL. The customer must pick one before adding it to the cart.',
         quick:'Tap to add a ready list:', own:'Make my own list',
         q_cloth:'👕 Clothes size', q_shoe:'👟 Shoe size', q_waist:'👖 Waist size', q_color:'🎨 Colour', q_weight:'⚖️ Weight', q_food:'🍕 Small / Large', q_extras:'➕ Extras',
         group:'What does the customer choose?', group_ph:'Size', required:'Customer must choose one', many:'Customer can choose more than one',
         col_name:'Choice', col_price:'Extra price', col_w:'Extra weight', same:'same price', choice_ph:'XL',
         add_choice:'+ Add another choice', remove_group:'Remove this list', avail:'In stock',
         preview:'Customer sees:', need_name:'Write what the customer chooses (for example: Size)', need_choice:'Every list needs at least one choice', loading:'Loading…',
         cloth:'Size', shoe:'Shoe size', waist:'Waist', color:'Colour', weight:'Weight', food:'Size', extras:'Extras',
         black:'Black', white:'White', blue:'Blue', red:'Red', small:'Small', medium:'Medium', large:'Large', gift:'Gift wrap', del_q:'Remove the list “{n}”?' },
    ur:{ title:'سائز، رنگ اور دوسری چوائسز', opt:'اختیاری',
         hint:'جب ایک ہی پروڈکٹ مختلف سائز یا رنگ میں ہو تو یہ استعمال کریں۔ مثال: شرٹ S، M، L، XL میں۔ گاہک کارٹ میں ڈالنے سے پہلے ایک چنے گا۔',
         quick:'تیار لسٹ کے لیے دبائیں:', own:'اپنی لسٹ بنائیں',
         q_cloth:'👕 کپڑوں کا سائز', q_shoe:'👟 جوتے کا سائز', q_waist:'👖 کمر کا سائز', q_color:'🎨 رنگ', q_weight:'⚖️ وزن', q_food:'🍕 چھوٹا / بڑا', q_extras:'➕ اضافی',
         group:'گاہک کیا چنے گا؟', group_ph:'سائز', required:'گاہک کو ایک چننا لازمی ہے', many:'گاہک ایک سے زیادہ چن سکتا ہے',
         col_name:'چوائس', col_price:'اضافی قیمت', col_w:'اضافی وزن', same:'وہی قیمت', choice_ph:'XL',
         add_choice:'+ ایک اور چوائس', remove_group:'یہ لسٹ ہٹائیں', avail:'دستیاب',
         preview:'گاہک کو یہ دکھے گا:', need_name:'لکھیں گاہک کیا چنے گا (مثلاً: سائز)', need_choice:'ہر لسٹ میں کم از کم ایک چوائس ہو', loading:'لوڈ ہو رہا ہے…',
         cloth:'سائز', shoe:'جوتے کا سائز', waist:'کمر', color:'رنگ', weight:'وزن', food:'سائز', extras:'اضافی',
         black:'کالا', white:'سفید', blue:'نیلا', red:'لال', small:'چھوٹا', medium:'درمیانہ', large:'بڑا', gift:'گفٹ پیک', del_q:'لسٹ “{n}” ہٹائیں؟' }
  };
  let sbc = null, lang = () => 'en', groups = [], itemId = null, removed = { groups:[], options:[] };
  const tt = (k, v) => { let s = L[lang() === 'ur' ? 'ur' : 'en'][k] || k; if (v) for (const x in v) s = s.replace('{' + x + '}', v[x]); return s; };
  const e = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  const uid = () => (crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 3 | 8)).toString(16); }));
  let styled = false;
  function style(){
    if (styled) return; styled = true;
    const s = document.createElement('style');
    s.textContent = `.oe{margin-top:16px;border:1px solid var(--line);border-radius:16px;padding:14px;background:var(--surface)}
.oe .qk{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.oe .qk button{border:1px solid var(--line);background:var(--field,#F1F4F0);color:var(--ink);border-radius:999px;padding:7px 11px;font:inherit;font-size:13px;font-weight:700;cursor:pointer}
.oeg{border:1.5px solid var(--line);border-radius:14px;padding:12px;margin-top:12px;background:var(--paper)}
.oeg .ghead{display:flex;gap:8px;align-items:flex-end}
.oeg .orow{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px;margin-top:8px}
.oeg .orow .r1{display:flex;gap:6px;align-items:center}
.oeg .orow .r2{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:6px}
.oeg .orow small{display:block;font-size:11.5px;color:var(--muted);font-weight:700;margin-bottom:2px}
.oeg .wrow{display:flex;gap:4px} .oeg .wrow select{width:62px;flex:none;padding-inline:6px}
.oeg .pv{margin-top:10px;font-size:13px;color:var(--muted)} .oeg .pv b{color:var(--ink)}
.oeg .pv span{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:3px 9px;margin:3px 3px 0 0;background:var(--surface);color:var(--ink);font-weight:600}
.oeg .x{flex:none;border:0;background:none;color:var(--danger);font-size:20px;cursor:pointer;padding:6px 8px}`;
    document.head.appendChild(s);
  }
  function init(c){ sbc = c.sb; lang = c.lang || lang; style(); }
  function html(){ style(); return `<div class="oe"><b>🧩 ${tt('title')}</b> <span class="muted" style="font-size:13px">(${tt('opt')})</span>
    <div class="muted" style="font-size:13px;margin-top:4px">${tt('hint')}</div><div id="oeBody"><div class="muted">${tt('loading')}</div></div></div>`; }
  async function load(id){
    itemId = id || null; groups = []; removed = { groups:[], options:[] };
    if (id){
      const { data, error } = await sbc.from('menu_option_groups').select('id,name,min_select,max_select,sort_order,created_at,menu_options(id,name,price,is_available,sort_order,weight_kg)').eq('menu_item_id', id).order('sort_order').order('created_at');
      if (error) throw error;
      groups = (data || []).map(g => ({ id:g.id, name:g.name, min:g.min_select, max:g.max_select, options:(g.menu_options || []).sort((a, b) => a.sort_order - b.sort_order)
        .map(o => { const w = Number(o.weight_kg) || 0; return { id:o.id, name:o.name, price:Number(o.price) || 0, w, unit:w && w < 1 ? 'g' : 'kg', on:o.is_available !== false }; }) }));
    }
    draw();
  }
  const wShow = o => o.unit === 'g' ? Math.round(o.w * 1000) : o.w;
  function draw(){
    const el = document.getElementById('oeBody'); if (!el) return;
    el.innerHTML = groups.map((g, gi) => `<div class="oeg">
        <div class="ghead"><div style="flex:1"><label class="f" style="margin-top:0">${tt('group')}</label><input type="text" value="${e(g.name)}" placeholder="${tt('group_ph')}" oninput="OE.set(${gi},'name',this.value);OE.pv(${gi})"></div>
          <button type="button" class="x" title="${tt('remove_group')}" aria-label="${tt('remove_group')}" onclick="OE.delGroup(${gi})">🗑️</button></div>
        <label class="check" style="margin-top:8px"><input type="checkbox" ${g.min ? 'checked' : ''} onchange="OE.set(${gi},'min',this.checked ? 1 : 0)"> ${tt('required')}</label>
        <label class="check"><input type="checkbox" ${g.max > 1 ? 'checked' : ''} onchange="OE.set(${gi},'max',this.checked ? 10 : 1)"> ${tt('many')}</label>
        ${g.options.map((o, oi) => `<div class="orow">
          <div class="r1"><input type="text" value="${e(o.name)}" placeholder="${tt('choice_ph')}" aria-label="${tt('col_name')}" oninput="OE.setO(${gi},${oi},'name',this.value);OE.pv(${gi})" style="flex:1">
            <label class="switch" title="${tt('avail')}"><input type="checkbox" ${o.on ? 'checked' : ''} onchange="OE.setO(${gi},${oi},'on',this.checked);OE.pv(${gi})" aria-label="${tt('avail')}"><span></span></label>
            <button type="button" class="x" aria-label="✕" onclick="OE.delO(${gi},${oi})">✕</button></div>
          <div class="r2"><div><small>${tt('col_price')} (Rs)</small><input type="number" min="0" inputmode="decimal" value="${o.price || ''}" placeholder="0" oninput="OE.setO(${gi},${oi},'price',Number(this.value)||0);OE.pv(${gi})"></div>
            <div><small>${tt('col_w')}</small><div class="wrow"><input type="number" min="0" step="any" inputmode="decimal" value="${o.w ? wShow(o) : ''}" placeholder="0" oninput="OE.setW(${gi},${oi},this.value)">
              <select onchange="OE.setU(${gi},${oi},this.value,this.previousElementSibling.value)"><option value="g" ${o.unit === 'g' ? 'selected' : ''}>g</option><option value="kg" ${o.unit !== 'g' ? 'selected' : ''}>kg</option></select></div></div></div></div>`).join('')}
        <button type="button" class="linkbtn" style="margin-top:8px" onclick="OE.addO(${gi})">${tt('add_choice')}</button>
        <div class="pv" id="oepv${gi}">${pvHtml(g)}</div></div>`).join('')
      + `<div class="muted" style="font-size:13px;margin-top:12px">${tt('quick')}</div>
         <div class="qk">${['cloth', 'shoe', 'waist', 'color', 'weight', 'food', 'extras'].map(k => `<button type="button" onclick="OE.preset('${k}')">${tt('q_' + k)}</button>`).join('')}
           <button type="button" onclick="OE.addGroup()">✏️ ${tt('own')}</button></div>`;
  }
  function pvHtml(g){
    const l = g.options.filter(o => (o.name || '').trim() && o.on);
    if (!l.length) return '';
    return `${tt('preview')} <b>${e(g.name || tt('group_ph'))}</b><br>${l.map(o => `<span>${e(o.name)}${o.price ? ' +Rs ' + o.price : ''}</span>`).join('')}`;
  }
  const opt = (name, price, w, unit) => ({ id:uid(), name, price:price || 0, w:w || 0, unit:unit || 'kg', on:true });
  function addGroup(){ groups.push({ id:uid(), name:'', min:1, max:1, options:[opt('', 0)] }); draw(); }
  function preset(k){
    const P = {
      cloth:[tt('cloth'), 1, 1, ['S', 'M', 'L', 'XL', 'XXL'].map(n => opt(n))],
      shoe:[tt('shoe'), 1, 1, ['6', '7', '8', '9', '10', '11'].map(n => opt(n))],
      waist:[tt('waist'), 1, 1, ['28', '30', '32', '34', '36', '38', '40'].map(n => opt(n))],
      color:[tt('color'), 1, 1, [tt('black'), tt('white'), tt('blue'), tt('red')].map(n => opt(n))],
      weight:[tt('weight'), 1, 1, [opt('250 g', 0, 0.25, 'g'), opt('500 g', 0, 0.5, 'g'), opt('1 kg', 0, 1, 'kg')]],
      food:[tt('food'), 1, 1, [opt(tt('small')), opt(tt('medium')), opt(tt('large'))]],
      extras:[tt('extras'), 0, 3, [opt(tt('gift'))]]
    }[k];
    if (P) groups.push({ id:uid(), name:P[0], min:P[1], max:P[2], options:P[3] });
    draw();
  }
  async function delGroup(gi){
    const g = groups[gi]; if (!g) return;
    if (typeof uiConfirm === 'function' && (g.name || g.options.some(o => o.name)) && !await uiConfirm(tt('del_q', { n:g.name || '…' }))) return;
    removed.groups.push(g.id); groups.splice(gi, 1); draw();
  }
  function addO(gi){ const last = groups[gi].options.slice(-1)[0]; groups[gi].options.push(opt('', 0, 0, last ? last.unit : 'kg')); draw(); }
  function delO(gi, oi){ const o = groups[gi].options[oi]; removed.options.push(o.id); groups[gi].options.splice(oi, 1); draw(); }
  function set(gi, k, v){ groups[gi][k] = v; }
  function setO(gi, oi, k, v){ groups[gi].options[oi][k] = v; }
  function setW(gi, oi, v){ const o = groups[gi].options[oi]; const n = Math.max(0, Number(v) || 0); o.w = o.unit === 'g' ? n / 1000 : n; }
  function setU(gi, oi, unit, v){ const o = groups[gi].options[oi]; o.unit = unit; setW(gi, oi, v); }
  function pv(gi){ const el = document.getElementById('oepv' + gi); if (el) el.innerHTML = pvHtml(groups[gi]); }
  function check(){
    for (const g of groups){
      g.name = (g.name || '').trim(); g.options = g.options.filter(o => (o.name || '').trim());
      if (!g.name) throw new Error(tt('need_name'));
      if (!g.options.length) throw new Error(tt('need_choice'));
    }
  }
  async function save(id){
    const need = r => { if (r.error) throw r.error; return r.data; };
    check();
    if (removed.groups.length) need(await sbc.from('menu_option_groups').delete().in('id', removed.groups));
    if (removed.options.length) need(await sbc.from('menu_options').delete().in('id', removed.options));
    if (!groups.length) return;
    need(await sbc.from('menu_option_groups').upsert(groups.map((g, i) => ({ id:g.id, menu_item_id:id, name:g.name, min_select:Math.min(g.min, g.max), max_select:g.max, sort_order:i }))));
    const rows = []; groups.forEach(g => g.options.forEach((o, i) => rows.push({ id:o.id, group_id:g.id, name:o.name.trim(), price:Math.max(0, Number(o.price) || 0), weight_kg:Math.round(Math.max(0, Number(o.w) || 0) * 1000) / 1000, is_available:o.on, sort_order:i })));
    if (rows.length) need(await sbc.from('menu_options').upsert(rows));
    removed = { groups:[], options:[] };
  }
  return { init, html, load, save, addGroup, delGroup, addO, delO, set, setO, setW, setU, pv, preset };
})();

// ================= LEGAL + DELETE ACCOUNT (Customer, Rider, Shop) =================
const Legal = (() => {
  const L = {
    en:{ agree:'By creating an account you agree to our {t} and {p}.', terms:'Terms', privacy:'Privacy Policy', links:'Privacy Policy and Terms',
         del:'Delete my account', del_q:'Delete your account? We will remove your personal data. Your past orders stay in our records without your name. This cannot be undone.',
         del_reason:'Why are you leaving? (optional)', del_done:'Request sent. Wanhar Mart will delete your account within 7 days.' },
    ur:{ agree:'اکاؤنٹ بنا کر آپ ہماری {t} اور {p} سے اتفاق کرتے ہیں۔', terms:'شرائط', privacy:'پرائیویسی پالیسی', links:'پرائیویسی پالیسی اور شرائط',
         del:'میرا اکاؤنٹ ختم کریں', del_q:'اکاؤنٹ ختم کریں؟ آپ کی ذاتی معلومات مٹا دی جائیں گی۔ پرانے آرڈر آپ کے نام کے بغیر ریکارڈ میں رہیں گے۔ یہ واپس نہیں ہو سکتا۔',
         del_reason:'آپ کیوں جا رہے ہیں؟ (اختیاری)', del_done:'درخواست بھیج دی گئی۔ Wanhar Mart سات دن میں اکاؤنٹ ختم کر دے گا۔' }
  };
  const tt = (lang, k) => L[lang === 'ur' ? 'ur' : 'en'][k];
  const url = (lang, part) => 'legal.html?lang=' + (lang === 'ur' ? 'ur' : 'en') + '#' + part;
  function agree(lang){
    return `<div class="muted" style="font-size:13px;margin-top:10px;text-align:center">${tt(lang, 'agree').replace('{t}', `<a href="${url(lang, 'terms')}" target="_blank" rel="noopener">${tt(lang, 'terms')}</a>`).replace('{p}', `<a href="${url(lang, 'privacy')}" target="_blank" rel="noopener">${tt(lang, 'privacy')}</a>`)}</div>`;
  }
  function links(lang){
    return `<a class="btn ghost" style="margin-bottom:10px;display:block;text-align:center;text-decoration:none" href="${url(lang, 'privacy')}" target="_blank" rel="noopener">📄 ${tt(lang, 'links')}</a>
      <button class="btn ghost" style="margin-bottom:10px;color:var(--danger);border-color:var(--danger)" onclick="Legal.del()">🗑️ ${tt(lang, 'del')}</button>`;
  }
  let cfg = null;
  function init(c){ cfg = c; }
  async function del(){
    const lang = cfg.lang();
    if (!await uiConfirm(tt(lang, 'del_q'))) return;
    const why = await uiPrompt(tt(lang, 'del_reason'), ''); if (why === null) return;
    const { error } = await cfg.sb.rpc('request_account_deletion', { p_note:why || null });
    if (error) return cfg.toast(error.message, true);
    cfg.toast(tt(lang, 'del_done'));
  }
  return { init, agree, links, del };
})();

// ================= REPORTS: Excel and PDF (Shop app and Admin) =================
const Report = (() => {
  let xlsxP = null;
  function loadXlsx(){
    if (window.XLSX) return Promise.resolve(window.XLSX);
    if (!xlsxP) xlsxP = new Promise((res, rej) => { const s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js'; s.onload = () => res(window.XLSX); s.onerror = () => { xlsxP = null; rej(new Error('xlsx')); }; document.head.appendChild(s); });
    return xlsxP;
  }
  function download(blob, name){ const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500); }
  // sheets: [{ name, rows:[[header...], [cells...]] }]
  async function excel(file, sheets){
    try {
      const X = await loadXlsx(); const wb = X.utils.book_new();
      sheets.forEach(sh => { const ws = X.utils.aoa_to_sheet(sh.rows); ws['!cols'] = (sh.rows[0] || []).map((_, i) => ({ wch:Math.min(40, Math.max(10, ...sh.rows.map(r => String(r[i] ?? '').length + 2))) })); X.utils.book_append_sheet(wb, ws, sh.name.slice(0, 31)); });
      X.writeFile(wb, file + '.xlsx');
    } catch (e) {
      // Fallback: CSV opens in Excel too
      const sh = sheets[0]; const csv = sh.rows.map(r => r.map(c => { const v = String(c ?? ''); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }).join(',')).join('\n');
      download(new Blob(['﻿' + csv], { type:'text/csv;charset=utf-8' }), file + '.csv');
    }
  }
  const esc2 = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  // Printable page: title, subtitle, blocks of { heading, rows:[[label, value]] } and optional table { head:[], rows:[[]] }
  function pdf(o){
    const old = document.getElementById('rptWrap'); if (old) old.remove();
    const w = document.createElement('div'); w.id = 'rptWrap';
    w.style.cssText = 'position:fixed;inset:0;z-index:9500;background:rgba(0,0,0,.5);overflow:auto;padding:16px';
    const kv = rows => rows.map(([a, b, bold]) => `<tr${bold ? ' style="font-weight:800;border-top:2px solid #111"' : ''}><td>${esc2(a)}</td><td style="text-align:right">${esc2(b)}</td></tr>`).join('');
    const tbl = t => `<table class="rt"><thead><tr>${t.head.map(h => `<th>${esc2(h)}</th>`).join('')}</tr></thead><tbody>${t.rows.map(r => `<tr>${r.map((c, i) => `<td${i >= (t.numFrom ?? 99) ? ' style="text-align:right"' : ''}>${esc2(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
    w.innerHTML = `<style>
      #rptWrap .pg{max-width:800px;overflow-wrap:anywhere;margin:0 auto;background:#fff;color:#111;border-radius:12px;padding:24px;font:14px/1.5 system-ui,sans-serif}
      #rptWrap h1{margin:0;font-size:22px} #rptWrap h2{font-size:16px;margin:18px 0 6px}
      #rptWrap table{width:100%;border-collapse:collapse} #rptWrap td,#rptWrap th{padding:5px 6px;border-bottom:1px solid #ddd;text-align:left;vertical-align:top}
      #rptWrap .rt{font-size:12px;min-width:520px} #rptWrap .rt th{white-space:nowrap} #rptWrap .rt th{background:#f0f3ee}
      #rptWrap .nb{max-width:800px;margin:12px auto 0;display:grid;grid-template-columns:1fr 1fr;gap:10px}
      @media (max-width:520px){#rptWrap{padding:10px}#rptWrap .pg{padding:16px}#rptWrap h1{font-size:19px}}
      @media print{#rptWrap .rt{min-width:0}body>*:not(#rptWrap){display:none!important}#rptWrap{position:static!important;background:#fff!important;padding:0!important;overflow:visible!important}#rptWrap .nb{display:none!important}#rptWrap .pg{border-radius:0;padding:0}}
    </style>
    <div class="pg"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px"><div><h1>${esc2(o.title)}</h1><div style="color:#555">${esc2(o.subtitle || '')}</div></div>
      <div style="text-align:right"><b style="font-size:18px">Wanhar Mart<span style="color:#F2A900">.</span></b><div style="color:#555;font-size:12px">Kallar Kahar · ${esc2(new Date().toLocaleString('en-GB', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }))}</div></div></div>
      ${(o.blocks || []).map(b => `<h2>${esc2(b.heading)}</h2><table>${kv(b.rows)}</table>`).join('')}
      ${o.table ? `<h2>${esc2(o.table.heading || '')}</h2><div style="overflow-x:auto;-webkit-overflow-scrolling:touch">${tbl(o.table)}</div>` : ''}
      ${o.note ? `<p style="color:#555;font-size:12px;margin-top:16px">${esc2(o.note)}</p>` : ''}</div>
    <div class="nb"><button class="btn" onclick="window.print()">${esc2(o.printLabel || 'Print or save as PDF')}</button><button class="btn ghost" style="background:#fff" onclick="document.getElementById('rptWrap').remove()">${esc2(o.closeLabel || 'Close')}</button></div>`;
    document.body.appendChild(w);
  }
  return { excel, pdf };
})();

// ================= BACK BUTTON (same code in all four apps) =================
// Phone back button: closes the open popup first, then goes to the main tab, then asks "press back again to exit".
const BackNav = (() => {
  let cfg = null, pushed = 0, internal = 0, armed = false, armTimer = null, pushHash = [];
  const present = () => cfg.overlays.filter(([sel]) => document.querySelector(sel));
  function onMutate(){
    const n = present().length;
    while (pushed < n){ pushHash.push(location.hash); history.pushState({ wmov:pushed + 1 }, '', location.href); pushed++; }
    if (pushed > n){
      const extra = pushed - n; pushed = n;
      const h = pushHash.splice(n).pop();
      // Closed by a button (same page): remove our extra history steps. Closed because the page changed: leave history alone.
      if (h === location.hash && history.state && history.state.wmov){ internal++; history.go(-extra); }
    }
  }
  function guard(){ history.pushState({ wmg:1 }, '', location.href); }
  function onPop(ev){
    if (internal > 0){ internal--; return; }
    const st = ev.state || {};
    const open = present();
    if (open.length){
      // user pressed back while a popup is open: close the top one
      pushed = Math.max(0, pushed - 1); pushHash.pop();
      const [sel, close] = open[open.length - 1];
      try { close ? close() : document.querySelector(sel).remove(); } catch (e) { const el = document.querySelector(sel); if (el) el.remove(); }
      return;
    }
    if (st.wmov){ internal++; history.back(); return; }         // leftover popup step: skip it
    if (!st.wmb) return;                                          // normal page change (hash links) is handled by the app
    if (cfg.back && cfg.back()){ guard(); return; }               // went to main tab / home
    if (armed){ return; }                                         // second press: nothing left, phone closes the app
    armed = true; cfg.toast(cfg.exitMsg());
    clearTimeout(armTimer); armTimer = setTimeout(() => { armed = false; if (history.state && history.state.wmb) guard(); }, 2200);
  }
  function init(c){
    if (cfg) return; cfg = c;
    history.replaceState({ wmb:1 }, '', location.href); guard();
    window.addEventListener('popstate', onPop);
    new MutationObserver(onMutate).observe(document.body, { childList:true });
  }
  return { init };
})();

// ================= PAYMENT RECEIPTS (Admin, Shop and Rider apps) =================
// Shows each payment as a row; tap a row to see a full receipt (time, method, transaction ID, who paid, note) that can be printed or saved as PDF.
const Receipt = (() => {
  const M = { cash:['💵', 'Cash', 'نقد'], jazzcash:['📱', 'JazzCash', 'جاز کیش'], easypaisa:['📱', 'Easypaisa', 'ایزی پیسہ'], bank:['🏦', 'Bank transfer', 'بینک ٹرانسفر'], other:['🧾', 'Other', 'دیگر'] };
  const W = {
    en:{ receipt:'Payment receipt', deposit:'Cash deposit receipt', no:'Receipt no.', amount:'Amount', on:'Paid on', got_on:'Received on', method:'Payment method', ref:'Transaction ID', by:'Paid by', to:'Paid to', from:'Received from', recv_by:'Received by', period:'For orders', orders:'Orders', note:'Note', status:'Status', paid:'Paid ✓', recv:'Received ✓', print:'Print or save as PDF', close:'Close', n_orders:'orders', details:'Payment details', bd:'Pay breakdown', salary:'Monthly salary', delivery:'Delivery pay + tips', overtime:'Overtime', bonus:'Bonus', fines:'Fines', id_fee:'Rider ID fee (monthly)', month_pay:'Month pay', paid_before:'Paid before', this_pay:'This payment', left:'Still to pay after this', shop_earning:'Shop earning', shop_fee:'Monthly fee', monthly:'monthly', once:'one time', inst:'installment {k} of {n}', foot:'This receipt is made by the Wanhar Mart app. Keep it for your records.' },
    ur:{ receipt:'ادائیگی کی رسید', deposit:'نقد جمع کرانے کی رسید', no:'رسید نمبر', amount:'رقم', on:'ادائیگی کا وقت', got_on:'وصولی کا وقت', method:'طریقہ', ref:'ٹرانزیکشن آئی ڈی', by:'ادا کرنے والا', to:'وصول کنندہ', from:'جمع کرانے والا', recv_by:'وصول کرنے والا', period:'آرڈرز کی مدت', orders:'آرڈرز', note:'نوٹ', status:'حالت', paid:'ادا ہو گیا ✓', recv:'وصول ہو گیا ✓', print:'پرنٹ یا PDF محفوظ کریں', close:'بند کریں', n_orders:'آرڈرز', details:'ادائیگی کی تفصیل', bd:'تنخواہ کی تفصیل', salary:'ماہانہ تنخواہ', delivery:'ڈیلیوری کی کمائی + ٹپ', overtime:'اوور ٹائم', bonus:'بونس', fines:'جرمانے', id_fee:'رائیڈر آئی ڈی فیس (ماہانہ)', month_pay:'مہینے کی تنخواہ', paid_before:'پہلے ادا ہوا', this_pay:'یہ ادائیگی', left:'اس کے بعد باقی', shop_earning:'دکان کی کمائی', shop_fee:'ماہانہ فیس', monthly:'ماہانہ', once:'ایک بار', inst:'قسط {k} از {n}', foot:'یہ رسید Wanhar Mart ایپ نے بنائی ہے۔ اپنے ریکارڈ کے لیے رکھیں۔' }
  };
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  const rs = n => 'Rs ' + Math.round(Number(n) || 0).toLocaleString('en-US');
  const method = (m, ur) => { const x = M[m] || M.other; return x[0] + ' ' + (ur ? x[2] : x[1]); };
  const no = n => '#' + String(n || 0).padStart(5, '0');
  const full = ts => new Date(ts).toLocaleString('en-GB', { weekday:'short', day:'numeric', month:'short', year:'numeric', hour:'numeric', minute:'2-digit', hour12:true, timeZone:'Asia/Karachi' });
  const short = ts => new Date(ts).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'numeric', minute:'2-digit', hour12:true, timeZone:'Asia/Karachi' });
  const day = d => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
  const dm = d => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day:'numeric', month:'short' });
  const iso = x => x ? '\u2066' + x + '\u2069' : '';   // keeps dates in the right order in Urdu
  const period = p => p.period_start ? iso(p.period_start === p.period_end || !p.period_end ? day(p.period_start) : day(p.period_start) + ' – ' + day(p.period_end)) : '';
  const reg = {};
  let styled = false;
  function style(){
    if (styled) return; styled = true;
    const s = document.createElement('style');
    s.textContent = `.rcpt{display:flex;gap:12px;align-items:flex-start;width:100%;text-align:start;background:var(--surface,#fff);border:1px solid var(--line,#e2e8e1);border-radius:16px;padding:12px;margin:0 0 8px;cursor:pointer;color:inherit;font:inherit}
      .rcpt:active{transform:scale(.99)}
      .rcpt .ri{width:40px;height:40px;border-radius:12px;background:var(--soft,#e8f3ec);display:grid;place-items:center;font-size:20px;flex:none}
      .rcpt .rm{flex:1;min-width:0}.rcpt .rm b{font-size:16px}
      .rcpt .rs{font-size:13px;color:var(--muted,#64736a);line-height:1.45;margin-top:2px}
      .rcpt .rn{font-size:13px;margin-top:4px;background:var(--field,#f3f6f2);border-radius:8px;padding:4px 8px;display:inline-block;max-width:100%;overflow-wrap:anywhere}
      .rcpt .rt{font-size:12px;color:var(--muted,#64736a);text-align:end;flex:none;white-space:nowrap}
      .rcpt .rt u{display:block;text-decoration:none;color:var(--green,#0e7a4d);font-weight:700;margin-top:6px}`;
    document.head.appendChild(s);
  }
  // p: payouts or cash_handovers row. o: { kind:'payout'|'handover', ur:bool, to:'Shop or rider name' }
  function row(p, o){
    style(); o = o || {}; reg[p.id] = { p, o };
    const L = W[o.ur ? 'ur' : 'en'];
    const per = p.period_start ? (p.period_end && p.period_end !== p.period_start ? dm(p.period_start) + ' – ' + dm(p.period_end) : dm(p.period_start)) : '';
    const sub = [per ? `<bdi dir="ltr">${esc(per)}</bdi>` : '', esc(method(p.method, o.ur)), p.orders_count ? `<bdi>${p.orders_count} ${esc(L.n_orders)}</bdi>` : ''].filter(Boolean).join(' · ');
    return `<button type="button" class="rcpt" onclick="Receipt.open('${p.id}')"><span class="ri">${(M[p.method] || M.other)[0]}</span>
      <span class="rm"><b>${rs(p.amount)}</b><div class="rs">${sub}${p.reference ? '<br>' + esc(L.ref) + ': <bdi dir="ltr">' + esc(p.reference) + '</bdi>' : ''}</div>${p.note ? `<div class="rn">📝 ${esc(p.note)}</div>` : ''}</span>
      <span class="rt"><bdi dir="ltr">${esc(short(p.created_at))}</bdi><u>${o.ur ? 'رسید ›' : 'Receipt ›'}</u></span></button>`;
  }
  function list(rows, o, empty){ return (rows || []).map(p => row(p, o)).join('') || `<div class="empty">${esc(empty || '')}</div>`; }
  function open(id){
    const r = reg[id]; if (!r) return; const { p, o } = r; const L = W[o.ur ? 'ur' : 'en'];
    const dep = o.kind === 'handover';
    const rows = [[L.no, iso(no(p.receipt_no))], [L.amount, rs(p.amount), true], [dep ? L.got_on : L.on, iso(full(p.created_at))], [L.method, method(p.method, o.ur)]];
    if (p.reference) rows.push([L.ref, iso(p.reference)]);
    if (dep){ rows.push([L.from, o.to || ''], [L.recv_by, p.received_by_name || 'Wanhar Mart']); }
    else { rows.push([L.by, (p.paid_by_name || 'Wanhar Mart') + ' · Wanhar Mart'], [L.to, o.to || '']); }
    if (p.period_start) rows.push([L.period, period(p)]);
    if (p.orders_count) rows.push([L.orders, String(p.orders_count)]);
    rows.push([L.status, dep ? L.recv : L.paid]);
    if (p.note) rows.push([L.note, p.note]);
    const blocks = [{ heading:L.details, rows }];
    const b = p.breakdown;
    if (b && Array.isArray(b.lines) && b.lines.length){
      const part = x => { if (x.kind === 'installment'){ const m = String(x.p || '').match(/(\d+) of (\d+)/); return m ? L.inst.replace('{k}', m[1]).replace('{n}', m[2]) : ''; } return x.kind === 'monthly' ? L.monthly : x.kind === 'once' ? L.once : ''; };
      const val = a => (Number(a) < 0 ? '−' : '') + rs(Math.abs(Number(a) || 0));
      const br = b.lines.map(x => [x.k === 'charge' ? '🧾 ' + x.t + (part(x) ? ' (' + part(x) + ')' : '') : (L[x.k] || x.k) + (x.m ? ' · ' + iso(new Date(String(x.m).slice(0, 10) + 'T00:00:00').toLocaleDateString('en-GB', { month:'short', year:'numeric' })) : '') + (x.n ? ' (' + x.n + ')' : ''), val(x.a)]);
      const shopPay = b.lines[0] && b.lines[0].k === 'shop_earning';
      if (!shopPay) br.push([L.month_pay, val(b.net), true]);
      if (Number(b.paid_before)) br.push([L.paid_before, rs(b.paid_before)]);
      br.push([L.this_pay, rs(p.amount), true]);
      if (!shopPay) br.push([L.left, rs(Math.max(0, Number(b.net) - Number(b.paid_before || 0) - Number(p.amount)))]);
      blocks.push({ heading:L.bd + (b.month ? ' · ' + iso(new Date(b.month + 'T00:00:00').toLocaleDateString('en-GB', { month:'long', year:'numeric' })) : ''), rows:br });
    }
    Report.pdf({ title:(dep ? L.deposit : L.receipt) + ' ' + no(p.receipt_no), subtitle:o.to || '', blocks, note:L.foot, printLabel:L.print, closeLabel:L.close });
  }
  return { row, list, open, method, M };
})();
(async function boot(){
  applyLang();
  try {
    const { data:{ session } } = await sb.auth.getSession();
    if (session) await afterLogin(session.user); else showAuth();
  } catch (e) { logErr(e); showAuth(t('error')); }
})();
</script>
</body>
</html>
