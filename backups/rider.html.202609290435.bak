    face_many:'تصویر میں صرف آپ ہوں۔', face_match:'چہرہ مل گیا', face_nomatch:'چہرہ نہیں ملا۔ روشنی میں دوبارہ کوشش کریں۔',
    face_saved:'چہرہ رجسٹر ہو گیا', cam_denied:'کیمرہ بند ہے۔ براؤزر کی سیٹنگ میں اس سائٹ کے لیے کیمرہ کی اجازت دیں۔',
    face_ok:'چہرہ رجسٹر ہے', face_missing:'چہرہ رجسٹر نہیں', register_face:'چہرہ رجسٹر کریں',
    duty_started:'ڈیوٹی شروع ہو گئی۔ کامیابی ہو!', duty_ended:'ڈیوٹی ختم ہو گئی', getting_loc:'لوکیشن لی جا رہی ہے…',
    earn_today:'آج کی کمائی', distance:'فاصلہ', pickup_in:'دکان تک', trip:'سفر', ready_since:'تیار',
    arrived_btn:'میں گاہک کے پاس پہنچ گیا', arrived_at:'{t} پر پہنچے', report:'مسئلہ بتائیں', report_title:'کیا مسئلہ ہے؟',
    note_opt:'مزید تفصیل (اختیاری)', send_report:'Wanhar Mart کو بھیجیں', reported:'Wanhar Mart اور دکان کو اطلاع دے دی گئی',
    waiting_cust:'گاہک کا انتظار', wait_note:'گاہک کو دوبارہ کال کریں۔ وقت ختم ہونے پر آپ آرڈر دکان واپس لے جا سکتے ہیں۔',
    wait_done:'انتظار کا وقت ختم', slide_return:'آرڈر دکان واپس لے جانے کے لیے سلائیڈ کریں', returned_toast:'آرڈر منسوخ۔ اسے دکان واپس لے جائیں۔',
    back_title:'یہ آرڈر دکان واپس لے جائیں', back_note:'دکان وصول کر کے تصدیق کرے گی۔', call_support:'Wanhar Mart کو کال کریں',
    problem_open:'مسئلہ بتایا گیا', k_customer_unreachable:'گاہک کال نہیں اٹھا رہا', k_customer_absent:'گاہک پتے پر موجود نہیں',
    k_customer_refused_pay:'گاہک نقد رقم نہیں دے رہا', k_wrong_address:'پتہ غلط یا واضح نہیں', k_shop_delay:'دکان پر آرڈر تیار نہیں',
    k_shop_closed:'دکان بند ہے', k_order_damaged:'آرڈر خراب ہو گیا یا گر گیا', k_accident:'حادثہ یا گاڑی کا مسئلہ',
    k_rider_delay:'مجھے دیر ہو جائے گی', k_other:'کوئی اور مسئلہ', pick_problem:'مسئلہ چنیں', call_customer:'گاہک کو کال کریں',
    shop_word:'دکان', help_word:'مدد', chat_support:'Wanhar Mart سے بات کریں', k_chat_help:'Wanhar Mart کو چیٹ میں بلایا گیا'
  }
};
const state = {
  lang: ls.get('kh_lang', 'en'), user:null, profile:null, rider:null, settings:{}, tab:'jobs', authMode:'login',
  mine:[], issues:{}, available:[], done:[], fines:[], rules:[], payouts:[], handovers:[], shift:null, todayMinutes:0, rating:null,
  sound: ls.get('kh_rd_sound', true), seen:new Set(), seenOffer:new Set(), skipped:new Set(), pos:null
};
const t = k => (I18N[state.lang] && I18N[state.lang][k]) || I18N.en[k] || k;
function applyLang(){ document.documentElement.lang = state.lang; document.documentElement.dir = state.lang === 'ur' ? 'rtl' : 'ltr'; }
function toast(msg, isErr){
  const el = document.createElement('div'); el.className = 'toast' + (isErr ? ' err' : ''); el.textContent = msg;
  document.body.appendChild(el); setTimeout(() => el.remove(), 3400);
}
async function run(fn){ try { return await fn(); } catch (e) { logErr(e); toast((e && e.message) || t('error'), true); } }
function need(res){ if (res.error) throw res.error; return res.data; }
const onDuty = () => !!(state.rider && state.rider.is_online);
const requireSelfie = () => state.settings.require_selfie === true;
const threshold = () => num(state.settings.face_match_threshold ?? 0.5) || 0.5;

// ---- Alert sound, vibration, screen wake ----
let actx = null;
function unlockAudio(){ try { if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)(); if (actx.state === 'suspended') actx.resume(); } catch (e) {} }
document.addEventListener('pointerdown', unlockAudio);
const audioReady = () => !!actx && actx.state === 'running';
function beep(){
  if (state.sound && audioReady()){
    try {
      const o = actx.createOscillator(), g = actx.createGain();
      o.type = 'square'; o.frequency.value = 740; g.gain.value = 0.18; o.connect(g); g.connect(actx.destination); o.start();
      setTimeout(() => { o.frequency.value = 1100; }, 160); setTimeout(() => { o.frequency.value = 740; }, 320); setTimeout(() => o.stop(), 520);
    } catch (e) {}
  }
  try { if (navigator.vibrate) navigator.vibrate([300, 120, 300, 120, 300]); } catch (e) {}
}
let wakeLock = null;
async function keepAwake(){ try { if ('wakeLock' in navigator && !wakeLock){ wakeLock = await navigator.wakeLock.request('screen'); wakeLock.addEventListener('release', () => { wakeLock = null; }); } } catch (e) {} }
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && state.rider && state.rider.is_approved){ if (onDuty()) keepAwake(); refresh(); } });

// ---- Location ----
let geoWatch = null, lastSent = 0;
function startGeo(){
  if (geoWatch !== null || !navigator.geolocation) return;
  geoWatch = navigator.geolocation.watchPosition(pos => {
    state.pos = { lat:pos.coords.latitude, lng:pos.coords.longitude };
    const now = Date.now(); if (now - lastSent < 30000 || !onDuty()) return; lastSent = now;
    sb.from('riders').update({ current_lat:state.pos.lat, current_lng:state.pos.lng, location_updated_at:new Date().toISOString() }).eq('id', state.rider.id).then(() => {});
  }, () => {}, { enableHighAccuracy:true, maximumAge:15000, timeout:20000 });
}
function stopGeo(){ if (geoWatch !== null){ navigator.geolocation.clearWatch(geoWatch); geoWatch = null; } }
function getPosOnce(){
  return new Promise(res => {
    if (!navigator.geolocation) return res(null);
    navigator.geolocation.getCurrentPosition(p => { state.pos = { lat:p.coords.latitude, lng:p.coords.longitude }; res(state.pos); }, () => res(null), { enableHighAccuracy:true, timeout:8000, maximumAge:60000 });
  });
}

// ================= FACE CHECK =================
let faceLoad = null;
function loadFace(){
  if (faceLoad) return faceLoad;
  faceLoad = new Promise((res, rej) => {
    const go = async () => {
      try {
        await faceapi.nets.tinyFaceDetector.loadFromUri(FACE_MODELS);
        await faceapi.nets.faceLandmark68TinyNet.loadFromUri(FACE_MODELS);
        await faceapi.nets.faceRecognitionNet.loadFromUri(FACE_MODELS);
        res();
      } catch (e) { faceLoad = null; rej(e); }
    };
    if (window.faceapi) return go();
    const s = document.createElement('script'); s.src = FACE_JS; s.onload = go;
    s.onerror = () => { faceLoad = null; rej(new Error('Could not load the face check. Check your internet.')); };
    document.head.appendChild(s);
  });
  return faceLoad;
}
let camStream = null;
async function startCam(video){
  camStream = await navigator.mediaDevices.getUserMedia({ video:{ facingMode:'user', width:{ ideal:640 }, height:{ ideal:800 } }, audio:false });
  video.srcObject = camStream; await video.play();
}
function stopCam(){ if (camStream){ camStream.getTracks().forEach(tr => tr.stop()); camStream = null; } }
function snap(video){
  const c = document.createElement('canvas'); const w = video.videoWidth || 480, h = video.videoHeight || 640;
  const s = Math.min(1, 720 / Math.max(w, h)); c.width = Math.round(w * s); c.height = Math.round(h * s);
  c.getContext('2d').drawImage(video, 0, 0, c.width, c.height); return c;
}
async function analyse(canvas){
  const opts = new faceapi.TinyFaceDetectorOptions({ inputSize:416, scoreThreshold:0.5 });
  const all = await faceapi.detectAllFaces(canvas, opts);
  if (!all.length) return { err:'face_none' };
  if (all.length > 1) return { err:'face_many' };
  const one = await faceapi.detectSingleFace(canvas, opts).withFaceLandmarks(true).withFaceDescriptor();
  if (!one) return { err:'face_none' };
  return { descriptor:Array.from(one.descriptor) };
}
function toBlob(canvas){ return new Promise((res, rej) => canvas.toBlob(b => b ? res(b) : rej(new Error('Could not save the photo')), 'image/jpeg', 0.8)); }
async function uploadSelfie(canvas, kind){
  const path = `${state.user.id}/${kind}-${Date.now()}.jpg`;
  need(await sb.storage.from('rider-selfies').upload(path, await toBlob(canvas), { contentType:'image/jpeg' }));
  return path;
}

// Opens the camera screen. mode = 'register' or 'duty'
function openCamera(mode){
  closeOverlay();
  const reg = mode === 'register';
  const el = document.createElement('div'); el.className = 'over'; el.id = 'overlay';
  el.innerHTML = `<div class="panel" role="dialog" aria-modal="true">
    <h1 style="margin-top:0">${reg ? t('face_title') : t('selfie_title')}</h1>
    <p class="muted" style="margin:0">${reg ? t('face_intro') : t('selfie_intro')}</p>
    <div class="cam"><video id="camv" playsinline muted></video><img id="camimg" alt="" style="display:none"><div class="ring" id="ring"></div></div>
    <div class="facestate" id="fstate">${t('cam_loading')}</div>
    <div class="actions">
      <button class="btn" id="camBtn" disabled onclick="A.capture('${mode}')">${t('take_photo')}</button>
      ${!reg || requireSelfie() ? '' : `<button class="btn ghost" onclick="A.skipFace()">${t('skip_now')}</button>`}
      <button class="btn ghost" onclick="closeOverlay()">${t('cancel')}</button>
    </div></div>`;
  document.body.appendChild(el);
  const setState = (msg, cls) => { const f = $('fstate'); if (f){ f.textContent = msg; f.className = 'facestate ' + (cls || ''); } };
  (async () => {
    try { await startCam($('camv')); }
    catch (e) { setState(t('cam_denied'), 'red'); return; }
    setState(t('face_loading'));
    try { await loadFace(); setState(''); const b = $('camBtn'); if (b) b.disabled = false; }
    catch (e) { setState(e.message || t('error'), 'red'); }
  })();
}
function closeOverlay(){ stopCam(); const o = $('overlay'); if (o) o.remove(); }

// ================= SCREENS =================
function showAuth(msg, ok){
  const signup = state.authMode === 'signup';
  $('app').innerHTML = `
  <div class="auth">
    <div style="display:flex;justify-content:flex-end"><button class="pillbtn" onclick="A.toggleLang(true)">${state.lang === 'ur' ? 'English' : 'اردو'}</button></div>
    <div class="brand">Wanhar Mart<b>.</b></div>
    <p class="muted" style="margin:0 0 6px">Rider</p>
    <h1 style="font-size:22px">${signup ? t('signup') : t('login')}</h1>
    <form onsubmit="A.submitAuth(event)">
      ${signup ? `<label class="f" for="a_name">${t('name')}</label><input id="a_name" type="text" autocomplete="name">
      <label class="f" for="a_phone">${t('phone')}</label><input id="a_phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="03001234567">` : ''}
      <label class="f" for="a_email">${t('email')}</label><input id="a_email" type="email" autocomplete="username" autocapitalize="off">
      <label class="f" for="a_pw">${t('password')}</label><input id="a_pw" type="password" autocomplete="${signup ? 'new-password' : 'current-password'}">
      <div style="margin-top:20px"><button class="btn" id="authBtn" type="submit">${signup ? t('signup') : t('login')}</button></div>
      <div class="err-text" id="authMsg" style="${ok ? 'color:var(--green)' : ''}">${esc(msg || '')}</div>
    </form>
    ${signup ? Legal.agree(state.lang) : ''}
    ${signup ? '' : `<button class="link" onclick="A.forgotPw()">${t('forgot_pw')}</button><br>`}
    <button class="link" onclick="A.switchAuth()">${signup ? t('have_account') : t('no_account')}</button>
    <div class="ver">v${APP_VERSION}</div>
  </div>`;
}
function showProfileForm(){
  $('app').innerHTML = `<div class="auth">
    <div class="brand">Wanhar Mart<b>.</b></div>
    <h1 style="font-size:22px;margin-top:14px">${t('rider_profile')}</h1>
    <label class="f" for="p_vehicle">${t('vehicle')}</label>
    <select id="p_vehicle"><option value="motorbike">${t('v_bike')}</option><option value="bicycle">${t('v_bicycle')}</option><option value="car">${t('v_car')}</option></select>
    <label class="f" for="p_cnic">${t('cnic')}</label><input id="p_cnic" type="text" inputmode="numeric" placeholder="3xxxx-xxxxxxx-x">
    <div class="actions"><button class="btn" id="profBtn" onclick="A.submitProfile()">${t('submit')}</button>
    <button class="btn ghost" onclick="A.logout()">${t('logout')}</button></div></div>`;
}
function showPending(){
  const blocked = state.rider && state.rider.blocked;
  $('app').innerHTML = `<div class="auth">
    <div class="brand">Wanhar Mart<b>.</b></div>
    <h1 style="font-size:22px;margin-top:14px">${blocked ? t('blocked_title') : t('pending_title')}</h1>
    <p class="muted">${blocked ? t('blocked_msg') : t('pending_msg')}</p>
    <div class="actions"><button class="btn" onclick="A.recheck()">${t('check_again')}</button>
    <button class="btn ghost" onclick="A.logout()">${t('logout')}</button></div>
    <div class="ver" style="margin-top:12px">v${APP_VERSION}</div></div>`;
}
function dutyLabel(){
  if (!onDuty()) return `<i></i>${t('off_duty')}`;
  const mins = state.shift ? (Date.now() - new Date(state.shift.started_at)) / 60000 : 0;
  return `<i></i>${t('on_duty')}${state.shift ? ` <small>${hm(mins)}</small>` : ''}`;
}
function renderShell(){
  $('app').innerHTML = `
    <header class="top">
      <div class="brand">Wanhar Mart<b>.</b><small>Rider</small></div>
      <div style="display:flex;gap:8px;align-items:center">${Chat.button()}<button class="duty ${onDuty() ? 'on' : ''}" id="dutyBtn" onclick="A.toggleDuty()">${dutyLabel()}</button></div>
    </header>
    <main id="view"></main>
    <nav class="nav"><div class="nav-in">
      <button id="t_jobs" onclick="go('jobs')">${t('jobs')}</button>
      <button id="t_earn" onclick="go('earn')">${t('earnings')}</button>
      <button id="t_rules" onclick="go('rules')">${t('rules')}</button>
      <button id="t_acct" onclick="go('acct')">${t('account')}</button>
    </div></nav>`;
}
function updateDutyBtn(){ const b = $('dutyBtn'); if (b){ b.innerHTML = dutyLabel(); b.classList.toggle('on', onDuty()); } }
setInterval(updateDutyBtn, 30000);
function markTab(){
  [['jobs','t_jobs'],['earn','t_earn'],['rules','t_rules'],['acct','t_acct']].forEach(([k, id]) => { const b = $(id); if (b) b.classList.toggle('on', state.tab === k); });
  const j = $('t_jobs'); if (j){ const n = state.mine.length; j.innerHTML = t('jobs') + (n ? `<span class="dot">${n}</span>` : ''); }
}
async function go(tab){
  state.tab = tab; markTab(); const v = $('view'); if (!v) return;
  v.innerHTML = `<div class="empty">${t('loading')}</div>`;
  await run(async () => {
    if (tab === 'jobs') await Promise.all([loadJobs(), loadMoney()]);
    if (tab === 'earn') await loadMoney();
    if (tab === 'rules') await loadRules();
  });
  renderTab(); window.scrollTo(0, 0);
}
function renderTab(){
  const v = $('view'); if (!v) return;
  if (state.tab === 'jobs') v.innerHTML = viewJobs();
  if (state.tab === 'earn') v.innerHTML = viewEarn();
  if (state.tab === 'rules') v.innerHTML = viewRules();
  if (state.tab === 'acct') v.innerHTML = viewAcct();
  markTab(); bindSliders(); if (state.tab === 'acct') showMyFace();
  document.title = state.available.length && onDuty() ? `(${state.available.length}) Wanhar Mart Rider` : 'Wanhar Mart Rider';
}

// ================= DATA =================
async function loadRider(){
  const { data:prof } = await sb.from('profiles').select('*').eq('id', state.user.id).single();
  state.profile = prof || {};
  state.rider = need(await sb.from('riders').select('*').eq('profile_id', state.user.id).maybeSingle());
  const s = await sb.from('app_settings').select('key,value');
  state.settings = {}; (s.data || []).forEach(r => { state.settings[r.key] = r.value; });
}
async function loadShift(){
  if (!state.rider || !state.rider.is_approved) return;
  const since = new Date(); since.setHours(0, 0, 0, 0);
  const rows = need(await sb.from('rider_shifts').select('id,started_at,ended_at').eq('rider_id', state.rider.id).or(`ended_at.is.null,ended_at.gte.${since.toISOString()}`).order('started_at', { ascending:false }).limit(20));
  state.shift = rows.find(r => !r.ended_at) || null;
  try {
    const br = need(await sb.from('rider_breaks').select('started_at,ended_at').eq('rider_id', state.rider.id).gte('started_at', since.toISOString()).order('started_at'));
    state.breakOpen = br.find(b => !b.ended_at) || null;
    state.breakDone = br.filter(b => b.ended_at).reduce((n, b) => n + (new Date(b.ended_at) - new Date(b.started_at)) / 60000, 0);
  } catch (e) { state.breakOpen = null; state.breakDone = 0; }
  try { const lt = await sb.from('rider_shifts').select('late_minutes').eq('rider_id', state.rider.id).gte('started_at', since.toISOString()).not('late_minutes', 'is', null).limit(1); state.lateToday = lt.data && lt.data[0] ? lt.data[0].late_minutes : 0; } catch (e) { state.lateToday = 0; }
  state.rider.on_break = !!state.breakOpen;
  state.todayAt = Date.now();
  state.todayMinutes = rows.reduce((n, r) => n + ((r.ended_at ? new Date(r.ended_at) : new Date()) - Math.max(new Date(r.started_at), since)) / 60000, 0);
}
async function loadMine(){
  state.mine = need(await sb.from('orders')
    .select('*, restaurant:restaurants(name,address,phone,lat,lng), customer:profiles!customer_id(full_name,phone), order_items(name,quantity,note)')
    .eq('rider_id', state.rider.id).or('status.in.(rider_assigned,picked_up),return_status.eq.returning').order('created_at'));
  state.issues = {};
  const ids = state.mine.map(o => o.id);
  if (ids.length){
    const rows = need(await sb.from('order_issues').select('*').in('order_id', ids).order('created_at', { ascending:false }));
    rows.forEach(i => { (state.issues[i.order_id] = state.issues[i.order_id] || []).push(i); });
  }
}
async function loadAvailable(){
  if (!onDuty()){ state.available = []; return; }
  state.available = need(await sb.rpc('available_deliveries')) || [];
  // A delivery offered only to me (nearest rider): always pop up, with its own timer
  const offer = state.available.find(j => j.offered_to_me && j.offer_expires_at && !state.seenOffer.has(j.order_id + j.offer_expires_at));
  if (offer && state.mine.length < 2){ state.seenOffer.add(offer.order_id + offer.offer_expires_at); state.seen.add(offer.order_id); closeJobPopup(); showJobPopup(offer); state.firstLoadDone = true; return; }
  const fresh = state.available.filter(j => !state.seen.has(j.order_id));
  fresh.forEach(j => state.seen.add(j.order_id));
  if (fresh.length && state.firstLoadDone && !state.mine.length) showJobPopup(fresh[0]);
  else if (fresh.length && state.firstLoadDone) beep();
  state.firstLoadDone = true;
}
async function loadJobs(){ await loadMine(); await loadAvailable(); }
async function loadMoney(){
  const m = monthStart();
  const [done, unsettled, fines, pays, hand] = await Promise.all([
    sb.from('orders').select('id,created_at,delivered_at,total,rider_pay,rider_settled,restaurant:restaurants(name)')
      .eq('rider_id', state.rider.id).eq('status', 'delivered').gte('delivered_at', m.toISOString()).order('delivered_at', { ascending:false }),
    sb.from('orders').select('total').eq('rider_id', state.rider.id).eq('status', 'delivered').eq('rider_settled', false),
    sb.from('rider_fines').select('*').eq('rider_id', state.rider.id).gte('fined_at', m.toISOString()).order('fined_at', { ascending:false }),
    sb.from('payouts').select('*').eq('party_type', 'rider').eq('party_id', state.rider.id).order('created_at', { ascending:false }).limit(12),
    sb.from('cash_handovers').select('*').eq('rider_id', state.rider.id).order('created_at', { ascending:false }).limit(10)
  ]);
  state.done = need(done); state.cash = need(unsettled).reduce((n, o) => n + num(o.total), 0);
  state.fines = need(fines); state.payouts = need(pays); state.handovers = need(hand);
  try {
    const ot = need(await sb.rpc('rider_overtime', { p_rider_id:state.rider.id, p_from:m.toISOString(), p_to:new Date().toISOString() }));
    state.ot = (Array.isArray(ot) ? ot[0] : ot) || null;
  } catch (e) { state.ot = null; }
  try {
    const res = await Promise.all(['today','month','yesterday','last_month'].map(k => sb.rpc('rider_leaderboard', { p_period:k })));
    state.lb = { today:res[0].data || [], month:res[1].data || [], yesterday:res[2].data || [], last_month:res[3].data || [] };
  } catch (e) { state.lb = null; }
  try { state.targets = need(await sb.rpc('my_targets')) || []; } catch (e) { state.targets = []; }
  try { const bb = need(await sb.from('rider_bonuses').select('amount,title,created_at').eq('rider_id', state.rider.id).gte('period_start', ymd(m)).order('created_at', { ascending:false })); state.bonuses = bb; } catch (e) { state.bonuses = []; }
  try { const tr = need(await sb.rpc('my_pay_tier')); state.tier = (Array.isArray(tr) ? tr[0] : tr) || null; } catch (e) { state.tier = null; }
  await loadShift();
}
async function loadRules(){
  const [r, f, rv] = await Promise.all([
    sb.from('fine_rules').select('*').eq('is_active', true).order('amount'),
    sb.from('rider_fines').select('*').eq('rider_id', state.rider.id).gte('fined_at', monthStart().toISOString()).order('fined_at', { ascending:false }),
    sb.from('orders').select('id').eq('rider_id', state.rider.id).eq('status', 'delivered').order('delivered_at', { ascending:false }).limit(200)
  ]);
  state.rules = need(r); state.fines = need(f);
  const ids = (need(rv) || []).map(o => o.id);
  state.rating = null;
  if (ids.length){
    const { data } = await sb.from('reviews').select('rider_rating').in('order_id', ids).not('rider_rating', 'is', null);
    if (data && data.length) state.rating = { avg:(data.reduce((n, x) => n + x.rider_rating, 0) / data.length).toFixed(1), n:data.length };
  }
}
let refreshing = false;
async function refresh(){
  if (refreshing || !state.rider || !state.rider.is_approved) return; refreshing = true;
  try {
    await loadJobs();
    if (state.tab === 'jobs' && !document.querySelector('.slide.dragging')) renderTab(); else markTab();
  } catch (e) { logErr(e); } finally { refreshing = false; }
}

// ================= NEW JOB POP-UP =================
let popTimer = null, popBeep = null;
function jobDistances(j){
  const toShop = state.pos ? km(state.pos.lat, state.pos.lng, j.restaurant_lat, j.restaurant_lng) : null;
  const trip = km(j.restaurant_lat, j.restaurant_lng, j.drop_lat, j.drop_lng);
  return { toShop, trip };
}
function showJobPopup(j){
  if ($('overlay')) return beep();
  const d = jobDistances(j);
  const el = document.createElement('div'); el.className = 'over newjob'; el.id = 'overlay';
  el.innerHTML = `<div class="panel" role="alertdialog" aria-modal="true">
    <div class="ch"><span class="pill y">${j.offered_to_me ? '⭐ ' + t('only_you') : t('new_order')}</span><span class="muted" id="popLeft">${JOB_SECONDS}s</span></div>
    <div class="timer"><i id="popBar"></i></div>
    <div class="line" style="align-items:flex-end"><div><div class="muted">${t('your_pay')}</div><div class="big">${money(j.rider_pay)}</div></div>
      <div style="text-align:end"><div class="muted">${t('cash_collect')}</div><b style="font-size:20px">${money(j.total)}</b></div></div>
    <div class="meta">${d.toShop != null ? `<span><b>${fmtKm(d.toShop)}</b> ${t('pickup_in')}</span>` : ''}${d.trip != null ? `<span><b>${fmtKm(d.trip)}</b> ${t('trip')}</span>` : ''}${num(j.items_count) ? `<span><b>${j.items_count}</b> ${t('items')}</span>` : ''}</div>
    <div class="step"><div class="n">1</div><div><div class="muted" style="font-size:13px">${t('pick_from')}</div><b>${esc(j.restaurant_name)}</b><div class="muted">${esc(j.restaurant_address || '')}</div></div></div>
    <div class="step"><div class="n">2</div><div><div class="muted" style="font-size:13px">${t('deliver_to')}</div><b>${esc(j.drop_address || '')}</b></div></div>
    <div class="two" style="margin-top:14px"><button class="btn ghost" onclick="A.skipJob('${j.order_id}', ${j.offered_to_me ? 'true' : 'false'})">${j.offered_to_me ? t('decline') : t('skip')}</button><button class="btn" onclick="A.acceptJob('${j.order_id}')">${t('accept')}</button></div>
  </div>`;
  document.body.appendChild(el);
  const total = j.offered_to_me && j.offer_expires_at ? Math.max(5, Math.round((new Date(j.offer_expires_at) - Date.now()) / 1000)) : JOB_SECONDS;
  let left = total; beep();
  popBeep = setInterval(beep, 3000);
  requestAnimationFrame(() => { const b = $('popBar'); if (b) b.style.width = '100%'; });
  popTimer = setInterval(() => {
    left--; const l = $('popLeft'), b = $('popBar');
    if (l) l.textContent = left + 's'; if (b) b.style.width = (left / total * 100) + '%';
    if (left <= 0) A.skipJob(j.order_id, !!j.offered_to_me);
  }, 1000);
}
function closeJobPopup(){ clearInterval(popTimer); clearInterval(popBeep); popTimer = popBeep = null; closeOverlay(); }

// ================= SLIDE TO CONFIRM =================
function slider(label, action, gold){
  return `<div class="slide ${gold ? 'gold' : ''}" data-action="${esc(action)}"><div class="txt">${esc(label)}</div><button class="knob" aria-label="${esc(label)}">›</button></div>`;
}
function bindSliders(){
  document.querySelectorAll('.slide').forEach(sl => {
    if (sl.dataset.bound) return; sl.dataset.bound = '1';
    const knob = sl.querySelector('.knob'); const rtl = document.documentElement.dir === 'rtl';
    let startX = 0, dx = 0, drag = false;
    const max = () => sl.clientWidth - knob.clientWidth - 10;
    const set = v => { knob.style.transform = `translateX(${rtl ? -v : v}px)`; };
    knob.addEventListener('pointerdown', e => { drag = true; startX = e.clientX; dx = 0; knob.setPointerCapture(e.pointerId); sl.classList.add('dragging'); knob.style.transition = 'none'; });
    knob.addEventListener('pointermove', e => { if (!drag) return; dx = (e.clientX - startX) * (rtl ? -1 : 1); dx = Math.max(0, Math.min(max(), dx)); set(dx); });
    const end = () => {
      if (!drag) return; drag = false; sl.classList.remove('dragging'); knob.style.transition = 'transform .2s';
      if (dx >= max() * 0.85){ set(max()); new Function(sl.dataset.action)(); } else set(0);
    };
    knob.addEventListener('pointerup', end); knob.addEventListener('pointercancel', end);
    knob.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); if (confirm(sl.querySelector('.txt').textContent + '?')) new Function(sl.dataset.action)(); } });
  });
}

// ================= DELIVERIES TAB =================
function chatRow(o){
  const id = JSON.stringify(o.id);
  return `<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px">
    <button class="btn ghost small" onclick='Chat.open(${id}, "cr", null)'>💬 ${t('customer')}</button>
    <button class="btn ghost small" onclick='Chat.open(${id}, "rs", null)'>💬 ${t('shop_word')}</button>
    <button class="btn ghost small" onclick='Chat.open(${id}, "sup_r", null)'>💬 ${t('help_word')}</button></div>`;
}
function waitIssue(o){ return (state.issues[o.id] || []).find(i => i.status === 'open' && i.wait_until); }
function returnCard(o){
  const r = o.restaurant || {};
  return `<div class="card back"><div class="ch"><span class="oid">#${esc(o.id.slice(-4).toUpperCase())}</span><span class="pill r">${t('back_title')}</span></div>
    <b>${esc(r.name || '')}</b><div class="muted">${esc(r.address || '')}</div>
    <div class="two" style="margin-top:8px">${r.phone ? `<a class="btn ghost small" href="tel:${esc(r.phone)}">${t('call')}</a>` : '<span></span>'}
    <a class="btn ghost small" target="_blank" rel="noopener" href="${mapsUrl(r.lat, r.lng, (r.name || '') + ' ' + (r.address || ''))}">${t('open_maps')}</a></div>
    <div class="note">${t('back_note')}</div>${chatRow(o)}</div>`;
}
function issueBlock(o){
  const list = (state.issues[o.id] || []).filter(i => i.status === 'open');
  const w = waitIssue(o); let html = '';
  if (w){
    const left = new Date(w.wait_until).getTime() - Date.now();
    html += `<div class="waitbox ${left <= 0 ? 'done' : ''}" data-until="${esc(w.wait_until)}"><div class="line"><b>${left <= 0 ? t('wait_done') : t('waiting_cust')}</b><span class="clock">${clock(left)}</span></div>
      <div style="font-size:14px">${t('k_' + w.kind)}</div><div class="muted" style="font-size:13px">${t('wait_note')}</div></div>
      ${left <= 0 ? slider(t('slide_return'), `A.returnOrder('${o.id}')`) : ''}`;
  }
  list.filter(i => !i.wait_until).forEach(i => { html += `<div class="issuebox"><b>${t('problem_open')}:</b> ${t('k_' + i.kind)}${i.note ? ' · ' + esc(i.note) : ''}<br><span class="muted">${t('reported')}</span></div>`; });
  return html;
}
function clock(ms){ if (ms <= 0) return '00:00'; const s = Math.ceil(ms / 1000); return pad(Math.floor(s / 60)) + ':' + pad(s % 60); }
setInterval(() => {
  document.querySelectorAll('.waitbox[data-until]').forEach(el => {
    const left = new Date(el.dataset.until).getTime() - Date.now();
    const c = el.querySelector('.clock'); if (c) c.textContent = clock(left);
    if (left <= 0 && !el.classList.contains('done')){ el.classList.add('done'); beep(); if (state.tab === 'jobs' && !document.querySelector('.slide.dragging')) renderTab(); }
  });
}, 1000);
function activeCard(o){
  if (o.return_status === 'returning') return returnCard(o);
  const r = o.restaurant || {}, c = o.customer || {};
  const items = (o.order_items || []).map(i => `<div>${i.quantity} × ${esc(i.name)}${i.note ? ` <span class="muted">(${esc(i.note)})</span>` : ''}</div>`).join('');
  const picked = o.status === 'picked_up';
  const dShop = state.pos ? km(state.pos.lat, state.pos.lng, r.lat, r.lng) : null;
  const dCust = state.pos ? km(state.pos.lat, state.pos.lng, o.address_lat, o.address_lng) : null;
  const restBlock = `<div class="step ${picked ? 'done' : ''}"><div class="n">${picked ? '✓' : '1'}</div><div style="flex:1">
      <div class="muted" style="font-size:13px">${t('pick_from')}${!picked && dShop != null ? ' · ' + fmtKm(dShop) : ''}</div><b>${esc(r.name || '')}</b>
      <div class="muted">${esc(r.address || '')}</div>
      ${picked ? '' : `<div class="two" style="margin-top:8px">${r.phone ? `<a class="btn ghost small" href="tel:${esc(r.phone)}">${t('call')}</a>` : '<span></span>'}
      <a class="btn ghost small" target="_blank" rel="noopener" href="${mapsUrl(r.lat, r.lng, (r.name || '') + ' ' + (r.address || ''))}">${t('open_maps')}</a></div>
      <div class="muted" style="margin-top:8px;font-size:14px">${t('items')}:</div><div style="font-size:15px">${items}</div>`}</div></div>`;
  const custBlock = `<div class="step ${picked ? '' : 'todo'}"><div class="n">2</div><div style="flex:1">
      <div class="muted" style="font-size:13px">${t('deliver_to')}${picked && dCust != null ? ' · ' + fmtKm(dCust) : ''}</div><b>${esc(c.full_name || t('customer'))}</b>
      <div class="muted">${esc(o.address_text || '')}</div>
      ${o.customer_note ? `<div class="note"><b>${t('cust_note')}:</b> ${esc(o.customer_note)}</div>` : ''}
      ${picked ? `<div class="two" style="margin-top:8px">${c.phone ? `<a class="btn ghost small" href="tel:${esc(c.phone)}">${t('call')}</a>` : `<span class="muted">${t('no_phone')}</span>`}
      <a class="btn ghost small" target="_blank" rel="noopener" href="${mapsUrl(o.address_lat, o.address_lng, o.address_text)}">${t('open_maps')}</a></div>` : ''}</div></div>`;
  const arrived = picked ? (o.arrived_at ? `<div class="note" style="background:rgba(31,111,74,.12)">✓ ${t('arrived_at', { t:new Date(o.arrived_at).toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' }) })}</div>`
    : `<button class="btn gold small" style="width:100%;margin-top:10px" onclick="A.arrived('${o.id}')">${t('arrived_btn')}</button>`) : '';
  const report = `<button class="btn warn small" style="width:100%" onclick="A.reportForm('${o.id}')">${t('report')}</button>`;
  const action = picked
    ? arrived + issueBlock(o) + slider(t('slide_delivered'), `A.markDelivered('${o.id}')`) + `<div class="actions">${report}</div>`
    : issueBlock(o) + slider(t('slide_picked'), `A.markPicked('${o.id}')`, true) + `<div class="actions"><button class="btn warn small" style="width:100%" onclick="A.giveBack('${o.id}')">${t('give_back')}</button>${report}</div>`;
  return `<div class="card live"><div class="ch"><span class="oid">#${esc(o.id.slice(-4).toUpperCase())}</span>
    <span class="pill">${t('st_' + o.status)}</span></div>${restBlock}${custBlock}
    <div class="cash"><span>${t('cash_collect')}</span><b>${money(o.total)}</b></div>
    <div class="line muted"><span>${t('your_pay')}</span><b>${money(o.rider_pay)}</b></div>${num(o.tip) ? `<div class="line" style="color:var(--green);font-weight:700"><span>💚 ${t('tip_incl')}</span><b>${money(o.tip)}</b></div>` : ''}${action}${chatRow(o)}</div>`;
}
function jobCard(j){
  const d = jobDistances(j);
  return `<div class="card" ${j.offered_to_me ? 'style="border:2px solid var(--marigold,#F2A900)"' : ''}>${j.offered_to_me ? `<div class="pill y" style="margin-bottom:6px">⭐ ${t('only_you')}</div>` : ''}<div class="ch"><b>${esc(j.restaurant_name)}</b><span class="muted">${t('ready_since')} ${timeAgo(j.status_since || j.created_at)}</span></div>
    <div class="muted">${esc(j.restaurant_address || '')}</div>
    <div style="margin-top:6px"><span class="muted">${t('deliver_to')}:</span> ${esc(j.drop_address || '')}</div>
    <div class="meta">${d.toShop != null ? `<span><b>${fmtKm(d.toShop)}</b> ${t('pickup_in')}</span>` : ''}${d.trip != null ? `<span><b>${fmtKm(d.trip)}</b> ${t('trip')}</span>` : ''}<span>${t('cash_collect')} <b>${money(j.total)}</b></span></div>
    <div class="cash"><span>${t('your_pay')}</span><b>${money(j.rider_pay)}</b></div>
    <button class="btn" onclick="A.acceptJob('${j.order_id}')">${t('accept')}</button></div>`;
}
function cashWarning(){
  const lim = num(state.rider.cash_limit), cash = num(state.cash);
  if (!lim) return '';
  if (cash >= lim) return `<div class="warnbox">${t('over_limit')} (${money(cash)} / ${money(lim)})</div>`;
  if (cash >= lim * 0.8) return `<div class="note">${t('near_limit')} (${money(cash)} / ${money(lim)})</div>`;
  return '';
}
// Contract and 8-hour duty
const CONTRACT_DEFAULT = { company:{ delivery_pay:0, overtime_per_hour:100, daily_hours:8 }, freelance:{ delivery_pay:70, overtime_per_hour:0, daily_hours:8 } };
function myContract(){
  const k = state.rider && state.rider.contract_type === 'company' ? 'company' : 'freelance';
  const all = (state.settings && state.settings.rider_contracts) || CONTRACT_DEFAULT;
  return Object.assign({ kind:k }, CONTRACT_DEFAULT[k], all[k] || {});
}
const t12 = v => { if (!v) return ''; const [h, m] = String(v).slice(0, 5).split(':').map(Number); return ((h % 12) || 12) + ':' + String(m).padStart(2, '0') + ' ' + (h < 12 ? 'AM' : 'PM'); };
function goalMinutes(){
  const r = state.rider || {}; const c = myContract();
  if (r.shift_start && r.shift_end && r.shift_start !== r.shift_end){
    const [a, b] = [r.shift_start, r.shift_end].map(x => { const [h, m] = String(x).slice(0, 5).split(':').map(Number); return h * 60 + m; });
    return Math.max(30, (b - a + (b < a ? 1440 : 0)) - num(r.break_minutes || 0));
  }
  return num(c.daily_hours) * 60;
}
function breakUsed(){ return num(state.breakDone) + (state.breakOpen ? (Date.now() - new Date(state.breakOpen.started_at)) / 60000 : 0); }
function scheduleLine(){
  const r = state.rider || {};
  if (!r.shift_start || !r.shift_end) return '';
  return `<div class="muted" style="font-size:14px;margin-top:2px">🕘 ${t('your_timing')}: <b>${t12(r.shift_start)} – ${t12(r.shift_end)}</b>${r.break_start ? ` · ☕ ${t('break_word')} ${t12(r.break_start)} (${num(r.break_minutes)} ${t('min_word')})` : ` · ☕ ${num(r.break_minutes)} ${t('min_word')} ${t('break_word')}`}</div>`;
}
function breakCard(){
  if (!onDuty()) return '';
  const r = state.rider || {}; const allow = num(r.break_minutes || 60); const used = breakUsed();
  if (state.breakOpen){
    const left = allow - used;
    return `<div class="card" style="border:2px solid ${left < 0 ? 'var(--danger)' : 'var(--marigold,#F2A900)'};text-align:center">
      <div style="font-size:30px">☕</div><b style="font-size:20px">${t('on_break')}</b>
      <div style="font-size:30px;font-weight:800;margin:6px 0;${left < 0 ? 'color:var(--danger)' : ''}" id="breakClock">${left < 0 ? '+' + hm(-left) : hm(left)}</div>
      <div class="muted" style="font-size:14px">${left < 0 ? t('break_over') : t('break_left')}</div>
      <button class="btn" style="margin-top:10px" onclick="A.endBreak()">${t('end_break')}</button></div>`;
  }
  return `<button class="btn ghost" style="margin-bottom:12px" onclick="A.startBreak()">☕ ${t('start_break')}${used ? ` <span class="muted" style="font-weight:600">(${hm(Math.max(0, allow - used))} ${t('left_word')})</span>` : ''}</button>`;
}
function targetsCard(){
  const list = state.targets || []; if (!list.length) return '';
  const per = { day:t('p_day'), week:t('p_week'), month:t('p_month') };
  return `<div class="card"><b>🎯 ${t('targets')}</b>${list.map(x => { const pct = Math.min(100, x.done / x.goal * 100);
    return `<div style="margin-top:10px"><div class="line"><span>${esc(x.title)} <span class="muted" style="font-size:12px">· ${per[x.period] || ''}</span></span><b style="color:${x.achieved ? 'var(--green)' : 'inherit'}">${x.achieved ? '✅ ' : ''}${money(x.amount)}</b></div>
      <div class="bar"><i style="width:${pct}%;${x.achieved ? '' : 'background:var(--marigold,#F2A900)'}"></i></div>
      <div class="muted" style="font-size:13px">${x.achieved ? t('target_done') : t('target_left').replace('{d}', x.done).replace('{g}', x.goal).replace('{k}', x.goal - x.done)}</div></div>`; }).join('')}</div>`;
}
function showPaySlip(){
  const r = state.rider, p = state.profile || {}; const sum = (l, f) => l.reduce((n, o) => n + num(f(o)), 0);
  const c = myContract(); const company = c.kind === 'company';
  const del = sum(state.done, o => o.rider_pay), fines = sum(state.fines.filter(f => f.status === 'active'), f => f.amount), bonus = sum(state.bonuses || [], b => b.amount);
  const otMin = num(state.ot && state.ot.overtime_minutes); const ot = company ? Math.round(otMin / 60 * num(c.overtime_per_hour)) : 0; const sal = company ? num(r.monthly_salary) : 0;
  const net = sal + del + ot + bonus - fines; const ms = ymd(monthStart()); const paid = sum(state.payouts.filter(x => x.period_start === ms), x => x.amount);
  const ln = (a, b, bold) => `<div style="display:flex;justify-content:space-between;gap:12px;margin:4px 0;${bold ? 'font-weight:800;font-size:16px' : ''}"><span style="flex:none">${a}</span><span style="text-align:end">${b}</span></div>`;
  const w = document.createElement('div'); w.id = 'slipWrap';
  w.style.cssText = 'position:fixed;inset:0;z-index:9500;background:rgba(0,0,0,.5);overflow:auto;padding:16px';
  w.innerHTML = `<style>@media print{body>*:not(#slipWrap){display:none!important}#slipWrap{position:static!important;background:#fff!important;padding:0!important}#slipWrap .nb{display:none!important}}</style>
    <div style="max-width:440px;margin:0 auto;background:#fff;color:#111;border-radius:14px;padding:20px;font-family:ui-monospace,Menlo,monospace;font-size:14px">
    <h2 style="margin:0;text-align:center;font-family:system-ui">Wanhar Mart</h2><div style="text-align:center">${t('pay_slip')} · ${esc(new Date().toLocaleDateString('en-GB', { month:'long', year:'numeric' }))}</div><hr>
    ${ln(t('name'), esc(p.full_name || ''))}${ln(t('phone'), esc(p.phone || ''))}${ln(t('contract'), esc(t('c_' + c.kind)))}<hr>
    ${company ? ln(t('salary'), money(sal)) : ''}${ln(t('delivery_pay') + ' (' + state.done.length + ')', money(del))}${company ? ln(t('overtime') + ' (' + hm(otMin) + ')', money(ot)) : ''}
    ${bonus ? ln(t('bonus_word'), money(bonus)) : ''}${ln(t('fines'), '−' + money(fines))}<hr>${ln(t('month_pay'), money(net), true)}${ln(t('paid'), money(paid))}${ln(t('to_pay'), money(Math.max(0, net - paid)), true)}
    <hr><div style="font-size:12px;color:#555">${t('slip_note')}</div></div>
    <div class="nb" style="max-width:440px;margin:12px auto 0;display:grid;gap:10px"><button class="btn" onclick="window.print()">${t('print_pdf')}</button><button class="btn ghost" style="background:#fff" onclick="document.getElementById('slipWrap').remove()">${t('close_word')}</button></div>`;
  document.body.appendChild(w);
}
function lbCard(){
  const lb = state.lb; if (!lb) return '';
  const per = state.lbPer || 'today'; const list = lb[per] || [];
  const aw = (state.settings && state.settings.rider_awards) || {};
  const prize = per === 'today' ? num(aw.day_prize) : num(aw.month_prize);
  const medal = n => n === 1 ? '🥇' : n === 2 ? '🥈' : n === 3 ? '🥉' : '#' + n;
  const me = list.find(x => x.is_me);
  const top = list.slice(0, 10);
  const rows = top.map(x => `<div class="line" style="${x.is_me ? 'background:rgba(31,111,74,.1);border-radius:10px;padding:6px 8px;font-weight:800' : 'padding:6px 8px'}"><span>${medal(x.rank)} ${esc(x.name || '')}${x.is_me ? ' (' + t('you_word') + ')' : ''}</span><span>${x.deliveries} ${x.rating ? '· ★' + x.rating : ''}</span></div>`).join('');
  const past = per === 'today' ? lb.yesterday[0] : lb.last_month[0];
  return `<div class="card" style="border:2px solid var(--marigold,#F2A900)">
    <div class="line"><b style="font-size:18px">🏆 ${per === 'today' ? t('rider_day') : t('rider_month')}</b></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0">
      <button class="btn ${per === 'today' ? '' : 'ghost'}" style="padding:10px" onclick="A.lbPer('today')">${t('today')}</button>
      <button class="btn ${per === 'month' ? '' : 'ghost'}" style="padding:10px" onclick="A.lbPer('month')">${t('this_month')}</button></div>
    ${prize ? `<div style="font-weight:800;color:#B45309;margin-bottom:6px">🎁 ${t('prize_word')}: ${money(prize)}</div>` : ''}
    ${me ? `<div style="margin-bottom:6px">${t('your_rank').replace('{r}', me.rank).replace('{n}', me.deliveries)}${me.rank > 1 && list[0] ? ' · ' + t('to_first').replace('{k}', list[0].deliveries - me.deliveries + 1) : ''}</div>` : `<div class="muted" style="margin-bottom:6px">${t('lb_start')}</div>`}
    ${rows || `<div class="muted">${t('lb_empty')}</div>`}
    ${me && me.rank > 10 ? `<div class="line" style="font-weight:800;padding:6px 8px">#${me.rank} ${esc(me.name)} <span>${me.deliveries}</span></div>` : ''}
    ${past ? `<div class="muted" style="font-size:13px;margin-top:8px">👑 ${per === 'today' ? t('winner_yday') : t('winner_lmonth')}: <b>${esc(past.name)}</b> (${past.deliveries})</div>` : ''}
  </div>`;
}
function tierCard(){
  const c = myContract(); const tiers = (Array.isArray(c.tiers) ? c.tiers : []).slice().sort((a, b) => num(a.from) - num(b.from));
  const tr = state.tier;
  if (!tiers.some(x => num(x.pay) > 0)) return '';
  const rows = tiers.map((x, i) => { const to = tiers[i + 1] ? num(tiers[i + 1].from) - 1 : null; const n = tr ? tr.deliveries + 1 : 1; const on = n >= num(x.from) && (to === null || n <= to);
    return `<div class="line" style="${on ? 'font-weight:800;color:var(--green)' : ''}"><span>${on ? '▶ ' : ''}${t('tier_range').replace('{a}', x.from).replace('{b}', to === null ? '+' : '– ' + to)}</span><span>${money(x.pay)}</span></div>`; }).join('');
  return `<div class="card"><b>${t('tier_title')}</b>
    ${tr ? `<div style="margin:6px 0">${t('tier_now').replace('{n}', tr.deliveries).replace('{p}', money(tr.current_pay))}</div>
    ${tr.next_from ? `<div class="muted" style="font-size:14px">🎯 ${t('tier_next').replace('{k}', tr.next_from - tr.deliveries - 1).replace('{p}', money(tr.next_pay))}</div>` : ''}` : ''}
    <div style="margin-top:8px">${rows}</div></div>`;
}
function dutyCard(){
  const c = myContract(); const goal = goalMinutes();
  const m = Math.max(0, num(state.todayMinutes) + (state.shift && state.todayAt ? (Date.now() - state.todayAt) / 60000 : 0) - breakUsed());
  const pct = goal ? Math.min(100, m / goal * 100) : 0; const ot = Math.max(0, m - goal);
  return `<div class="card">
    <div class="line"><b>${t('duty_today')}</b><span class="muted" style="font-size:13px">${t('c_' + c.kind)}</span></div>
    ${scheduleLine()}
    ${state.lateToday ? `<div style="color:var(--danger);font-weight:700;font-size:14px;margin-top:4px">⏰ ${t('late_today').replace('{m}', state.lateToday)}</div>` : ''}
    <div class="line"><b style="font-size:24px">${hm(m)}</b><span class="muted">${t('of_hours').replace('{h}', +(goal / 60).toFixed(1))}</span></div>
    <div class="bar"><i style="width:${pct}%;${ot > 0 ? 'background:var(--marigold,#F2A900)' : ''}"></i></div>
    <div style="font-size:14px;margin-top:6px">${ot > 0 && c.kind === 'company' ? `<b style="color:var(--green)">${t('ot_now')}: +${hm(ot)}</b>` : (m >= goal ? t('hours_done') : `<span class="muted">${t('hours_left').replace('{t}', hm(goal - m))}</span>`)}</div>
  </div>`;
}
function viewJobs(){
  const sound = (!audioReady() && state.sound && onDuty()) ? `<button class="soundbar" onclick="A.enableSound()">${t('enable_sound')}</button>` : '';
  const todayStart = new Date(); todayStart.setHours(0, 0, 0, 0);
  const today = state.done.filter(o => new Date(o.delivered_at) >= todayStart);
  const stats = `<div class="tiles" style="margin-bottom:12px">
    <div class="tile"><b>${today.length}</b><span>${t('deliveries_n')} · ${t('today')}</span></div>
    <div class="tile"><b>${money(today.reduce((n, o) => n + num(o.rider_pay), 0))}</b><span>${t('earn_today')}</span></div></div>`;
  if (!onDuty() && !state.mine.length){
    return `${stats}${cashWarning()}<div class="empty">${t('off_msg')}<br><br><button class="btn" style="max-width:280px;margin:0 auto" onclick="A.toggleDuty()">${t('start_duty')}</button></div>`;
  }
  const mine = state.mine.length ? `<h2>${t('my_deliveries')} <span class="count">${state.mine.length}</span></h2>${state.mine.map(activeCard).join('')}` : '';
  const list = state.available.filter(j => !state.skipped.has(j.order_id));
  const jobs = onDuty() ? (list.length ? `<h2>${t('new_jobs')} <span class="count">${list.length}</span></h2>${list.map(jobCard).join('')}`
    : (state.mine.length ? '' : `<div class="empty">${t('no_jobs')}<br><br><span style="font-size:14px">${t('keep_open')}</span></div>`)) : '';
  if (onDuty() && state.breakOpen) return sound + breakCard() + dutyCard();
  const meT = state.lb && state.lb.today.find(x => x.is_me);
  const rankChip = meT ? `<button class="note" style="width:100%;text-align:start;border:0;cursor:pointer;margin-bottom:10px" onclick="go('earn')">🏆 ${t('your_rank').replace('{r}', meT.rank).replace('{n}', meT.deliveries)} ›</button>` : '';
  return sound + cashWarning() + rankChip + (onDuty() && !state.mine.length ? targetsCard() + dutyCard() + breakCard() : '') + mine + (state.mine.length ? '' : stats) + jobs;
}

setInterval(() => { const el = document.getElementById('breakClock'); if (el && state.breakOpen){ const left = num(state.rider.break_minutes || 60) - breakUsed(); el.textContent = left < 0 ? '+' + hm(-left) : hm(left); el.style.color = left < 0 ? 'var(--danger)' : ''; } }, 15000);
// ================= EARNINGS TAB =================
function viewEarn(){
  const r = state.rider; const sum = (list, f) => list.reduce((n, o) => n + num(f(o)), 0);
  const deliveryPay = sum(state.done, o => o.rider_pay);
  const activeFines = state.fines.filter(f => f.status === 'active');
  const fines = sum(activeFines, f => f.amount);
  const c = myContract(); const otMin = num(state.ot && state.ot.overtime_minutes);
  const company = c.kind === 'company';
  const otPay = company ? Math.round(otMin / 60 * num(c.overtime_per_hour)) : 0;
  const salary = company ? num(r.monthly_salary) : 0;
  const bonusSum = (state.bonuses || []).reduce((n, b) => n + num(b.amount), 0);
  const monthPay = salary + deliveryPay + otPay + bonusSum - fines;
  const ms = ymd(monthStart());
  const paid = sum(state.payouts.filter(p => p.period_start === ms), p => p.amount);
  const lim = num(r.cash_limit), cash = num(state.cash);
  const pct = lim ? Math.min(100, cash / lim * 100) : 0;
  const rows = state.done.slice(0, 25).map(o => `<div class="row"><div><b>${esc(o.restaurant ? o.restaurant.name : '')}</b><div class="muted" style="font-size:13px">${when(o.delivered_at)}</div></div>
    <div class="r"><b>${money(o.rider_pay)}</b><div class="muted" style="font-size:13px">${money(o.total)} ${o.rider_settled ? '✓' : ''}</div></div></div>`).join('');
  const dep = state.handovers.map(h => `<div class="row"><div><b>${money(h.amount)}</b><div class="muted" style="font-size:13px">${h.orders_count} ${t('deliveries_n')}</div></div><div class="r muted" style="font-size:13px">${when(h.created_at)}</div></div>`).join('');
  const pay = state.payouts.map(p => `<div class="row"><div><b>${money(p.amount)}</b><div class="muted" style="font-size:13px">${esc(p.note || '')}</div></div><div class="r muted" style="font-size:13px">${when(p.created_at)}</div></div>`).join('');
  const monthName = new Date().toLocaleDateString(state.lang === 'ur' ? 'ur-PK' : 'en-GB', { month:'long', year:'numeric' });
  return `<h1>${t('earnings')}</h1>
    <div class="tiles">
      <div class="tile hi"><b>${money(monthPay)}</b><span>${t('month_pay')}</span></div>
      <div class="tile hi"><b>${money(Math.max(0, monthPay - paid))}</b><span>${t('to_pay')}</span></div>
      <div class="tile"><b>${state.done.length}</b><span>${t('deliveries_n')} · ${t('this_month')}</span></div>
      <div class="tile"><b>${hm(state.todayMinutes)}</b><span>${t('on_duty_time')} · ${t('today')}</span></div>
    </div>
    <button class="btn ghost" style="margin-bottom:12px" onclick="showPaySlip()">🧾 ${t('pay_slip_btn')}</button>
    ${targetsCard()}
    ${lbCard()}
    ${dutyCard()}
    <div class="card">
      <div class="line"><span class="muted">${t('contract')}</span><b>${t('c_' + c.kind)}</b></div>
      <div class="muted" style="font-size:14px">${company ? t('company_note').replace('{s}', money(r.monthly_salary)).replace('{r}', money(c.overtime_per_hour)) : t('free_note').replace('{p}', money(c.delivery_pay))}</div>
    </div>
    ${tierCard()}
    <h2>${esc(monthName)}</h2>
    <div class="card">
      ${company ? `<div class="line"><span class="muted">${t('salary')}</span><span>${money(salary)}</span></div>` : ''}
      <div class="line"><span class="muted">${t('delivery_pay')} (${state.done.length})</span><span>${money(deliveryPay)}</span></div>
      ${company ? `<div class="line"><span class="muted">${t('overtime')} (${hm(otMin)})</span><span>${money(otPay)}</span></div>` : ''}
      ${bonusSum ? `<div class="line"><span class="muted">🎁 ${t('bonus_word')} (${(state.bonuses || []).length})</span><span style="color:var(--green)">${money(bonusSum)}</span></div>` : ''}
      ${state.ot && num(state.ot.late_days) ? `<div class="line"><span class="muted">⏰ ${t('late_days')}</span><span class="red">${num(state.ot.late_days)}</span></div>` : ''}
      ${state.ot ? `<div class="line"><span class="muted">${t('on_duty_time')} · ${t('days_worked')} ${num(state.ot.days_worked)}</span><span>${hm(num(state.ot.duty_minutes))}</span></div>` : ''}
      <div class="line"><span class="muted">${t('fines')} (${activeFines.length})</span><span class="red">−${money(fines)}</span></div>
      <div class="line total"><span>${t('month_pay')}</span><span>${money(monthPay)}</span></div>
      <div class="line"><span class="muted">${t('paid')}</span><span>${money(paid)}</span></div>
    </div>
    <h2>${t('cash_in_hand')}</h2>
    <div class="card">
      <div class="line"><b style="font-size:24px" class="${lim && cash >= lim ? 'red' : ''}">${money(cash)}</b>${lim ? `<span class="muted">${t('cash_limit')} ${money(lim)}</span>` : ''}</div>
      ${lim ? `<div class="bar"><i class="${cash >= lim ? 'over' : ''}" style="width:${pct}%"></i></div>` : ''}
      <div class="muted" style="font-size:13px">${t('cash_note')}</div>
    </div>
    <h2>${t('recent')}</h2>${rows || `<div class="empty">${t('no_recent')}</div>`}
    ${dep ? `<h2>${t('deposits')}</h2>${dep}` : ''}
    ${pay ? `<h2>${t('payments')}</h2>${pay}` : ''}`;
}

// ================= RULES TAB =================
function viewRules(){
  const fines = state.fines.map(f => `<div class="row"><div><b>${esc(f.reason)}</b>${f.status === 'waived' ? ' <span class="pill g">✓</span>' : ''}<div class="muted" style="font-size:13px">${when(f.fined_at)}</div></div>
    <div class="r ${f.status === 'waived' ? 'muted' : 'red'}" style="${f.status === 'waived' ? 'text-decoration:line-through' : ''}"><b>−${money(f.amount)}</b></div></div>`).join('');
  const rules = state.rules.map(r => `<div class="row"><div>${esc(r.title)}</div><div class="r red"><b>${money(r.amount)}</b></div></div>`).join('');
  return `<h1>${t('rules')}</h1>
    ${state.rating ? `<div class="tiles" style="margin-bottom:12px"><div class="tile hi"><b>★ ${state.rating.avg}</b><span>${t('rating')} (${state.rating.n})</span></div><div class="tile"><b>${state.fines.filter(f => f.status === 'active').length}</b><span>${t('fines')} · ${t('this_month')}</span></div></div>` : ''}
    <h2 style="margin-top:0">${t('my_fines')}</h2>${fines || `<div class="card muted">${t('no_fines')}</div>`}
    <h2>${t('rules_title')}</h2><p class="muted" style="margin-top:0">${t('rules_note')}</p>${rules}`;
}

// ================= ACCOUNT TAB =================
function viewAcct(){
  const p = state.profile || {}, r = state.rider; const reg = !!r.face_descriptor;
  return `<h1>${t('account')}</h1>
    <div class="card" style="display:flex;gap:14px;align-items:center">
      <div class="face" id="myFace">${esc((p.full_name || '?')[0])}</div>
      <div><b>${esc(p.full_name || '')}</b><div class="muted">${esc(p.phone || '')}</div><div class="muted" style="font-size:14px">${esc(state.user.email)}</div>
      <div class="muted" style="font-size:14px">${t('vehicle')}: ${esc(r.vehicle || '')}</div>
      <div style="margin-top:4px"><span class="pill ${reg ? '' : 'y'}">${reg ? t('face_ok') : t('face_missing')}</span></div></div>
    </div>
    ${reg ? '' : `<button class="btn gold" style="margin-bottom:12px" onclick="openCamera('register')">${t('register_face')}</button>`}
    <div class="card" style="display:flex;justify-content:space-between;align-items:center"><b>${t('sound')}</b>
      <label class="switch"><input type="checkbox" ${state.sound ? 'checked' : ''} onchange="A.setSound(this.checked)"><span></span></label></div>
    <button class="btn ghost" style="margin-bottom:10px" onclick='Chat.open(null, "sup", state.user.id)'>💬 ${t('chat_support')}</button>
    ${state.settings.support_phone ? `<a class="btn ghost" style="margin-bottom:10px" href="tel:${esc(state.settings.support_phone)}">${t('call_support')}</a>` : ''}
    ${Legal.links(state.lang)}
    <div class="actions"><button class="btn ghost" onclick="A.toggleLang()">${t('language')}: ${state.lang === 'ur' ? 'English' : 'اردو'}</button>
    <button class="btn warn" onclick="A.logout()">${t('logout')}</button></div>
    <p class="ver" style="margin-top:14px">Wanhar Mart Rider v${APP_VERSION}</p>`;
}
async function showMyFace(){
  if (!state.rider || !state.rider.face_photo_path) return;
  const { data } = await sb.storage.from('rider-selfies').createSignedUrl(state.rider.face_photo_path, 3600);
  const el = $('myFace'); if (el && data && data.signedUrl) el.innerHTML = `<img src="${data.signedUrl}" alt="">`;
}

// ================= ACTIONS =================
let pollTimer = null, channel = null;
const A = {
  toggleLang(onAuth){
    state.lang = state.lang === 'ur' ? 'en' : 'ur'; ls.set('kh_lang', state.lang); applyLang();
    if (onAuth || !state.rider || !state.rider.is_approved){ if (state.user) return route(); return showAuth(); }
    renderShell(); markTab(); renderTab();
  },
  async forgotPw(){
    const email = ($('a_email') && $('a_email').value.trim()) || '';
    const msg = $('authMsg');
    if (!email){ msg.style.color = ''; msg.textContent = t('enter_email_first'); $('a_email').focus(); return; }
    msg.textContent = t('loading');
    const { error } = await sb.auth.resetPasswordForEmail(email, { redirectTo:new URL('reset.html?app=rider', location.href).href });
    if (error){ msg.style.color = ''; msg.textContent = error.message; return; }
    msg.style.color = 'var(--green)'; msg.textContent = t('reset_sent');
  },
  switchAuth(){ state.authMode = state.authMode === 'signup' ? 'login' : 'signup'; showAuth(); },
  async submitAuth(e){
    e.preventDefault(); unlockAudio();
    const signup = state.authMode === 'signup';
    const email = $('a_email').value.trim(), pw = $('a_pw').value; const msg = $('authMsg'); msg.style.color = ''; msg.textContent = '';
    if (!email || !pw){ msg.textContent = t('enter_all'); return; }
    if (pw.length < 6){ msg.textContent = t('short_pw'); return; }
    let name = '', phone = '';
    if (signup){
      name = $('a_name').value.trim(); phone = normalizePhone($('a_phone').value);
      if (!name){ msg.textContent = t('enter_all'); return; }
      if (!phone){ msg.textContent = t('bad_phone'); return; }
    }
    const btn = $('authBtn'); btn.disabled = true; btn.textContent = t('loading');
    try {
      if (signup){
        const { data, error } = await sb.auth.signUp({ email, password:pw, options:{ data:{ full_name:name }, emailRedirectTo:new URL('verified.html?app=rider', location.href).href } });
        if (error) throw error;
        if (!data.session){ state.authMode = 'login'; showAuth(t('confirm_email'), true); return; }
        await sb.from('profiles').update({ full_name:name, phone }).eq('id', data.user.id);
        await afterLogin(data.user);
      } else {
        const { data, error } = await sb.auth.signInWithPassword({ email, password:pw });
        if (error) throw error; await afterLogin(data.user);
      }
    } catch (err) {
      logErr(err);
      const m = /invalid login/i.test((err && err.message) || '') ? t('bad_login') : ((err && err.message) || t('error'));
      const el = $('authMsg'); if (el) el.textContent = m;
      const b = $('authBtn'); if (b){ b.disabled = false; b.textContent = signup ? t('signup') : t('login'); }
    }
  },
  async submitProfile(){
    const btn = $('profBtn'); btn.disabled = true;
    await run(async () => {
      need(await sb.from('riders').insert({ profile_id:state.user.id, vehicle:$('p_vehicle').value, cnic:$('p_cnic').value.trim() || null }));
      await loadRider(); await route();
    });
    const b = $('profBtn'); if (b) b.disabled = false;
  },
  async recheck(){ await run(async () => { await loadRider(); await route(); }); },
  async logout(){
    if (onDuty()){ try { await sb.rpc('end_shift'); } catch (e) {} }
    await Push.logout(); Chat.stop(); Chat.close(); await sb.auth.signOut(); stopGeo(); closeJobPopup();
    if (pollTimer){ clearInterval(pollTimer); pollTimer = null; }
    if (channel){ sb.removeChannel(channel); channel = null; }
    state.user = null; state.rider = null; state.profile = null; state.mine = []; state.available = []; state.authMode = 'login'; showAuth();
  },

  // ---- Duty ----
  lbPer(p){ state.lbPer = p; renderTab(); },
  async startBreak(){
    if (!confirm(t('break_q'))) return;
    await run(async () => { need(await sb.rpc('start_break')); await loadShift(); state.available = []; closeJobPopup(); renderTab(); toast(t('on_break')); });
  },
  async endBreak(){
    await run(async () => { need(await sb.rpc('end_break')); await loadShift(); await loadJobs(); renderTab(); toast(t('break_ended')); });
  },
  async toggleDuty(){
    unlockAudio();
    if (onDuty()){
      if (!confirm(t('end_duty_q'))) return;
      return run(async () => {
        need(await sb.rpc('end_shift'));
        state.rider.is_online = false; state.shift = null; stopGeo(); updateDutyBtn(); toast(t('duty_ended')); await go('jobs');
      });
    }
    await run(loadRider);
    if (!state.rider.face_descriptor) return openCamera('register');
    openCamera('duty');
  },
  skipFace(){ closeOverlay(); A.beginShift(null, null, null); },
  async capture(mode){
    const v = $('camv'), btn = $('camBtn'), fs = $('fstate'), ring = $('ring');
    if (!v || !btn) return;
    if (btn.dataset.retake){ delete btn.dataset.retake; v.style.display = ''; $('camimg').style.display = 'none'; ring.className = 'ring'; fs.textContent = ''; btn.textContent = t('take_photo'); return; }
    btn.disabled = true; fs.className = 'facestate'; fs.textContent = t('loading');
    try {
      const canvas = snap(v);
      $('camimg').src = canvas.toDataURL('image/jpeg', 0.7); $('camimg').style.display = ''; v.style.display = 'none';
      const res = await analyse(canvas);
      const retake = msg => { ring.className = 'ring bad'; fs.className = 'facestate red'; fs.textContent = msg; btn.dataset.retake = '1'; btn.textContent = t('retake'); btn.disabled = false; };
      if (res.err) return retake(t(res.err));
      if (mode === 'register'){
        const path = await uploadSelfie(canvas, 'face');
        need(await sb.from('riders').update({ face_descriptor:res.descriptor, face_photo_path:path }).eq('id', state.rider.id));
        state.rider.face_descriptor = res.descriptor; state.rider.face_photo_path = path;
        ring.className = 'ring ok'; fs.className = 'facestate'; fs.style.color = 'var(--green)'; fs.textContent = t('face_saved');
        toast(t('face_saved'));
        setTimeout(() => { closeOverlay(); if (state.tab === 'acct') renderTab(); else openCamera('duty'); }, 900);
        return;
      }
      const dist = faceapi.euclideanDistance(res.descriptor, state.rider.face_descriptor);
      const ok = dist <= threshold();
      if (!ok && requireSelfie()) return retake(t('face_nomatch'));
      ring.className = 'ring ' + (ok ? 'ok' : 'bad'); fs.style.color = ok ? 'var(--green)' : ''; fs.textContent = ok ? t('face_match') : t('face_nomatch');
      const path = await uploadSelfie(canvas, 'shift');
      await A.beginShift(path, Math.round(dist * 1000) / 1000, ok);
    } catch (e) {
      logErr(e); fs.className = 'facestate red'; fs.textContent = (e && e.message) || t('error');
      btn.dataset.retake = '1'; btn.textContent = t('retake'); btn.disabled = false;
    }
  },
  async beginShift(path, score, ok){
    const fs = $('fstate'); if (fs) fs.textContent = t('getting_loc');
    const pos = await getPosOnce();
    await run(async () => {
      need(await sb.rpc('start_shift', { p_selfie_path:path, p_face_score:score, p_face_ok:ok, p_lat:pos ? pos.lat : null, p_lng:pos ? pos.lng : null }));
      closeOverlay();
      state.rider.is_online = true; await loadShift(); updateDutyBtn(); startGeo(); keepAwake();
      state.firstLoadDone = false; state.seen = new Set(); state.skipped = new Set();
      toast(t('duty_started')); await go('jobs');
    });
    const b = $('camBtn'); if (b){ b.disabled = false; }
  },

  enableSound(){ unlockAudio(); setTimeout(() => { beep(); renderTab(); }, 200); },
  setSound(v){ state.sound = v; ls.set('kh_rd_sound', v); if (v){ unlockAudio(); setTimeout(beep, 200); } },

  // ---- Problems ----
  async arrived(id){
    await run(async () => { need(await sb.rpc('rider_arrived', { p_order_id:id })); await loadJobs(); renderTab(); toast(t('saved')); });
  },
  reportForm(id){
    const o = state.mine.find(x => x.id === id); if (!o) return;
    const kinds = o.status === 'picked_up'
      ? ['customer_unreachable','customer_absent','customer_refused_pay','wrong_address','order_damaged','accident','rider_delay','other']
      : ['shop_delay','shop_closed','accident','rider_delay','other'];
    state.pickKind = null;
    const sup = state.settings.support_phone;
    closeOverlay();
    const el = document.createElement('div'); el.className = 'over'; el.id = 'overlay';
    el.addEventListener('click', e => { if (e.target === el) closeOverlay(); });
    el.innerHTML = `<div class="panel" role="dialog" aria-modal="true">
      <div class="ch"><h1 style="margin:0">${t('report_title')}</h1><button class="pillbtn" onclick="closeOverlay()">✕</button></div>
      ${o.status === 'picked_up' && o.customer && o.customer.phone ? `<a class="btn ghost" style="margin-bottom:10px" href="tel:${esc(o.customer.phone)}">${t('call_customer')} ${esc(o.customer.phone)}</a>` : ''}
      <div class="probs" id="probs">${kinds.map(k => `<button onclick="A.pickKind('${k}', this)">${t('k_' + k)}</button>`).join('')}</div>
      <label class="f" for="pnote">${t('note_opt')}</label><textarea id="pnote" rows="2"></textarea>
      <div class="actions"><button class="btn" onclick="A.sendReport('${id}')">${t('send_report')}</button>
      ${sup ? `<a class="btn ghost" href="tel:${esc(sup)}">${t('call_support')}</a>` : ''}</div></div>`;
    document.body.appendChild(el);
  },
  pickKind(k, btn){ state.pickKind = k; document.querySelectorAll('#probs button').forEach(b => b.classList.toggle('on', b === btn)); },
  async sendReport(id){
    if (!state.pickKind) return toast(t('pick_problem'), true);
    await run(async () => {
      need(await sb.rpc('report_issue', { p_order_id:id, p_kind:state.pickKind, p_note:($('pnote').value || '').trim() || null }));
      closeOverlay(); await loadJobs(); renderTab(); toast(t('reported'));
    });
  },
  async returnOrder(id){
    await run(async () => { need(await sb.rpc('rider_return_order', { p_order_id:id })); await loadJobs(); renderTab(); toast(t('returned_toast')); });
    renderTab();
  },

  // ---- Deliveries ----
  skipJob(id, offered){ state.skipped.add(id); closeJobPopup(); if (offered) sb.rpc('decline_offer', { p_order:id }).then(() => {}, () => {}); if (state.tab === 'jobs') renderTab(); },
  async acceptJob(id){
    closeJobPopup();
    await run(async () => {
      const { error } = await sb.rpc('accept_delivery', { p_order_id:id });
      await loadJobs(); await loadMoney(); if (state.tab !== 'jobs') state.tab = 'jobs'; renderTab();
      if (error) throw error;
      toast(t('accepted')); window.scrollTo(0, 0);
    });
  },
  async markPicked(id){
    await run(async () => { need(await sb.rpc('update_order_status', { p_order_id:id, p_status:'picked_up' })); await loadJobs(); renderTab(); toast(t('saved')); });
    renderTab();
  },
  async markDelivered(id){
    await run(async () => { need(await sb.rpc('update_order_status', { p_order_id:id, p_status:'delivered' })); await Promise.all([loadJobs(), loadMoney()]); renderTab(); toast(t('saved')); });
    renderTab();
  },
  async giveBack(id){
    if (!confirm(t('confirm_giveback'))) return;
    await run(async () => { need(await sb.rpc('release_delivery', { p_order_id:id })); state.skipped.add(id); await loadJobs(); renderTab(); toast(t('saved')); });
  }
};

// ================= START =================
async function route(){
  if (!state.rider) return showProfileForm();
  if (!state.rider.is_approved) return showPending();
  await startApp();
}
async function startApp(){
  renderShell();
  try {
    if (channel) sb.removeChannel(channel);
    channel = sb.channel('rider-orders').on('postgres_changes',
      { event:'*', schema:'public', table:'orders', filter:'rider_id=eq.' + state.rider.id }, () => refresh())
      .on('postgres_changes', { event:'*', schema:'public', table:'order_issues', filter:'rider_id=eq.' + state.rider.id }, () => refresh()).subscribe();
  } catch (e) { console.warn('Live updates are off', e); }
  if (!pollTimer) pollTimer = setInterval(() => { if (state.user) refresh(); }, 8000);
  Chat.init({ me:() => state.user && state.user.id, lang:() => state.lang, role:'rider', ding:() => beep(), toast:(m, err) => toast(m, err) });
  Legal.init({ sb, lang:() => state.lang, toast:(m, err) => toast(m, err) });
  Push.init({ sb, app:'rider', me:() => state.user && state.user.id, lang:() => state.lang, toast:(m, err) => toast(m, err) });
  if (onDuty()){ startGeo(); keepAwake(); }
  getPosOnce();
  await run(loadShift); updateDutyBtn();
  await go('jobs');
}
async function afterLogin(user){ state.user = user; await loadRider(); await route(); }
// ================= CHAT (same code in all four apps) =================
const Chat = (() => {
  const L = {
    en: {
      messages:'Messages', support:'Wanhar Mart support', support_sub:'Ask us anything', no_chats:'No messages yet.', write:'Write a message…', send:'Send',
      new_msg:'New message', you:'You', customer:'Customer', rider:'Rider', shop:'Shop', admin:'Wanhar Mart', order:'Order',
      'as_customer.cr':'Rider', 'as_customer.cs':'Shop', 'as_customer.sup_c':'Wanhar Mart support',
      'as_rider.cr':'Customer', 'as_rider.rs':'Shop', 'as_rider.sup_r':'Wanhar Mart support',
      'as_shop.cs':'Customer', 'as_shop.rs':'Rider', 'as_shop.sup_s':'Wanhar Mart support',
      'as_admin.cr':'Customer and rider', 'as_admin.cs':'Customer and shop', 'as_admin.rs':'Rider and shop',
      'as_admin.sup_c':'Support: customer', 'as_admin.sup_r':'Support: rider', 'as_admin.sup_s':'Support: shop', sup:'Support',
      q_customer_cr:['Please call me','I am coming down','Please leave it at the door','Where are you now?'],
      q_customer_cs:['How long will my order take?','Please make it less spicy','Please add extra sauce','Please pack it well'],
      q_customer_sup:['My order is late','I have a problem with my order','Wrong or missing items','I want to cancel my order','Please call me'],
      q_rider_cr:['I am on my way','I have arrived, please come outside','I cannot find your address, please call me','Please keep the cash ready'],
      q_rider_rs:['I am at the shop, is the order ready?','I will reach in 5 minutes','Please pack the order properly','I am waiting outside'],
      q_rider_sup:['Customer is not answering','I need help with an order','My vehicle has a problem','Question about my pay','Please call me'],
      q_shop_cs:['Your order is being prepared','Your order is ready','Sorry, one item is not available','It will take 10 more minutes'],
      q_shop_rs:['The order is ready, please come','Ready in 10 minutes','Where are you?','Please come soon, I am waiting'],
      q_shop_sup:['I have a problem with an order','When will I receive my payment?','The rider is late','Please call me'],
      q_admin_cr:['Wanhar Mart here. How can we help?','Please share what happened','Thank you, we are solving it'],
      q_admin_cs:['Wanhar Mart here. How can we help?','Please share what happened','Thank you, we are solving it'],
      q_admin_rs:['Wanhar Mart here. How can we help?','Please share what happened','Thank you, we are solving it'],
      q_admin_sup:['Hello, how can we help you?','We are looking into it','Thank you for waiting','Please call us'],
      q_admin:['We are looking into it','Thank you for waiting','Please call us'],
      ask_join:'Call Wanhar Mart', ask_reason:'Tell Wanhar Mart what the problem is (for example: customer paid less cash):', ask_sent:'Wanhar Mart has been asked to join this chat',
      sys_req:'{w} asked Wanhar Mart to join this chat', sys_joined:'Wanhar Mart joined the chat. Please explain the problem.'
    },
    ur: {
      messages:'پیغامات', support:'Wanhar Mart سپورٹ', support_sub:'ہم سے کچھ بھی پوچھیں', no_chats:'ابھی کوئی پیغام نہیں۔', write:'پیغام لکھیں…', send:'بھیجیں',
      new_msg:'نیا پیغام', you:'آپ', customer:'گاہک', rider:'رائیڈر', shop:'دکان', admin:'Wanhar Mart', order:'آرڈر',
      'as_customer.cr':'رائیڈر', 'as_customer.cs':'دکان', 'as_customer.sup_c':'Wanhar Mart سپورٹ',
      'as_rider.cr':'گاہک', 'as_rider.rs':'دکان', 'as_rider.sup_r':'Wanhar Mart سپورٹ',
      'as_shop.cs':'گاہک', 'as_shop.rs':'رائیڈر', 'as_shop.sup_s':'Wanhar Mart سپورٹ',
      sup:'سپورٹ',
      q_customer_cr:['مجھے کال کریں','میں نیچے آ رہا ہوں','دروازے پر رکھ دیں','آپ ابھی کہاں ہیں؟'],
      q_customer_cs:['میرا آرڈر کتنی دیر میں تیار ہوگا؟','مرچ کم رکھیں','ساس زیادہ ڈال دیں','اچھی طرح پیک کریں'],
      q_customer_sup:['میرا آرڈر لیٹ ہے','میرے آرڈر میں مسئلہ ہے','غلط یا کم چیزیں آئیں','میں آرڈر منسوخ کرنا چاہتا ہوں','مجھے کال کریں'],
      q_rider_cr:['میں راستے میں ہوں','میں پہنچ گیا ہوں، براہ کرم باہر آئیں','آپ کا پتہ نہیں مل رہا، مجھے کال کریں','براہ کرم نقد رقم تیار رکھیں'],
      q_rider_rs:['میں دکان پر ہوں، آرڈر تیار ہے؟','میں 5 منٹ میں پہنچ رہا ہوں','آرڈر اچھی طرح پیک کریں','میں باہر انتظار کر رہا ہوں'],
      q_rider_sup:['گاہک فون نہیں اٹھا رہا','ایک آرڈر میں مدد چاہیے','میری گاڑی میں مسئلہ ہے','میری اجرت کے بارے میں سوال','مجھے کال کریں'],
      q_shop_cs:['آپ کا آرڈر تیار ہو رہا ہے','آپ کا آرڈر تیار ہے','معذرت، ایک چیز دستیاب نہیں','10 منٹ مزید لگیں گے'],
      q_shop_rs:['آرڈر تیار ہے، آ جائیں','10 منٹ میں تیار ہوگا','آپ کہاں ہیں؟','جلدی آئیں، میں انتظار کر رہا ہوں'],
      q_shop_sup:['ایک آرڈر میں مسئلہ ہے','میری ادائیگی کب ملے گی؟','رائیڈر لیٹ ہے','مجھے کال کریں'],
      q_admin:['ہم دیکھ رہے ہیں','انتظار کا شکریہ','براہ کرم ہمیں کال کریں'],
      ask_join:'Wanhar Mart کو بلائیں', ask_reason:'Wanhar Mart کو مسئلہ بتائیں (مثلاً: گاہک نے کم رقم دی):', ask_sent:'Wanhar Mart کو اس چیٹ میں بلا لیا گیا',
      sys_req:'{w} نے Wanhar Mart کو چیٹ میں بلایا', sys_joined:'Wanhar Mart چیٹ میں شامل ہو گیا۔ براہ کرم مسئلہ بتائیں۔'
    }
  };
  let cfg = null, cur = null, chan = null, seenIds = new Set(), unread = {};
  const lang = () => (cfg && cfg.lang && cfg.lang()) === 'ur' ? 'ur' : 'en';
  const tr = k => (L[lang()][k] !== undefined ? L[lang()][k] : L.en[k] !== undefined ? L.en[k] : k);
  const e = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const me = () => cfg && cfg.me && cfg.me();
  const keyOf = m => (m.order_id || '') + '|' + m.thread + '|' + (m.user_id || '');
  const seenTs = k => { try { return localStorage.getItem('wm_chat_' + k) || ''; } catch (x) { return ''; } };
  const setSeen = (k, ts) => { try { if (ts > seenTs(k)) localStorage.setItem('wm_chat_' + k, ts); } catch (x) {} };
  const hm = ts => new Date(ts).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
  function label(thread, orderId, name){
    const base = thread === 'sup' ? (cfg.role === 'admin' ? tr('sup') + (name ? ': ' + name : '') : tr('support')) : tr('as_' + cfg.role + '.' + thread);
    return base + (orderId ? ' · #' + String(orderId).slice(-4).toUpperCase() : '');
  }
  if (!document.getElementById('chatCss')){
    const st = document.createElement('style'); st.id = 'chatCss';
    st.textContent = `.cbtn{position:relative;display:grid;place-items:center;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;flex:none;font-size:19px}
.cbtn .cn{position:absolute;top:-4px;inset-inline-end:-4px;background:#B3261E;color:#fff;font-size:11px;font-weight:800;min-width:19px;height:19px;border-radius:10px;display:none;place-items:center;padding:0 4px}
.chatwrap{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center}
.chatbox{background:var(--paper);width:100%;max-width:640px;height:92%;border-radius:18px 18px 0 0;display:flex;flex-direction:column;overflow:hidden}
.chathead{display:flex;align-items:center;gap:10px;padding:14px 14px 12px;background:var(--surface);border-bottom:1px solid var(--line)}
.chathead b{flex:1;font-size:18px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chathead button{background:none;border:0;font-size:26px;cursor:pointer;color:var(--muted);padding:2px 8px}
.chatlist{flex:1;overflow:auto;padding:12px}
.chatrow{display:flex;gap:12px;align-items:center;width:100%;text-align:start;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:8px;cursor:pointer;color:inherit}
.chatrow .av{width:42px;height:42px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-weight:800;flex:none}
.chatrow .tx{flex:1;min-width:0}.chatrow .tx div{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chatrow .ub{background:#B3261E;color:#fff;border-radius:10px;font-size:12px;font-weight:800;padding:1px 8px}
.msgs{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:6px}
.bub{max-width:80%;padding:8px 12px;border-radius:14px;background:var(--surface);border:1px solid var(--line);align-self:flex-start;word-wrap:break-word;white-space:pre-wrap}
.sysmsg{align-self:center;max-width:90%;text-align:center;background:rgba(242,169,0,.18);border-radius:12px;padding:8px 12px;font-size:14px;font-weight:700}
.sysmsg small{display:block;font-weight:400;opacity:.7;font-size:11px}
.askbtn{border:1px solid #B3261E !important;color:#B3261E !important;background:transparent;border-radius:999px;font-size:13px !important;font-weight:800;padding:6px 10px !important;white-space:nowrap}
.bub.mine{align-self:flex-end;background:var(--green);color:#fff;border-color:var(--green)}
.bub small{display:block;font-size:11px;opacity:.7;margin-top:2px}
.bub .who{font-size:12px;font-weight:800;color:var(--green);display:block}
.quick{display:flex;gap:6px;overflow-x:auto;padding:8px 12px 0}
.quick button{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 12px;font-size:13px;cursor:pointer;color:inherit}
.chatin{display:flex;gap:8px;padding:10px 12px calc(12px + env(safe-area-inset-bottom,0px));background:var(--surface);border-top:1px solid var(--line)}
.chatin textarea{flex:1;min-height:44px;max-height:120px;resize:none;border:1px solid var(--line);border-radius:12px;padding:10px;font:inherit;background:var(--paper);color:var(--ink)}
.chatin button{border:0;background:var(--green);color:#fff;border-radius:12px;padding:0 18px;font-weight:800;cursor:pointer}`;
    document.head.appendChild(st);
  }
  function button(){ return `<button class="cbtn" onclick="Chat.inbox()" aria-label="${e(tr('messages'))}">💬<span class="cn" id="chatN"></span></button>`; }
  function paintBadge(){
    const n = Object.values(unread).reduce((a, b) => a + b, 0);
    document.querySelectorAll('#chatN').forEach(el => { el.textContent = n; el.style.display = n ? 'grid' : 'none'; });
    if (cfg && cfg.onUnread) cfg.onUnread(n);
  }
  function init(c){
    cfg = c; stop();
    chan = sb.channel('chat-' + me()).on('postgres_changes', { event:'INSERT', schema:'public', table:'messages' }, p => onMsg(p.new)).subscribe();
    refresh();
  }
  function stop(){ if (chan){ try { sb.removeChannel(chan); } catch (x) {} chan = null; } }
  async function refresh(){
    if (!me()) return;
    const since = new Date(Date.now() - 7 * 864e5).toISOString();
    const { data } = await sb.from('messages').select('id,order_id,thread,user_id,sender_id,created_at').gte('created_at', since).neq('sender_id', me()).order('created_at', { ascending:false }).limit(400);
    unread = {};
    (data || []).forEach(m => { seenIds.add(m.id); const k = keyOf(m); if (m.created_at > seenTs(k) && (!cur || cur.k !== k)) unread[k] = (unread[k] || 0) + 1; });
    paintBadge();
  }
  function onMsg(m){
    if (!m || seenIds.has(m.id)) return; seenIds.add(m.id);
    const k = keyOf(m);
    if (cur && cur.k === k){ if (!cur.msgs.some(x => x.id === m.id)) cur.msgs.push(m); draw(); setSeen(k, m.created_at); return; }
    if (m.sender_id !== me()){
      unread[k] = (unread[k] || 0) + 1; paintBadge();
      if (cfg.ding) cfg.ding();
      if (cfg.toast) cfg.toast('💬 ' + tr('new_msg') + ': ' + fmt(m).slice(0, 70));
      if ($('inboxList')) inbox();
    }
  }
  function shell(title, inner, extra){
    close();
    const w = document.createElement('div'); w.className = 'chatwrap'; w.id = 'chatWrap';
    w.addEventListener('click', ev => { if (ev.target === w) close(); });
    w.innerHTML = `<div class="chatbox" role="dialog" aria-modal="true"><div class="chathead"><b>${e(title)}</b>${extra || ''}<button onclick="Chat.close()" aria-label="Close">&times;</button></div>${inner}</div>`;
    document.body.appendChild(w);
  }
  function close(){ cur = null; const w = document.getElementById('chatWrap'); if (w) w.remove(); }
  async function inbox(){
    const since = new Date(Date.now() - 14 * 864e5).toISOString();
    const { data } = await sb.from('messages').select('*').gte('created_at', since).order('created_at', { ascending:false }).limit(cfg.role === 'admin' ? 800 : 300);
    const groups = {};
    (data || []).forEach(m => { const k = keyOf(m); if (!groups[k]) groups[k] = { k, last:m, order_id:m.order_id, thread:m.thread, user_id:m.user_id }; });
    let names = {};
    const uids = [...new Set(Object.values(groups).filter(g => g.user_id).map(g => g.user_id))];
    if (cfg.role === 'admin' && uids.length){ const p = await sb.from('profiles').select('id,full_name,role').in('id', uids); (p.data || []).forEach(x => { names[x.id] = (x.full_name || '') + ' (' + x.role + ')'; }); }
    const rows = Object.values(groups).map(g => {
      const n = unread[g.k] || 0; const title = label(g.thread, g.order_id, names[g.user_id]);
      return `<button class="chatrow" onclick='Chat.open(${e(JSON.stringify(g.order_id))}, ${e(JSON.stringify(g.thread))}, ${e(JSON.stringify(g.user_id))}, ${e(JSON.stringify(title))})'>
        <span class="av">${g.thread.startsWith('sup') ? '★' : e(title[0])}</span>
        <span class="tx"><div><b>${e(title)}</b></div><div class="muted" style="font-size:14px">${g.last.sender_id === me() && g.last.sender_role !== 'system' ? e(tr('you')) + ': ' : ''}${e(fmt(g.last))}</div><div class="muted" style="font-size:12px">${hm(g.last.created_at)}</div></span>
        ${n ? `<span class="ub">${n}</span>` : ''}</button>`;
    }).join('');
    const sup = cfg.role === 'admin' ? '' : `<button class="chatrow" onclick='Chat.open(null, "sup", ${e(JSON.stringify(me()))}, ${e(JSON.stringify(tr('support')))})'><span class="av">★</span><span class="tx"><div><b>${e(tr('support'))}</b></div><div class="muted" style="font-size:14px">${e(tr('support_sub'))}</div></span></button>`;
    if (document.getElementById('inboxList')) document.getElementById('inboxList').innerHTML = sup + (rows || `<div class="muted" style="text-align:center;padding:30px">${e(tr('no_chats'))}</div>`);
    else shell(tr('messages'), `<div class="chatlist" id="inboxList">${sup}${rows || `<div class="muted" style="text-align:center;padding:30px">${e(tr('no_chats'))}</div>`}</div>`);
  }
  async function open(orderId, thread, userId, title){
    const k = (orderId || '') + '|' + thread + '|' + (userId || '');
    cur = { orderId, thread, userId, k, msgs:[] };
    const qk = 'q_' + cfg.role + '_' + (thread.startsWith('sup') ? 'sup' : thread);
    const quick = (L[lang()][qk] || L.en[qk] || []);
    shell(title || label(thread, orderId), `<div class="msgs" id="msgs"><div class="muted" style="text-align:center">…</div></div>
      ${quick.length ? `<div class="quick">${quick.map(q => `<button onclick='Chat.send(${e(JSON.stringify(q))})'>${e(q)}</button>`).join('')}</div>` : ''}
      <div class="chatin"><textarea id="chatText" rows="1" placeholder="${e(tr('write'))}" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();Chat.send();}"></textarea><button onclick="Chat.send()">${e(tr('send'))}</button></div>`,
      (cfg.role !== 'admin' && orderId && ['cr','cs','rs'].includes(thread)) ? `<button class="askbtn" onclick="Chat.askJoin()">🛟 ${e(tr('ask_join'))}</button>` : '');
    cur = { orderId, thread, userId, k, msgs:[] };
    let q = sb.from('messages').select('*').eq('thread', thread).order('created_at').limit(300);
    q = orderId ? q.eq('order_id', orderId) : q.is('order_id', null);
    if (!orderId) q = q.eq('user_id', userId);
    const { data } = await q;
    if (!cur || cur.k !== k) return;
    cur.msgs = data || []; cur.msgs.forEach(m => seenIds.add(m.id));
    draw();
    if (cur.msgs.length) setSeen(k, cur.msgs[cur.msgs.length - 1].created_at);
    delete unread[k]; paintBadge();
  }
  function fmt(m){
    if (m.sender_role !== 'system') return String(m.body);
    const parts = String(m.body).split('|');
    if (parts[0] === 'join_request') return tr('sys_req').replace('{w}', tr(parts[1] || '')) + (parts.slice(2).join('|') ? ': ' + parts.slice(2).join('|') : '');
    if (parts[0] === 'joined') return tr('sys_joined');
    return String(m.body);
  }
  async function askJoin(){
    if (!cur || !cur.orderId) return;
    const reason = prompt(tr('ask_reason'), ''); if (reason === null) return;
    const { error } = await sb.rpc('request_support', { p_order_id:cur.orderId, p_thread:cur.thread, p_reason:reason });
    if (error){ if (cfg.toast) cfg.toast(error.message, true); return; }
    if (cfg.toast) cfg.toast(tr('ask_sent'));
    const k = cur.k; let q = sb.from('messages').select('*').eq('thread', cur.thread).eq('order_id', cur.orderId).order('created_at').limit(300);
    const { data } = await q; if (cur && cur.k === k){ cur.msgs = data || []; cur.msgs.forEach(x => seenIds.add(x.id)); draw(); }
  }
  function draw(){
    const box = document.getElementById('msgs'); if (!box || !cur) return;
    box.innerHTML = cur.msgs.map(m => {
      if (m.sender_role === 'system') return `<div class="sysmsg">🛟 ${e(fmt(m))}<small>${hm(m.created_at)}</small></div>`;
      const mine = m.sender_id === me();
      return `<div class="bub ${mine ? 'mine' : ''}">${mine ? '' : `<span class="who">${e(tr(m.sender_role))}</span>`}${e(m.body)}<small>${hm(m.created_at)}</small></div>`;
    }).join('') || `<div class="muted" style="text-align:center;padding:30px">${e(tr('no_chats'))}</div>`;
    box.scrollTop = box.scrollHeight;
  }
  async function send(text){
    if (!cur) return;
    const ta = document.getElementById('chatText');
    const body = (text || (ta && ta.value) || '').trim(); if (!body) return;
    if (ta && !text) ta.value = '';
    const { data:id, error } = await sb.rpc('send_message', { p_order_id:cur.orderId, p_thread:cur.thread, p_body:body, p_user_id:cur.userId });
    if (error){ if (cfg.toast) cfg.toast(error.message, true); if (ta && !text) ta.value = body; return; }
    const m = { id, order_id:cur.orderId, thread:cur.thread, user_id:cur.userId, sender_id:me(), sender_role:cfg.role, body, created_at:new Date().toISOString() };
    seenIds.add(id); cur.msgs.push(m); draw(); setSeen(cur.k, m.created_at);
  }
  return { init, stop, refresh, button, inbox, open, close, send, label, askJoin };
})();

// ================= PUSH + INSTALL (same code in all four apps) =================
const Push = (() => {
  const VAPID = 'BB7DLfT-2lWO5GdEBRw40xpz0jVcRYmXrjlzn84Z__HZODNrLJueYsar3rEAMUqSOCSVEOHApgJzEDrxLM2z6-E';
  const L = {
    en:{ title:'Turn on notifications', text:'Get new orders, messages and updates even when the app is closed.', on:'Turn on', later:'Later',
         install:'Install app', install_t:'Add to home screen', ios:'On iPhone: tap Share ⬆️ then “Add to Home Screen”, open the app from there, then turn on notifications.',
         done:'Notifications are on', blocked:'Notifications are blocked. Allow them in your browser settings for this site.', fail:'Could not turn on notifications' },
    ur:{ title:'نوٹیفکیشن آن کریں', text:'ایپ بند ہو تب بھی نئے آرڈر، میسج اور اپڈیٹس ملیں گے۔', on:'آن کریں', later:'بعد میں',
         install:'ایپ انسٹال کریں', install_t:'ہوم اسکرین پر لگائیں', ios:'آئی فون پر: Share ⬆️ دبائیں پھر “Add to Home Screen”، وہاں سے ایپ کھولیں، پھر نوٹیفکیشن آن کریں۔',
         done:'نوٹیفکیشن آن ہو گئے', blocked:'نوٹیفکیشن بند ہیں۔ براؤزر کی سیٹنگ میں اس سائٹ کے لیے اجازت دیں۔', fail:'نوٹیفکیشن آن نہیں ہو سکے' }
  };
  let cfg = null, deferred = null;
  const tt = k => (L[(cfg && cfg.lang && cfg.lang()) === 'ur' ? 'ur' : 'en'][k]);
  const supported = () => 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
  const standalone = () => window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
  const isIOS = () => /iphone|ipad|ipod/i.test(navigator.userAgent);
  const b64 = s => { const p = '='.repeat((4 - s.length % 4) % 4); const r = atob((s + p).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from([...r].map(c => c.charCodeAt(0))); };
  const snoozed = () => { try { return Number(localStorage.getItem('kh_push_later') || 0) > Date.now(); } catch (e) { return false; } };

  window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferred = e; show(); });
  window.addEventListener('appinstalled', () => { deferred = null; show(); });

  async function reg(){ return navigator.serviceWorker.register('sw.js'); }
  async function subscribe(){
    const r = await reg(); await navigator.serviceWorker.ready;
    let s = await r.pushManager.getSubscription();
    if (!s) s = await r.pushManager.subscribe({ userVisibleOnly:true, applicationServerKey:b64(VAPID) });
    const j = s.toJSON();
    const { error } = await cfg.sb.rpc('save_push_subscription', { p_endpoint:j.endpoint, p_p256dh:j.keys.p256dh, p_auth:j.keys.auth, p_app:cfg.app });
    if (error) throw error;
  }
  async function turnOn(){
    try {
      const p = await Notification.requestPermission();
      if (p !== 'granted'){ cfg.toast(tt('blocked'), true); hide(); return; }
      await subscribe(); cfg.toast(tt('done')); hide();
    } catch (e) { cfg.toast(tt('fail') + ': ' + (e.message || e), true); }
  }
  async function install(){ if (!deferred) return; deferred.prompt(); try { await deferred.userChoice; } catch (e) {} deferred = null; show(); }
  function later(){ try { localStorage.setItem('kh_push_later', String(Date.now() + 3 * 864e5)); } catch (e) {} hide(); }
  function hide(){ const el = document.getElementById('pushCard'); if (el) el.remove(); }
  function show(){
    hide();
    if (!cfg || !cfg.me() || snoozed()) return;
    const needPush = supported() && Notification.permission === 'default';
    const iosHint = isIOS() && !standalone();
    if (!needPush && !deferred && !iosHint) return;
    const el = document.createElement('div'); el.id = 'pushCard';
    el.setAttribute('role', 'dialog');
    el.style.cssText = 'position:fixed;left:12px;right:12px;bottom:calc(84px + env(safe-area-inset-bottom));z-index:9000;max-width:460px;margin:0 auto;background:var(--surface,#fff);color:var(--ink,#1E2B25);border:1px solid var(--line,#DDE3DB);border-radius:18px;padding:14px 14px 12px;box-shadow:0 12px 32px rgba(0,0,0,.22);font-size:15px';
    const btn = 'border:0;border-radius:12px;padding:11px 14px;font:inherit;font-weight:800;cursor:pointer';
    el.innerHTML = `<div style="display:flex;gap:10px;align-items:flex-start"><div style="font-size:26px;line-height:1">🔔</div><div style="flex:1">
      <b style="font-size:16px">${needPush ? tt('title') : tt('install_t')}</b>
      <div style="color:var(--muted,#66746C);margin-top:2px">${iosHint ? tt('ios') : tt('text')}</div></div></div>
      <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
        ${needPush && !iosHint ? `<button data-a="on" style="${btn};background:var(--green,#1F6F4A);color:#fff;flex:1">${tt('on')}</button>` : ''}
        ${deferred ? `<button data-a="inst" style="${btn};background:var(--marigold,#F2A900);color:#1E2B25;flex:1">${tt('install')}</button>` : ''}
        <button data-a="later" style="${btn};background:transparent;color:var(--muted,#66746C)">${tt('later')}</button></div>`;
    el.addEventListener('click', ev => { const a = ev.target.closest('button') && ev.target.closest('button').dataset.a; if (a === 'on') turnOn(); else if (a === 'inst') install(); else if (a === 'later') later(); });
    document.body.appendChild(el);
  }
  async function init(c){
    cfg = c;
    if (!('serviceWorker' in navigator)) return;
    try { await reg(); } catch (e) { return; }
    // Already allowed before: refresh the saved subscription quietly for this account
    if (supported() && Notification.permission === 'granted'){ try { await subscribe(); } catch (e) {} }
    setTimeout(show, 2500);
  }
  async function logout(){
    try {
      const r = await navigator.serviceWorker.getRegistration(); const sub = r && await r.pushManager.getSubscription();
      if (sub && cfg) await cfg.sb.from('push_subscriptions').delete().eq('endpoint', sub.endpoint);
    } catch (e) {}
    hide();
  }
  return { init, logout, turnOn, show, enabled:() => supported() && Notification.permission === 'granted' };
})();

// ================= LEGAL + DELETE ACCOUNT (Customer, Rider, Shop) =================
const Legal = (() => {
  const L = {
    en:{ agree:'By creating an account you agree to our {t} and {p}.', terms:'Terms', privacy:'Privacy Policy', links:'Privacy Policy and Terms',
         del:'Delete my account', del_q:'Delete your account? We will remove your personal data. Your past orders stay in our records without your name. This cannot be undone.',
         del_reason:'Why are you leaving? (optional)', del_done:'Request sent. Wanhar Mart will delete your account within 7 days.' },
    ur:{ agree:'اکاؤنٹ بنا کر آپ ہماری {t} اور {p} سے اتفاق کرتے ہیں۔', terms:'شرائط', privacy:'پرائیویسی پالیسی', links:'پرائیویسی پالیسی اور شرائط',
         del:'میرا اکاؤنٹ ختم کریں', del_q:'اکاؤنٹ ختم کریں؟ آپ کی ذاتی معلومات مٹا دی جائیں گی۔ پرانے آرڈر آپ کے نام کے بغیر ریکارڈ میں رہیں گے۔ یہ واپس نہیں ہو سکتا۔',
         del_reason:'آپ کیوں جا رہے ہیں؟ (اختیاری)', del_done:'درخواست بھیج دی گئی۔ Wanhar Mart سات دن میں اکاؤنٹ ختم کر دے گا۔' }
  };
  const tt = (lang, k) => L[lang === 'ur' ? 'ur' : 'en'][k];
  const url = (lang, part) => 'legal.html?lang=' + (lang === 'ur' ? 'ur' : 'en') + '#' + part;
  function agree(lang){
    return `<div class="muted" style="font-size:13px;margin-top:10px;text-align:center">${tt(lang, 'agree').replace('{t}', `<a href="${url(lang, 'terms')}" target="_blank" rel="noopener">${tt(lang, 'terms')}</a>`).replace('{p}', `<a href="${url(lang, 'privacy')}" target="_blank" rel="noopener">${tt(lang, 'privacy')}</a>`)}</div>`;
  }
  function links(lang){
    return `<a class="btn ghost" style="margin-bottom:10px;display:block;text-align:center;text-decoration:none" href="${url(lang, 'privacy')}" target="_blank" rel="noopener">📄 ${tt(lang, 'links')}</a>
      <button class="btn ghost" style="margin-bottom:10px;color:var(--danger);border-color:var(--danger)" onclick="Legal.del()">🗑️ ${tt(lang, 'del')}</button>`;
  }
  let cfg = null;
  function init(c){ cfg = c; }
  async function del(){
    const lang = cfg.lang();
    if (!confirm(tt(lang, 'del_q'))) return;
    const why = prompt(tt(lang, 'del_reason'), ''); if (why === null) return;
    const { error } = await cfg.sb.rpc('request_account_deletion', { p_note:why || null });
    if (error) return cfg.toast(error.message, true);
    cfg.toast(tt(lang, 'del_done'));
  }
  return { init, agree, links, del };
})();

(async function boot(){
  applyLang();
  try {
    const { data:{ session } } = await sb.auth.getSession();
    if (session) await afterLogin(session.user); else showAuth();
  } catch (e) { logErr(e); showAuth(t('error')); }
})();
</script>
</body>
</html>
