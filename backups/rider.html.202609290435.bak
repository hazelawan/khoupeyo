<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1F6F4A">
<title>Wanhar Mart Rider</title>
<link rel="manifest" href="manifest-rider.json?v=3">
<link rel="apple-touch-icon" href="icon-rider-192.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Noto+Naskh+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F4F6F1; --surface:#FFFFFF; --ink:#1E2B25; --muted:#66746C; --line:#DDE3DB; --soft:#EAF1EC;
  --green:#1F6F4A; --green-dark:#175539; --marigold:#F2A900; --danger:#B3261E; --blue:#2A6F97;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark){
  :root{ --paper:#111A16; --surface:#1A2620; --ink:#E7EFE9; --muted:#93A59A; --line:#2B3A32; --soft:#1F3129; --green:#3FA774; --green-dark:#2F8F60; --danger:#F08A82; --blue:#6FB3DA; }
}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--paper);color:var(--ink);font-size:16px;line-height:1.45;-webkit-tap-highlight-color:transparent}
html[lang=ur] body{font-family:"Noto Naskh Arabic","Bricolage Grotesque",system-ui,sans-serif;line-height:1.7}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--green)}
#app{max-width:560px;margin:0 auto;min-height:100vh;padding-top:env(safe-area-inset-top,0px)}
.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px;background:var(--paper);border-bottom:1px solid var(--line)}
.brand{font-weight:800;font-size:20px;letter-spacing:-.02em;line-height:1.15}
.brand b{color:var(--marigold)}
.brand small{display:block;font-size:13px;font-weight:600;color:var(--muted);letter-spacing:0}
.pillbtn{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 13px;font-weight:600;cursor:pointer;font-size:14px}
.duty{display:flex;align-items:center;gap:8px;border:0;border-radius:999px;padding:9px 16px 9px 12px;font-weight:800;cursor:pointer;color:#fff;background:var(--muted);font-size:15px}
.duty.on{background:var(--green)}
.duty i{width:10px;height:10px;border-radius:50%;background:#fff;opacity:.6}
.duty.on i{opacity:1;box-shadow:0 0 0 4px rgba(255,255,255,.3);animation:pulse 1.6s infinite}
.duty small{font-weight:600;opacity:.85}
@keyframes pulse{50%{box-shadow:0 0 0 7px rgba(255,255,255,0)}}
main{padding:14px 16px 120px}
h1{font-size:24px;margin:6px 0 12px;letter-spacing:-.01em}
h2{font-size:18px;margin:22px 0 8px;display:flex;align-items:center;gap:8px}
.count{background:var(--marigold);color:#1E2B25;font-size:13px;font-weight:800;border-radius:999px;padding:1px 9px}
.muted{color:var(--muted)}
.red{color:var(--danger)}
.empty{padding:34px 10px;text-align:center;color:var(--muted)}
.btn{display:block;width:100%;background:var(--green);color:#fff;border:0;border-radius:12px;padding:16px;font-weight:700;cursor:pointer;text-align:center;font-size:17px;text-decoration:none}
.btn:active{background:var(--green-dark)}
.btn.ghost{background:transparent;color:var(--green);border:2px solid var(--green)}
.btn.warn{background:transparent;color:var(--danger);border:2px solid var(--danger)}
.btn.gold{background:var(--marigold);color:#1E2B25}
.btn.small{padding:11px;font-size:15px}
.btn[disabled]{opacity:.5}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
input[type=text],input[type=password],input[type=email],input[type=tel],select,textarea{width:100%;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:13px;font-size:16px}
label.f{display:block;margin:14px 0 5px;font-weight:600;font-size:14px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;margin:0 0 12px}
.card.live{border:2px solid var(--marigold);box-shadow:0 0 0 4px rgba(242,169,0,.18)}
.ch{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px}
.oid{font-weight:800;font-size:18px}
.pill{font-size:12px;font-weight:700;padding:2px 10px;border-radius:999px;color:#fff;background:var(--green);white-space:nowrap}
.pill.y{background:#B7791F} .pill.r{background:var(--danger)} .pill.g{background:var(--muted)}
.step{display:flex;gap:12px;align-items:flex-start;margin:10px 0}
.step .n{width:28px;height:28px;border-radius:50%;background:var(--marigold);color:#1E2B25;font-weight:800;display:grid;place-items:center;flex:none}
.step.done .n{background:var(--green);color:#fff}
.step.todo{opacity:.5}
.line{display:flex;justify-content:space-between;gap:12px;padding:4px 0}
.line.total{border-top:1px solid var(--line);margin-top:6px;padding-top:10px;font-weight:800;font-size:18px}
.cash{background:rgba(242,169,0,.16);border-radius:12px;padding:12px;margin:10px 0;display:flex;justify-content:space-between;align-items:center;font-weight:800}
.cash b{font-size:22px}
.actions{display:grid;gap:10px;margin-top:12px}
.note{background:rgba(242,169,0,.14);border-radius:10px;padding:8px 10px;margin:8px 0;font-size:14px}
.warnbox{background:var(--surface);border:2px solid var(--danger);color:var(--danger);border-radius:12px;padding:12px;margin:0 0 12px;font-weight:700}
.soundbar{background:var(--marigold);color:#1E2B25;border:0;width:100%;border-radius:12px;padding:12px;font-weight:800;margin-bottom:12px;cursor:pointer}
.meta{display:flex;gap:14px;flex-wrap:wrap;color:var(--muted);font-size:14px;margin-top:6px}
.meta b{color:var(--ink)}
.nav{position:fixed;left:0;right:0;bottom:0;z-index:7;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.nav-in{display:flex;max-width:560px;margin:0 auto}
.nav button{position:relative;flex:1;background:none;border:0;padding:14px 4px 12px;font-weight:700;font-size:14px;color:var(--muted);border-top:3px solid transparent;cursor:pointer}
.nav button.on{color:var(--green);border-top-color:var(--marigold)}
.nav .dot{position:absolute;top:6px;margin-inline-start:4px;min-width:18px;height:18px;border-radius:9px;background:var(--danger);color:#fff;font-size:11px;display:inline-grid;place-items:center;padding:0 4px}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px;text-align:center}
.tile b{display:block;font-size:22px}
.tile span{color:var(--muted);font-size:13px}
.tile.hi{background:var(--green);border-color:var(--green);color:#fff}
.tile.hi span{color:rgba(255,255,255,.85)}
.bar{height:10px;background:var(--line);border-radius:6px;overflow:hidden;margin:8px 0 4px}
.bar i{display:block;height:100%;background:var(--green);border-radius:6px}
.bar i.over{background:var(--danger)}
.row{display:flex;justify-content:space-between;gap:12px;padding:11px 2px;border-bottom:1px solid var(--line)}
.row .r{text-align:end;white-space:nowrap}
.toast{position:fixed;left:50%;bottom:100px;transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:12px 16px;border-radius:12px;z-index:60;max-width:90%;font-weight:600;text-align:center}
.toast.err{background:var(--danger);color:#fff}
.auth{max-width:400px;margin:0 auto;padding:9vh 20px 30px}
.auth .brand{font-size:40px}
.err-text{color:var(--danger);margin-top:12px;min-height:22px;font-weight:600}
.link{background:none;border:0;color:var(--green);text-decoration:underline;cursor:pointer;padding:12px 0;font-weight:600}
.ver{font-size:12px;color:var(--muted);font-weight:600}
/* Slide to confirm */
.slide{position:relative;height:60px;border-radius:14px;background:var(--green);color:#fff;overflow:hidden;user-select:none;-webkit-user-select:none;touch-action:none;margin-top:12px}
.slide.gold{background:var(--marigold);color:#1E2B25}
.slide .txt{position:absolute;inset:0;display:grid;place-items:center;font-weight:800;font-size:17px;padding:0 64px;text-align:center;pointer-events:none}
.slide .knob{position:absolute;top:5px;left:5px;width:50px;height:50px;border-radius:11px;background:#fff;color:var(--green);display:grid;place-items:center;font-size:24px;font-weight:800;border:0;cursor:grab;box-shadow:0 2px 6px rgba(0,0,0,.2)}
.slide.gold .knob{color:#B7791F}
html[dir=rtl] .slide .knob{left:auto;right:5px}
/* Full screen overlays */
.over{position:fixed;inset:0;z-index:40;background:rgba(0,0,0,.55);display:flex;align-items:flex-end;justify-content:center}
.over .panel{background:var(--surface);width:100%;max-width:560px;max-height:94%;overflow:auto;border-radius:20px 20px 0 0;padding:18px 16px calc(24px + env(safe-area-inset-bottom,0px))}
.newjob .panel{border-top:6px solid var(--marigold)}
.newjob .big{font-size:34px;font-weight:800;letter-spacing:-.02em}
.timer{height:6px;background:var(--line);border-radius:4px;overflow:hidden;margin:10px 0}
.timer i{display:block;height:100%;background:var(--marigold);width:100%;transition:width 1s linear}
.cam{position:relative;width:100%;max-width:340px;aspect-ratio:3/4;margin:10px auto;border-radius:20px;overflow:hidden;background:#000}
.cam video,.cam img{width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
.cam .ring{position:absolute;inset:12% 16% 18%;border:4px dashed rgba(255,255,255,.8);border-radius:50%}
.cam .ring.ok{border-style:solid;border-color:#3FA774}
.cam .ring.bad{border-style:solid;border-color:#F08A82}
.facestate{text-align:center;font-weight:700;min-height:26px}
.face{width:72px;height:72px;border-radius:50%;background:var(--line);overflow:hidden;display:grid;place-items:center;font-weight:800;font-size:26px;color:var(--muted);flex:none}
.face img{width:100%;height:100%;object-fit:cover}
.waitbox{border-radius:12px;padding:12px;margin:10px 0;background:rgba(179,38,30,.1);border:2px solid var(--danger)}
.waitbox .clock{font-size:30px;font-weight:800;color:var(--danger);font-variant-numeric:tabular-nums}
.waitbox.done{background:rgba(31,111,74,.1);border-color:var(--green)}
.waitbox.done .clock{color:var(--green)}
.issuebox{background:rgba(242,169,0,.14);border-radius:10px;padding:8px 10px;margin:8px 0;font-size:14px}
.card.back{border:2px solid var(--danger)}
.probs{display:grid;gap:8px}
.probs button{text-align:start;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:13px;font-weight:700;cursor:pointer}
.probs button.on{border:2px solid var(--green);background:var(--soft)}
.switch{position:relative;display:block;width:50px;height:28px;flex:none}
.switch input{opacity:0;width:100%;height:100%;position:absolute;inset:0;margin:0;cursor:pointer;z-index:1}
.switch span{position:absolute;inset:0;background:var(--line);border-radius:999px;transition:background .15s}
.switch span::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .15s}
.switch input:checked + span{background:var(--green)}
.switch input:checked + span::after{transform:translateX(22px)}
:focus-visible{outline:3px solid var(--marigold);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
/* ===== Wanhar Mart design system v2 (shared by all apps) ===== */
:root{
  --paper:#F2F5F1; --surface:#FFFFFF; --ink:#13201A; --muted:#64736A; --line:#E2E8E1; --soft:#E8F3EC; --field:#F3F6F2;
  --green:#0E7A4D; --green-dark:#0A5E3B; --green-2:#17A56B; --marigold:#FFB302; --danger:#D63B2F; --deal:#E2472F;
  --r-sm:12px; --r:16px; --r-lg:22px;
  --sh-1:0 1px 2px rgba(19,40,28,.06),0 1px 1px rgba(19,40,28,.03);
  --sh-2:0 8px 22px rgba(19,40,28,.08),0 2px 6px rgba(19,40,28,.05);
  --sh-3:0 18px 44px rgba(19,40,28,.20),0 4px 12px rgba(19,40,28,.08);
  --grad:linear-gradient(135deg,#0B6B44 0%,#11905B 55%,#19A86E 100%);
  --grad-gold:linear-gradient(135deg,#FFC23A,#FFA400);
  --ease:cubic-bezier(.2,.8,.2,1);
}
@media (prefers-color-scheme: dark){
  :root{ --paper:#0C1511; --surface:#16211B; --ink:#E8F0EA; --muted:#93A59A; --line:#243229; --soft:#18291F; --field:#1C2922;
    --green:#34B27A; --green-dark:#23915F; --green-2:#46C489; --danger:#FF8A7E; --deal:#FF8A70;
    --sh-1:0 1px 2px rgba(0,0,0,.4); --sh-2:0 8px 22px rgba(0,0,0,.35); --sh-3:0 18px 44px rgba(0,0,0,.55);
    --grad:linear-gradient(135deg,#0B4F33 0%,#0F6E46 60%,#138556 100%); }
}
body{background:var(--paper);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
::selection{background:rgba(23,165,107,.25)}
h1{font-weight:800;letter-spacing:-.025em}
h2{font-weight:800;letter-spacing:-.015em}
h3{font-weight:800}
/* Buttons */
.btn{background:var(--grad);border-radius:14px;box-shadow:0 6px 16px rgba(14,122,77,.25);transition:transform .12s var(--ease),box-shadow .2s,filter .2s;letter-spacing:.005em}
.btn:active{transform:scale(.98);filter:brightness(.95);background:var(--grad)}
.btn.ghost{background:var(--soft);color:var(--green);border:1.5px solid transparent;box-shadow:none}
.btn.ghost:active{background:var(--soft)}
.btn.warn{background:rgba(214,59,47,.08);color:var(--danger);border:1.5px solid transparent;box-shadow:none}
.btn.gold{background:var(--grad-gold);color:#241a00;box-shadow:0 6px 16px rgba(255,170,0,.28)}
.btn[disabled]{opacity:.45;box-shadow:none;filter:grayscale(.3)}
/* Fields */
input[type=text],input[type=password],input[type=email],input[type=tel],input[type=number],input[type=time],input[type=date],input[type=datetime-local],input[type=search],select,textarea{
  background:var(--surface);border:1.5px solid var(--line);border-radius:14px;transition:border-color .15s,box-shadow .15s,background .15s;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--green);background:var(--surface);box-shadow:0 0 0 4px rgba(23,165,107,.15)}
label.f{color:var(--muted);font-weight:700;font-size:13px;letter-spacing:.01em}
/* Surfaces */
.card,.box{border:1px solid var(--line);border-radius:20px;box-shadow:var(--sh-1);background:var(--surface)}
.pill{border-radius:999px;font-weight:700;letter-spacing:.01em}
.muted{color:var(--muted)}
.empty{color:var(--muted)}
/* Sheets and popups */
.sheet-back{background:rgba(8,20,14,.45);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);animation:wmFade .2s ease both}
.sheet{border-radius:28px 28px 0 0;box-shadow:var(--sh-3);animation:wmUp .32s var(--ease) both;position:relative;padding-top:22px!important}
.sheet::before{content:"";position:absolute;top:8px;left:50%;transform:translateX(-50%);width:44px;height:5px;border-radius:9px;background:var(--line)}
.sheet-head h3{font-size:20px;letter-spacing:-.01em}
.x{border-radius:50%!important;background:var(--field)!important;width:36px;height:36px;display:grid;place-items:center;border:0!important}
.toast{border-radius:16px!important;box-shadow:var(--sh-3)!important;font-weight:700;animation:wmToast .35s var(--ease) both;backdrop-filter:blur(6px)}
@keyframes wmFade{from{opacity:0}to{opacity:1}}
@keyframes wmUp{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@keyframes wmToast{from{transform:translate(-50%,16px) scale(.96);opacity:0}}
@keyframes wmPop{0%{transform:scale(.9);opacity:0}100%{transform:scale(1);opacity:1}}
/* Loading skeleton */
.skel{background:linear-gradient(90deg,var(--line) 25%,var(--field) 37%,var(--line) 63%);background-size:400% 100%;animation:wmShim 1.3s ease infinite;border-radius:14px}
@keyframes wmShim{0%{background-position:100% 50%}100%{background-position:0 50%}}
/* Switch */
.switch span{transition:background .2s}
/* Scrollbars */
*::-webkit-scrollbar{height:0;width:6px}
*::-webkit-scrollbar-thumb{background:var(--line);border-radius:9px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
/* Floating bottom navigation */
.nav{left:50%!important;right:auto!important;transform:translateX(-50%);width:min(calc(100% - 20px),680px);bottom:calc(10px + env(safe-area-inset-bottom,0px))!important;
  border:1px solid var(--line)!important;border-radius:24px;box-shadow:var(--sh-3);padding:4px!important;
  background:rgba(255,255,255,.9);backdrop-filter:saturate(1.4) blur(16px);-webkit-backdrop-filter:saturate(1.4) blur(16px)}
@media (prefers-color-scheme: dark){ .nav{background:rgba(22,33,27,.9)} }
.nav a,.nav button{border-top:0!important;border-radius:18px;transition:background .2s,color .2s}
.nav a.on,.nav button.on{background:var(--soft);color:var(--green)!important}
main{padding-bottom:140px!important}
/* ===== Rider / Shop / Admin look ===== */
.top,.topbar{background:var(--grad)!important;color:#fff;border-bottom:0!important;border-radius:0 0 22px 22px;box-shadow:0 10px 26px rgba(11,107,68,.22);padding:14px 16px!important}
.top .brand,.topbar .brand{color:#fff;font-size:19px;line-height:1.15}
.tiles{row-gap:10px}
.top .brand small,.topbar .ver{color:rgba(255,255,255,.8)!important}
.top .pillbtn,.topbar .linkbtn{color:#fff!important;border:0;background:rgba(255,255,255,.16);border-radius:999px;padding:7px 12px;text-decoration:none}
.top .cbtn,.topbar .cbtn{background:rgba(255,255,255,.95)!important}
.duty,.openbtn{background:rgba(255,255,255,.18)!important;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.35)}
.duty.on,.openbtn.on{background:#fff!important;color:var(--green)!important;box-shadow:0 6px 16px rgba(0,0,0,.18)}
.duty.on i,.openbtn.on i{background:var(--green-2)!important;opacity:1!important;box-shadow:0 0 0 4px rgba(23,165,107,.25)!important}
main{padding-top:16px}
h1{font-size:26px}
h2{font-size:18px}
.card{border-radius:22px;padding:16px;box-shadow:var(--sh-2);border:1px solid var(--line)}
.card.new{border:2px solid var(--marigold)!important;box-shadow:0 0 0 5px rgba(255,179,2,.18),var(--sh-2)!important;animation:wmPop .35s var(--ease) both}
.card.late{border:2px solid var(--danger)!important;box-shadow:0 0 0 5px rgba(214,59,47,.12),var(--sh-2)!important}
.tiles{gap:10px}
.tile{border:0!important;border-radius:20px;box-shadow:var(--sh-1);padding:14px}
.tile b{font-size:24px;letter-spacing:-.02em}
.tile span{color:var(--muted);font-weight:600;font-size:13px}
.tile.hi{background:var(--grad)!important;box-shadow:0 10px 24px rgba(14,122,77,.28)}
.tile.hi span{color:rgba(255,255,255,.85)!important}
.pill{padding:3px 10px}
.cash{background:linear-gradient(135deg,rgba(255,179,2,.18),rgba(255,179,2,.08));border-radius:16px;padding:14px}
.cash b{font-size:20px}
.note{border-radius:14px}
.soundbar{background:var(--grad-gold);border-radius:16px;box-shadow:0 8px 18px rgba(255,170,0,.28)}
.warnbox,.closedbar{border-radius:16px;background:rgba(214,59,47,.06)!important;border:1.5px solid rgba(214,59,47,.5)!important}
.countdown{border-radius:14px;background:var(--soft)}
.row{padding:13px 4px}
.list{border-top:0;background:var(--surface);border-radius:20px;box-shadow:var(--sh-1);padding:0 12px;border:1px solid var(--line)}
.list .row:last-child{border-bottom:0}
.chip{border-radius:999px;border:0!important;background:var(--surface);box-shadow:var(--sh-1);font-weight:700}
.chip.on{background:var(--ink)!important;color:var(--paper)!important}
.alert{border-radius:16px;box-shadow:var(--sh-1)}
.chart{border:0;border-radius:20px;box-shadow:var(--sh-1)}
.chart .c i{background:var(--grad);border-radius:6px 6px 2px 2px}
.over{background:rgba(8,20,14,.5);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);animation:wmFade .2s ease both}
.over .panel{border-radius:28px 28px 0 0;box-shadow:var(--sh-3);animation:wmUp .32s var(--ease) both}
.newjob .panel{border-top:0!important;box-shadow:0 -6px 0 var(--marigold),var(--sh-3)}
.newjob .big{font-size:40px!important;letter-spacing:-.03em}
.timer{border-radius:9px;overflow:hidden}
.slide{border-radius:18px;background:var(--grad);box-shadow:0 8px 20px rgba(14,122,77,.3)}
.slide .knob{border-radius:14px}
.step .n{box-shadow:0 0 0 4px var(--soft)}
.bar{border-radius:9px;background:var(--field)}
.bar i{background:var(--grad);border-radius:9px}
.face{box-shadow:0 0 0 4px var(--soft)}
.auth,.login{padding-top:30px}
.kv{padding:9px 0}
.selfie{border-radius:18px;box-shadow:var(--sh-1)}
.review{border-radius:16px}
</style>
</head>
