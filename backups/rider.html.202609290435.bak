<div id="app"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
// ---- Version: change this every time the file is updated ----
const APP_VERSION = '3.0';

// ---- Connection (these two values are safe to be public) ----
const SUPABASE_URL = "https://ijhvlbfuyracfyfefwze.supabase.co";
const SUPABASE_KEY = "sb_publishable_DPslzvs1_VM7NwdlBGbCWg_cSgWInhp";
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_KEY, { auth: { storageKey: 'khoupeyo-rider-auth' } });
const FACE_JS = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/dist/face-api.js';
const FACE_MODELS = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model/';
const JOB_SECONDS = 45;

const ls = {
  get(k, d){ try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
};
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num = n => Number(n || 0);
const money = n => 'Rs ' + Math.round(num(n)).toLocaleString('en-PK');
const when = ts => new Date(ts).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
const pad = n => String(n).padStart(2, '0');
const hm = mins => { mins = Math.max(0, Math.round(mins)); return Math.floor(mins / 60) + 'h ' + pad(mins % 60) + 'm'; };
function timeAgo(ts){
  const m = Math.round((Date.now() - new Date(ts).getTime()) / 60000);
  if (m < 1) return '0 min'; if (m < 60) return m + ' min';
  const h = Math.round(m / 60); return h < 24 ? h + ' h' : new Date(ts).toLocaleDateString('en-GB', { day:'numeric', month:'short' });
}
function logErr(e){ try { console.error(e && e.message ? e.message : JSON.stringify(e)); } catch (x) { console.error('error'); } }
function normalizePhone(p){
  let d = String(p || '').replace(/\D/g, '');
  if (d.startsWith('92') && d.length === 12) d = '0' + d.slice(2);
  if (d.startsWith('3') && d.length === 10) d = '0' + d;
  return /^03\d{9}$/.test(d) ? d : null;
}
function mapsUrl(lat, lng, text){
  if (lat && lng) return `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(text || '')}`;
}
function km(aLat, aLng, bLat, bLng){
  if (![aLat, aLng, bLat, bLng].every(x => typeof x === 'number')) return null;
  const R = 6371, r = x => x * Math.PI / 180;
  const d = Math.sin(r(bLat - aLat) / 2) ** 2 + Math.cos(r(aLat)) * Math.cos(r(bLat)) * Math.sin(r(bLng - aLng) / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(d));
}
const fmtKm = d => d == null ? '' : (d < 1 ? Math.round(d * 1000) + ' m' : d.toFixed(1) + ' km');
function monthStart(){ const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), 1); }
const ymd = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

